---
import "@/styles/comm.css";
import Header from "@/components/global/Header.astro";
import Footer from "@/components/global/Footer.astro";
import ShareMobile from "@/components/global/ShareMobile.astro";
import MobileBottom from "@/components/global/MobileBottom.astro";
import SidebarDesktop from "@/components/global/SidebarDesktop.astro";
import Backtop from "@/components/global/Backtop.astro";
import LiveChat from "@/components/global/LiveChat.astro";
import SEOHead from "@/components/seo/SEOHead.astro";
import SchemaClinic from "@/components/seo/SchemaClinic.astro";
import { useI18n } from "@/i18n/utils";
import { ui } from "@/i18n/ui";

type TDKKeys = keyof (typeof ui)["zh-hk"]["tdk"];
interface Props {
  tdkKey?: TDKKeys; // 接收如 "home" 或 "about"
  seo?: any; // 兼容某些特殊页面手动传入完整的 SEO 对象
  showClinicSchema?: boolean;
}

const { tdkKey, seo, showClinicSchema = true } = Astro.props;
const { dict, lang } = useI18n(Astro.url);
let finalSeo = seo || dict.tdk.home;
if (tdkKey && dict.tdk[tdkKey]) {
  finalSeo = dict.tdk[tdkKey];
}
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#4570b6" />

    <!-- Google 官方搜尋標準 Favicon 與多設備圖標矩陣 -->
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Fonts API (預設註釋停用，優先使用本機原生系統字體棧，杜絕阻塞 PageSpeed 評分；未來若需開啟直接解除註釋) -->
    <!--
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+HK:wght@300;400;500;700;900&family=Noto+Sans+TC:wght@300;400;500;700;900&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
    -->

    <!-- 現代化 SEO 規範 Header -->
    <SEOHead
      title={finalSeo.title}
      description={finalSeo.description}
      keywords={finalSeo.keywords}
      lang={lang}
    />

    <!-- Google Tag Manager (GTM-5M8VLLM) [手勢互動/延遲 4s 載入，遵循 Agents.md 第 7 節零 TBT 阻塞規範] -->
    <script is:inline>
      (function () {
        let gtmLoaded = false;
        function loadGTM() {
          if (gtmLoaded) return;
          gtmLoaded = true;
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
          const f = document.getElementsByTagName("script")[0];
          const j = document.createElement("script");
          j.async = true;
          j.src = "https://www.googletagmanager.com/gtm.js?id=GTM-5M8VLLM";
          if (f && f.parentNode) {
            f.parentNode.insertBefore(j, f);
          } else {
            document.head.appendChild(j);
          }
          ["scroll", "mousemove", "touchstart", "click"].forEach(function (e) {
            window.removeEventListener(e, loadGTM, { passive: true });
          });
        }
        ["scroll", "mousemove", "touchstart", "click"].forEach(function (e) {
          window.addEventListener(e, loadGTM, { passive: true, once: true });
        });
        setTimeout(loadGTM, 4000);
      })();
    </script>

    <!-- 全站靜態圖片禁用原生拖拽 -->
    <script is:inline>
      document.addEventListener("dragstart", function (e) {
        if (e.target && (e.target.tagName === "IMG" || (e.target.closest && e.target.closest("img")))) {
          e.preventDefault();
        }
      });
    </script>

    <!-- Schema.org 診所實體標記 (Local SEO / E-E-A-T) -->
    {showClinicSchema && <SchemaClinic lang={lang} />}

    <!-- 頁面自定義 Head 內容 (如專屬 LCP Preload 標籤) -->
    <slot name="head" />
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-5M8VLLM"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >

    <Header />
    <main id="main-content">
      <slot />
    </main>
    <SidebarDesktop />
    <Backtop />
    <ShareMobile />
    <MobileBottom />
    <Footer />
    <LiveChat />

    <!-- 共享滾動顯現微動效 (Shared Scroll Reveal) -->
    <script is:inline>
      (function () {
        if (typeof window === "undefined" || !("IntersectionObserver" in window)) return;
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

        function initScrollReveal() {
          const main = document.getElementById("main-content");
          if (!main) return;
          const sections = main.querySelectorAll("section");
          if (!sections.length) return;

          const viewportHeight = window.innerHeight || document.documentElement.clientHeight;
          const observer = new IntersectionObserver(
            function (entries, obs) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                  entry.target.classList.add("is-revealed");
                  obs.unobserve(entry.target);
                }
              });
            },
            { rootMargin: "0px 0px -40px 0px", threshold: 0.05 }
          );

          sections.forEach(function (section) {
            const rect = section.getBoundingClientRect();
            // 僅對初始處於可視區下方的區塊套用淡入上浮，首屏與 Hero 元素絕不隱藏
            if (rect.top >= viewportHeight) {
              section.classList.add("scroll-reveal");
              observer.observe(section);
            }
          });
        }

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", initScrollReveal, { once: true });
        } else {
          initScrollReveal();
        }
      })();
    </script>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
    overflow-x: clip;
  }
</style>
