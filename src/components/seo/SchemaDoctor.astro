---
/**
 * SchemaDoctor.astro
 * Google Medical SEO, AI Knowledge Graph & E-E-A-T 醫生陣容結構化數據
 * 與 BaseLayout 的 SchemaClinic 透過 @id (#website / #organization / #founder / #webpage) 互連，避免重複宣告診所與創辦人實體
 */
interface Props {
  lang?: string;
  doctors?: Array<{
    name: string;
    desc: string[];
    img?: string;
  }>;
}

const { lang = "zh-hk", doctors = [] } = Astro.props;
const isCn = lang === "zh-cn";
const siteUrl = Astro.site?.origin || "https://smile.hkcmereye.com";
const pagePath = isCn ? "/cn/our-medical-team/" : "/our-medical-team/";
const pageUrl = new URL(pagePath, siteUrl).href;

const doctorSchemas = doctors.map((doc, idx) => ({
  "@type": ["Person", "Physician"],
  "@id": `${pageUrl}#doctor-${idx + 1}`,
  "name": `${doc.name}${isCn ? "医生" : "醫生"}`,
  "alternateName": doc.name,
  "jobTitle": isCn ? "眼科专科医生" : "眼科專科醫生",
  "image": doc.img,
  "medicalSpecialty": [
    "https://schema.org/Ophthalmology",
    "https://schema.org/Surgical"
  ],
  "worksFor": {
    "@id": `${siteUrl}/#organization`
  },
  "knowsAbout": doc.desc || [],
  "hasCredential": (doc.desc || []).map((cred) => ({
    "@type": "EducationalOccupationalCredential",
    "credentialCategory": "degree",
    "name": cred
  })),
  "description": `${doc.name}${isCn ? "眼科专科医生，资历包括：" : "眼科專科醫生，資歷包括："}${(doc.desc || []).join("、")}`
}));

const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ItemList",
      "@id": `${pageUrl}#medical-team`,
      "url": pageUrl,
      "name": isCn ? "医生团队｜香港希玛微笑矫视中心" : "醫生團隊｜香港希瑪微笑矯視中心",
      "description": isCn
        ? "香港希玛微笑矫视中心医疗团队由13位香港注册眼科专科医生组成，提供术前眼睛评估及激光矫视、ICL植入式隐形眼镜及老花矫视服务。"
        : "香港希瑪微笑矯視中心醫療團隊由13位香港註冊眼科專科醫生組成，提供術前眼睛評估及激光矯視、ICL植入式隱形眼鏡及老花矯視服務。",
      "inLanguage": isCn ? "zh-CN" : "zh-HK",
      "mainEntityOfPage": {
        "@id": `${pageUrl}#webpage`
      },
      "isPartOf": {
        "@id": `${siteUrl}/#website`
      },
      "numberOfItems": doctors.length + 1,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "item": {
            "@id": `${siteUrl}/#founder`
          }
        },
        ...doctors.map((_, idx) => ({
          "@type": "ListItem",
          "position": idx + 2,
          "item": {
            "@id": `${pageUrl}#doctor-${idx + 1}`
          }
        }))
      ]
    },
    ...doctorSchemas
  ]
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(schemaData)} />
