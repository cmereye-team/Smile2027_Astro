---
/**
 * SchemaEquipment.astro
 * 中心設備頁結構化數據 (ItemList + MedicalDevice)
 * - 嚴格遵循 Google Search Central 醫療規範：不使用電商 Product 標記
 * - 所有 27 台儀器名稱、用途說明、圖片與原廠品牌均直接從 equipmentData.ts 同源生成
 */
import type { EquipmentPageContent } from "@/data/equipmentData";

interface Props {
  content: EquipmentPageContent;
  lang?: string;
}

const { content, lang = "zh-hk" } = Astro.props;
const isCn = lang === "zh-cn";
const siteUrl = Astro.site?.origin || "https://smile.hkcmereye.com";
const pageUrl = new URL(isCn ? "/cn/medical-equipment/" : "/medical-equipment/", siteUrl).href;

function cleanText(raw: string): string {
  return raw
    .replace(/<[^>]+>/g, " ")
    .replace(/\s+/g, " ")
    .replace(/([\u4e00-\u9fff])\s+([\u4e00-\u9fff])/g, "$1$2")
    .trim();
}

const MANUFACTURER_URLS: Record<string, string> = {
  Alcon: "https://www.alcon.com/",
  "Carl Zeiss": "https://www.zeiss.com/",
  "Icare Finland": "https://www.icare-world.com/",
  NIDEK: "https://www.nidek-intl.com/",
  CSO: "https://www.csoitalia.it/",
  Oculus: "https://www.oculus.de/",
  "Quantel Medical": "https://www.quantel-medical.com/",
  Optos: "https://www.optos.com/",
  Konan: "https://konanmedical.com/",
  "Haag-Streit": "https://www.haag-streit.com/",
  Ellex: "https://www.ellex.com/",
  Peschke: "https://www.peschketrade.com/",
  Leica: "https://www.leica-microsystems.com/",
};

function parseManufacturer(source: string): string | null {
  const normalized = source.replace(/[\s\u2000-\u200b\u3000]+/g, " ").trim();
  const match = normalized.match(/^(?:資料及圖片來源|资料及图片来源)[：:]\s*(.+)$/);
  if (match) {
    return match[1].trim() || null;
  }
  if (/蔡司|ZEISS/i.test(normalized)) {
    return "Carl Zeiss";
  }
  return null;
}

const categoryLabelMap = new Map(content.categories.map((c) => [c.id, c.name]));

const equipmentSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "@id": `${pageUrl}#equipment-list`,
  name: isCn ? "香港希玛微笑矫视中心眼科矫视及检查设备清单" : "香港希瑪微笑矯視中心眼科矯視及檢查設備清單",
  description: isCn
    ? "香港希玛微笑矫视中心配备之眼科屈光矫视手术激光系统、术前眼睛检查仪器、术中导航及眼底扫描设备。"
    : "香港希瑪微笑矯視中心配備之眼科屈光矯視手術激光系統、術前眼睛檢查儀器、術中導航及眼底掃描設備。",
  url: pageUrl,
  numberOfItems: content.items.length,
  itemListElement: content.items.map((item, idx) => {
    const fullName = cleanText(item.nameLines.join(" "));
    const manufacturer = parseManufacturer(item.source);
    const manufacturerUrl = manufacturer ? MANUFACTURER_URLS[manufacturer] : undefined;
    const categoryName = categoryLabelMap.get(item.category);

    const device: Record<string, unknown> = {
      "@type": "MedicalDevice",
      "@id": `${pageUrl}#device-${item.id}`,
      name: fullName,
      alternateName: item.alt !== fullName ? item.alt : undefined,
      description: cleanText(item.remark),
      image: item.img,
      relevantSpecialty: {
        "@type": "MedicalSpecialty",
        name: "Ophthalmology",
      },
      ...(categoryName ? { medicalSpecialty: categoryName } : {}),
      ...(manufacturer
        ? {
            manufacturer: {
              "@type": "Organization",
              name: manufacturer,
              ...(manufacturerUrl ? { url: manufacturerUrl } : {}),
            },
          }
        : {}),
    };

    return {
      "@type": "ListItem",
      position: idx + 1,
      item: device,
    };
  }),
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(equipmentSchema)} />
