---
/**
 * SchemaFeeCatalog.astro
 * 收費詳情頁專用結構化數據 (OfferCatalog + MedicalProcedure + Offer / PriceSpecification)
 * - 嚴格遵循 Google Search Central 醫療服務規範：不使用電商 Product 標記
 * - 所有價格數字直接從 feeData.ts 動態解析，確保 Schema 與頁面可見價目 100% 同源同步
 */
import type { FeeData } from "@/data/feeData";

interface Props {
  fee: FeeData;
  lang?: string;
}

const { fee, lang = "zh-hk" } = Astro.props;
const isCn = lang === "zh-cn";
const siteUrl = Astro.site?.origin || "https://smile.hkcmereye.com";
const pageUrl = new URL(isCn ? "/cn/fee" : "/fee", siteUrl).href;

function stripHtml(raw: string): string {
  return raw
    .replace(/<[^>]+>/g, " ")
    .replace(/\s+/g, " ")
    .replace(/([\u4e00-\u9fff])\s+([\u4e00-\u9fff])/g, "$1$2")
    .replace(/([\u4e00-\u9fff])\s+([\u4e00-\u9fff])/g, "$1$2")
    .trim();
}

function parseFirstPrice(raw: string): number {
  const match = raw.match(/\$([\d,]+)/);
  if (!match) {
    throw new Error(`[SchemaFeeCatalog] Unable to parse HKD price from: ${raw}`);
  }
  return Number(match[1].replace(/,/g, ""));
}

function parseAllPrices(raw: string): number[] {
  const matches = [...raw.matchAll(/\$([\d,]+)/g)];
  if (!matches.length) {
    throw new Error(`[SchemaFeeCatalog] Unable to parse HKD prices from: ${raw}`);
  }
  return matches.map((m) => Number(m[1].replace(/,/g, "")));
}

function parseRange(raw: string): { minPrice: number; maxPrice: number } {
  const prices = parseAllPrices(raw);
  if (prices.length < 2) {
    throw new Error(`[SchemaFeeCatalog] Expected price range from: ${raw}`);
  }
  return { minPrice: prices[0], maxPrice: prices[1] };
}

const providerRef = { "@id": `${siteUrl}/#organization` };
const currency = "HKD";

const pro1CarePrices = parseAllPrices(fee.table1.rows.pro1CarePrice);
const pro2CarePrices = parseAllPrices(fee.table1.rows.pro2CarePrice);
const iclV4cPrices = parseAllPrices(fee.table1.rows.iclV4cPrice);
const iclV5Prices = parseAllPrices(fee.table1.rows.iclV5Price);
const xtraSingle = parseFirstPrice(fee.table1.rows.xtraSinglePrice);
const xtraBoth = parseFirstPrice(fee.table1.rows.xtraBothPrice);
const clearSingleNoAst = parseRange(fee.table2.cmerClear.singleFocalPriceNoAst);
const clearSingleAst = parseRange(fee.table2.cmerClear.singleFocalPriceAst);
const clearMultiNoAst = parseRange(fee.table2.cmerClear.multiFocalPriceNoAst);
const clearMultiAst = parseRange(fee.table2.cmerClear.multiFocalPriceAst);
const lbvStandard = parseFirstPrice(fee.table2.lbv.priceStandard);
const lbvEps = parseFirstPrice(fee.table2.lbv.priceEps);
const iclVivaPrice = parseFirstPrice(fee.table2.iclViva.price);

function buildFixedOffer(opts: {
  name: string;
  price: number;
  epsPrice?: number;
  description: string;
  url: string;
}) {
  const base: Record<string, unknown> = {
    "@type": "Offer",
    name: opts.name,
    url: opts.url,
    price: opts.price,
    priceCurrency: currency,
    description: opts.description,
    offeredBy: providerRef,
    itemOffered: {
      "@type": "MedicalProcedure",
      name: opts.name,
      procedureType: "SurgicalProcedure",
      relevantSpecialty: {
        "@type": "MedicalSpecialty",
        name: "Ophthalmology",
      },
    },
  };

  if (opts.epsPrice !== undefined) {
    base.priceSpecification = [
      {
        "@type": "PriceSpecification",
        name: isCn ? "标准价钱（双眼）" : "標準價錢（雙眼）",
        price: opts.price,
        priceCurrency: currency,
      },
      {
        "@type": "PriceSpecification",
        name: isCn ? "EPS用户全数支付优惠价（双眼）" : "EPS用戶全數支付優惠價（雙眼）",
        price: opts.epsPrice,
        priceCurrency: currency,
      },
    ];
  }

  return base;
}

function buildRangeOffer(opts: {
  name: string;
  minPrice: number;
  maxPrice: number;
  description: string;
  url: string;
}) {
  return {
    "@type": "Offer",
    name: opts.name,
    url: opts.url,
    description: opts.description,
    offeredBy: providerRef,
    priceSpecification: {
      "@type": "PriceSpecification",
      minPrice: opts.minPrice,
      maxPrice: opts.maxPrice,
      priceCurrency: currency,
    },
    itemOffered: {
      "@type": "MedicalProcedure",
      name: opts.name,
      procedureType: "SurgicalProcedure",
      relevantSpecialty: {
        "@type": "MedicalSpecialty",
        name: "Ophthalmology",
      },
    },
  };
}

