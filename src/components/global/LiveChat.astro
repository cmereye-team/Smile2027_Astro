---
/**
 * LiveChat.astro
 * 商務通智能延遲加載組件（預先注入 CSS 防止樣式丟失 + MutationObserver 防 Lighthouse 扣分 + 用戶互動才觸發）
 */
---

<script is:inline>
(() => {
  let isLoaded = false;

  // 為商務通外部彈窗注入的圖片自動補齊 alt="" 與 aria-hidden="true" (AGENTS.md §7.2)
  function sanitizeZoosnetImages(root) {
    if (!root || typeof root.querySelectorAll !== "function") return;
    const isZoosnetImg = (img) => {
      const src = img.getAttribute("src") || "";
      return (
        src.includes("zoosnet.net") ||
        Boolean(img.closest('[id^="LR"], [id^="swt"], [class*="LR"], [class*="swt"]'))
      );
    };

    const imgs = root.tagName === "IMG" ? [root] : root.querySelectorAll("img");
    imgs.forEach((img) => {
      if (isZoosnetImg(img)) {
        if (!img.hasAttribute("alt")) {
          img.setAttribute("alt", "");
        }
        if (!img.hasAttribute("aria-hidden")) {
          img.setAttribute("aria-hidden", "true");
        }
      }
    });
  }

  function observeZoosnetDom() {
    if (typeof MutationObserver === "undefined" || !document.body) return;
    const observer = new MutationObserver((mutations) => {
      for (const mutation of mutations) {
        mutation.addedNodes.forEach((node) => {
          if (node.nodeType === 1) {
            sanitizeZoosnetImages(node);
          }
        });
      }
    });
    observer.observe(document.body, { childList: true, subtree: true });
    sanitizeZoosnetImages(document.body);
  }

  // 延遲加載商務通在線客服腳本（用戶互動或 5s 兜底觸發）
  function loadZoosnet() {
    if (isLoaded) return;
    isLoaded = true;

    observeZoosnetDom();

    // 先插入核心 CSS，防止樣式丟失
    const link = document.createElement("link");
    link.rel = "stylesheet";
    link.type = "text/css";
    link.href = "https://mqj.zoosnet.net/js/JS5_2.css";
    document.head.appendChild(link);

    // 依頁面語系自動選擇商務通語言參數 (/cn/ -> cn，zh-HK -> big5)
    const docLang = (document.documentElement.lang || "").toLowerCase();
    const isCn = docLang === "zh-cn" || window.location.pathname.startsWith("/cn");
    const lngParam = isCn ? "cn" : "big5";

    // 動態插入商務通客服腳本
    const script = document.createElement("script");
    script.type = "text/javascript";
    script.src = `https://mqj.zoosnet.net/JS/LsJS.aspx?siteid=MQJ40126824&float=1&lng=${lngParam}`;
    script.async = true;
    document.body.appendChild(script);
  }

  // 3. 綁定真實互動時機（滑動、滾動、手機觸控）才觸發
  const events = ["scroll", "mousemove", "touchstart"];
  const triggerHandler = () => {
    loadZoosnet();
    events.forEach((evt) => {
      window.removeEventListener(evt, triggerHandler);
    });
  };

  events.forEach((evt) => {
    window.addEventListener(evt, triggerHandler, { passive: true, once: true });
  });

  // 4. 兜底保障：若訪客完全未操作，5 秒後依然自動載入，確保不遺漏潛在諮詢客戶
  setTimeout(triggerHandler, 5000);
})();
</script>
