---
import { useI18n } from "@/i18n/utils";
const { dict } = useI18n(Astro.url);
---

<section class="lg:hidden site-container py-8 relative z-20">
  <div class="mb-5 flex items-center justify-center gap-2">
    <img decoding="async" loading="lazy" draggable="false" src="https://static.cmermedical.com.hk/smile/assets/icons/icon-slash-l.svg" alt={dict.common.share.title} title={dict.common.share.title} width="20" height="19" aria-hidden="true" />
    <p class="text-[24px] font-bold text-center text-primary leading-tight">{dict.common.share.title}</p>
    <img decoding="async" loading="lazy" draggable="false" src="https://static.cmermedical.com.hk/smile/assets/icons/icon-slash-r.svg" alt={dict.common.share.title} title={dict.common.share.title} width="20" height="19" aria-hidden="true" />
  </div>
  <div class="center gap-3">
    <button
      id="btn-share"
      type="button"
      class="size-14 rounded-full border border-primary center"
      aria-label={dict.common.share.btnShare}
    >
      <img decoding="async" loading="lazy" draggable="false" src="https://static.cmermedical.com.hk/smile/assets/icons/icon-share-node.svg" alt={dict.common.share.btnShare} title={dict.common.share.btnShare} width="20" height="22" aria-hidden="true" />
    </button>
    <button
      id="btn-copy"
      type="button"
      class="size-14 rounded-full border border-primary center relative"
      aria-label={dict.common.share.btnCopy}
    >
      <img decoding="async" loading="lazy" draggable="false" src="https://static.cmermedical.com.hk/smile/assets/icons/icon-link-copy.svg" alt={dict.common.share.btnCopy} title={dict.common.share.btnCopy} width="22" height="22" aria-hidden="true" />
    </button>
  </div>
  <div
    id="toast"
    class="fixed top-4 left-1/2 -translate-x-1/2 z-50 flex items-center gap-2 px-4 py-2.5 rounded border border-[#b7dfaa] bg-[#f0f9eb] text-[#246610] shadow-sm transition-all duration-300 transform -translate-y-10 opacity-0 pointer-events-none"
    role="alert"
  >
    <img decoding="async" loading="lazy" draggable="false" src="https://static.cmermedical.com.hk/smile/assets/icons/icon-toast-success.svg" alt={dict.common.share.success} title={dict.common.share.success} width="16" height="16" class="size-4" aria-hidden="true" />
    <span class="text-sm font-medium leading-none">{dict.common.share.success}</span>
  </div>
</section>
<script>
  // 封装初始化函数，完美兼容 View Transitions 路由跳转
  function initShareFeatures() {
    const shareBtn = document.getElementById("btn-share");
    const copyBtn = document.getElementById("btn-copy");
    const toast = document.getElementById("toast");

    const pageTitle = document.title;
    const pageUrl = window.location.href;

    // --- 1. 原生分享逻辑 ---
    if (shareBtn) {
      shareBtn.addEventListener("click", async () => {
        // 判断浏览器是否支持 Web Share API
        if (navigator.share) {
          try {
            await navigator.share({
              title: pageTitle,
              text: `推荐给你这个页面：${pageTitle}`,
              url: pageUrl,
            });
          } catch (err) {
            // 用户取消分享或者分享失败，不做特殊处理
            console.log("分享取消或失败:", err);
          }
        } else {
          // 如果系统/浏览器不支持原生分享（如部分 PC 浏览器），降级为“自动复制链接”
          triggerCopy();
        }
      });
    }

    // --- 2. 复制链接逻辑 ---
    if (copyBtn) {
      copyBtn.addEventListener("click", () => {
        triggerCopy();
      });
    }

    // 核心复制与提示函数
    async function triggerCopy() {
      if (navigator.clipboard?.writeText) {
        try {
          await navigator.clipboard.writeText(pageUrl);
          showToast();
          return;
        } catch (err) {
          console.error("Clipboard API 复制失败:", err);
        }
      }
      window.prompt(
        document.documentElement.lang === "zh-cn"
          ? "请复制以下页面链接："
          : "請複製以下頁面連結：",
        pageUrl
      );
    }

    // 显示“复制成功”小气泡
    function showToast() {
      if (!toast) return;
      toast.classList.remove("opacity-0", "-translate-y-10", "pointer-events-none");
      toast.classList.add("opacity-100", "translate-y-0"); // 向上浮动并淡入

      // 1.5 秒后自动消失
      setTimeout(() => {
        toast.classList.remove("opacity-100", "translate-y-0");
        toast.classList.add("opacity-0", "-translate-y-10", "pointer-events-none");
      }, 1500);
    }
  }

  // 首次加载时执行
  initShareFeatures();
</script>
