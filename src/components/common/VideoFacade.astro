---
interface Props {
  videoId: string;
  title?: string;
  embedParams?: string;
  class?: string;
  loading?: "lazy" | "eager";
}

const {
  videoId,
  title = "YouTube video player",
  embedParams = "",
  class: className = "",
  loading = "lazy",
} = Astro.props;

let cleanId = videoId;
let existingParams = embedParams;

if (cleanId.includes("youtube.com/embed/")) {
  const urlParts = cleanId.split("youtube.com/embed/")[1].split("?");
  cleanId = urlParts[0];
  if (urlParts[1] && !existingParams) {
    existingParams = urlParts[1];
  }
} else if (cleanId.includes("youtu.be/")) {
  const urlParts = cleanId.split("youtu.be/")[1].split("?");
  cleanId = urlParts[0];
  if (urlParts[1] && !existingParams) {
    existingParams = urlParts[1];
  }
} else if (cleanId.includes("?")) {
  const urlParts = cleanId.split("?");
  cleanId = urlParts[0];
  if (urlParts[1] && !existingParams) {
    existingParams = urlParts[1];
  }
}

const paramsSuffix = existingParams ? `&${existingParams}` : "";
const finalIframeSrc = `https://www.youtube-nocookie.com/embed/${cleanId}?autoplay=1&rel=0${paramsSuffix}`;

const posterUrl = `https://i.ytimg.com/vi/${cleanId}/maxresdefault.jpg`;
const fallbackPosterUrl = `https://i.ytimg.com/vi/${cleanId}/hqdefault.jpg`;
---

<div class:list={["video-facade-container relative w-full h-full aspect-video bg-black overflow-hidden group/facade", className]}>
  <button
    type="button"
    class="video-facade-btn group relative block w-full h-full p-0 m-0 border-0 bg-transparent cursor-pointer text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-[#FF0000]"
    aria-label={`播放影片：${title}`}
    data-iframe-src={finalIframeSrc}
    data-video-title={title}
  >
    {/* 影片縮圖 */}
    <img
      src={posterUrl}
      onerror={`this.onerror=null;this.src='${fallbackPosterUrl}';`}
      alt={title}
      title={title}
      loading={loading}
      decoding="async"
      width="1280"
      height="720"
      class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
    />

    {/* 頂部 YouTube 標題欄 (高仿真官方 YouTube Embed 頂部漸變與標題排版) */}
    {title && (
      <div class="video-facade-header absolute top-0 inset-x-0 pt-3 pb-8 px-4 sm:px-5 bg-gradient-to-b from-black/80 via-black/40 to-transparent pointer-events-none flex items-center justify-between gap-3">
        <div class="flex items-center gap-3 min-w-0">
          <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-white/10 border border-white/20 flex items-center justify-center flex-shrink-0 backdrop-blur-sm overflow-hidden">
            <span class="text-[10px] font-bold tracking-tighter text-white uppercase">CMER</span>
          </div>
          <span class="text-white text-xs sm:text-sm md:text-[15px] font-normal leading-snug line-clamp-1 drop-shadow-[0_1px_2px_rgba(0,0,0,0.9)] font-sans group-hover:underline">
            {title}
          </span>
        </div>
        <div class="flex items-center gap-2 text-white/90 flex-shrink-0">
          <span class="p-1.5 rounded-full hover:bg-white/20 transition-colors hidden sm:inline-flex" title="分享">
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M15 5.63 20.66 12 15 18.37V14h-1c-3.96 0-7.14 1-9.75 3.09 1.84-4.07 5.11-6.4 9.89-7.1l.86-.13V5.63M14 3v6C6.22 10.13 3.11 15.33 2 21c2.78-3.97 6.44-6 12-6v6l8-9-8-9z" />
            </svg>
          </span>
        </div>
      </div>
    )}

    {/* 中央 YouTube 官方播放按鈕 (68x48 經典圓角矩形 + 懸停純紅 #FF0000) */}
    <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
      <div class="w-[68px] h-[48px] transition-transform duration-150 ease-out group-hover:scale-110 drop-shadow-[0_4px_16px_rgba(0,0,0,0.5)]">
        <svg height="100%" version="1.1" viewBox="0 0 68 48" width="100%" aria-hidden="true">
          <path
            class="transition-colors duration-150 fill-[#212121]/80 group-hover:fill-[#FF0000] group-focus-visible:fill-[#FF0000]"
            d="M66.52,7.74c-0.78-2.93-2.49-5.41-5.42-6.19C55.79,.13,34,0,34,0S12.21,.13,6.9,1.55 C3.97,2.33,2.27,4.81,1.48,7.74C0.06,13.05,0,24,0,24s0.06,10.95,1.48,16.26c0.78,2.93,2.49,5.41,5.42,6.19 C12.21,47.87,34,48,34,48s21.79-0.13,27.1-1.55c2.93-0.78,4.64-3.26,5.42-6.19C67.94,34.95,68,24,68,24S67.94,13.05,66.52,7.74z"
          />
          <path d="M 45,24 27,14 27,34" fill="#ffffff" />
        </svg>
      </div>
    </div>

    <span class="sr-only">{title}</span>
  </button>
</div>

<script>
  function setupVideoFacades() {
    document.querySelectorAll<HTMLButtonElement>(".video-facade-btn").forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = "true";
      btn.addEventListener("click", () => {
        const iframeSrc = btn.dataset.iframeSrc;
        const videoTitle = btn.dataset.videoTitle || "YouTube video player";
        if (!iframeSrc) return;

        const iframe = document.createElement("iframe");
        iframe.src = iframeSrc;
        iframe.title = videoTitle;
        iframe.width = "100%";
        iframe.height = "100%";
        iframe.setAttribute(
          "allow",
          "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        );
        iframe.setAttribute("allowfullscreen", "");
        iframe.className = "w-full h-full border-0 absolute inset-0";

        const container = btn.closest(".video-facade-container");
        if (container) {
          btn.remove();
          container.appendChild(iframe);
        } else {
          btn.replaceWith(iframe);
        }
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupVideoFacades);
  } else {
    setupVideoFacades();
  }
  document.addEventListener("astro:page-load", setupVideoFacades);
</script>
