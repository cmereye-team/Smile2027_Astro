      inset: 0;
      pointer-events: none;
      opacity: 0;
      transition: opacity 2.8s cubic-bezier(0.25, 1, 0.5, 1);
      z-index: 0;
      background: radial-gradient(
        ellipse 85% 65% at 20% 30%,
        rgba(195, 218, 255, 0.5) 0%,
        rgba(242, 247, 255, 0) 75%
