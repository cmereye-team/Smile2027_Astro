---
import { SHARE_DATA, type ShareItem } from "@/data/shareData";

interface Props {
  title?: string;
  items?: ShareItem[];
  id?: string;
  sectionId?: string;
}

const {
  title = "用家分享",
  items = SHARE_DATA,
  id = "UserShareBoxlist",
  sectionId = "section-share-heading",
} = Astro.props;

const colorMap: Record<string, string> = {
  "SMILE Pro": "#4570B6",
  "ICL": "#EB981A",
  "CLEAR-Vision": "#5FB947",
  "SMILE": "#30ABE2",
};

function getColor(type: string) {
  return colorMap[type] || "#4570B6";
}
---

<section class="UserShare overflow-hidden" aria-labelledby={sectionId}>
  <div class="bg">
    <div class="site-container UserShareContainer">
      <div class="UserShareBox">
        <div class="UserShareBox-title">
          <h2 id={sectionId} class="title-share">{title}</h2>
          <div class="UserShareBox-title-text">
            <img draggable="false"
              class="d-block"
              decoding="async"
              src="https://statichk.cmermedical.com/smile/VisionCorrectionCenter/userShare/boxShare-newtitle-pc.png"
              alt="更舒適生活從希瑪矯視開始 - 聽聽各位真實用家親身感受"
              title="希瑪微笑矯視用家真實口碑分享"
              loading="lazy"
              width="772"
              height="60"
              srcset="
                https://statichk.cmermedical.com/smile/VisionCorrectionCenter/userShare/boxShare-newtitle-mb.svg 400w,
                https://statichk.cmermedical.com/smile/VisionCorrectionCenter/userShare/boxShare-newtitle-mb.svg 640w,
                https://statichk.cmermedical.com/smile/VisionCorrectionCenter/userShare/boxShare-newtitle-pc.png
              "
              sizes="(max-width: 992px) 100vw, 1216px"
            />
            <p>聽聽各位真實用家親身感受</p>
          </div>
        </div>

        <div class="swiper UserShareBox-list" id={id} data-usershare-swiper>
          <ul class="swiper-wrapper m-0 p-0 list-none">
            {
              items.map((item) => (
                <li class="swiper-slide UserShareBox-list-item">
                  <a
                    class="UserShareBox-list-item-link"
                    href={item.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-cta="user_share"
                    draggable="false"
                    title={`觀看 ${item.nameCn || item.nameEn} 的 ${item.type} 矯視真實用家心得分享影片`}
                  >
                    <img draggable="false"
                      src={item.img}
                      alt={`${item.nameCn || item.nameEn} - 香港希瑪 ${item.type} 矯視用家分享`}
                      title={`${item.nameCn || item.nameEn} ${item.type} 微笑矯視親身感受`}
                      loading="lazy"
                      width="280"
                      height="190"
                    />
                    <span
                      class="UserShareBox-list-item-link-title"
                      style={`background-color: ${getColor(item.type)}`}
                    >
                      {item.type}
                    </span>
                    <div class="UserShareBox-list-item-link-text">
                      {item.text.map((text) => (
                        <p>{text}</p>
                      ))}
                      <i style={`background-color: ${getColor(item.type)}`} />
                      <div class="UserShareBox-list-item-link-text-name">
                        <span>{item.nameCn}</span>&nbsp;
                        <span class="UserShareBox-list-item-link-text-name-en">{item.nameEn}</span>
                      </div>
                    </div>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import Swiper from "swiper";
  import { FreeMode, Mousewheel } from "swiper/modules";

  function initUserShareSwipers() {
    const containers = document.querySelectorAll<HTMLElement>(
      ".UserShareBox-list[data-usershare-swiper]"
    );

    containers.forEach((el) => {
      if ((el as any).swiper) {
        (el as any).swiper.destroy(true, true);
      }

      let isDragging = false;
      let startX = 0;
      let startY = 0;

      const swiper = new Swiper(el, {
        modules: [FreeMode, Mousewheel],
        slidesPerView: "auto",
        spaceBetween: 3.75,
        freeMode: {
          enabled: true,
        },
        mousewheel: {
          forceToAxis: true,
        },
        grabCursor: true,
        preventClicks: true,
        preventClicksPropagation: true,
        breakpoints: {
          992: {
            spaceBetween: 5,
          },
          1139: {
            spaceBetween: 5,
            slidesOffsetAfter: 85,
          },
        },
      });

      if (el.dataset.dragBound === "1") return;
      el.dataset.dragBound = "1";

      el.addEventListener("pointerdown", (e) => {
        startX = e.clientX;
        startY = e.clientY;
        isDragging = false;
      });

      el.addEventListener("pointermove", (e) => {
        if (
          Math.abs(e.clientX - startX) > 6 ||
          Math.abs(e.clientY - startY) > 6
        ) {
          isDragging = true;
        }
      });

      swiper.on("sliderMove", () => {
        isDragging = true;
      });

      el.addEventListener(
        "click",
        (e) => {
          if (isDragging) {
            e.preventDefault();
            e.stopPropagation();
            isDragging = false;
          }
        },
        true
      );
    });
  }

  document.addEventListener("DOMContentLoaded", initUserShareSwipers);
  document.addEventListener("astro:page-load", initUserShareSwipers);
</script>

<style lang="scss">
