                background-size: cover;
              }

              h2,
              h3,
              h5 {
                text-align: center;
                margin-bottom: 24px;
                color: #4570b6;
                font-family: var(--font-hk);
                font-size: 30px;
                font-style: normal;
                font-weight: 900;
                line-height: 1.2;
                letter-spacing: 3px;
              }

              .swiperWrapList {
                height: 480px;
                overflow: hidden;
                position: relative;
                cursor: grab;

                &:active {
                  cursor: grabbing;
                }

                .swiper-wrapper {
                  display: flex;
                  flex-direction: column;
                  margin: 0 auto;
