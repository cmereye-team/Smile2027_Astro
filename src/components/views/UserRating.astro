  /* 折疊屏與中型平板過渡端 (600px ~ 991px) */
  @media (min-width: 600px) and (max-width: 991px) {
    .UserRating {
      .UserRatingContainer {
        .UserRatingBox {
          .UserRatingBox-top {
            height: auto;
            min-height: 440px;
            padding: 40px 15px 48px;

            .UserRatingBox-top-content {
              width: 100%;
              max-width: 580px;
              height: auto;
              background: rgba(255, 255, 255, 0.85);
              backdrop-filter: blur(12px);
              -webkit-backdrop-filter: blur(12px);
              border: 1px solid rgba(255, 255, 255, 0.7);
              border-radius: 24px;
              padding: 32px 28px;
              box-shadow: 0 12px 32px rgba(69, 112, 182, 0.12);
              box-sizing: border-box;

              &::before {
                width: 72px;
                height: 48px;
                right: 20px;
                top: -18px;
                border-radius: 8px;
              }

              .swiperWrapList {
                height: 320px;
              }
            }
          }

          .UserRatingBox-bottom {
            .UserRatingBox-bottom-top {
              padding-bottom: 48px;
              max-width: 720px;
              margin: 0 auto;

              .UserRatingBox-Link {
                position: static;
                transform: none;
                width: auto;
                display: flex;
                justify-content: center;
                align-items: center;
                gap: 36px;
                margin-top: 28px;

                a {
                  width: 148px;
                  height: 148px;
                  gap: 10px;
                }

                .UserShareBox-Link-btnone {
                  .btn-action-icon {
                    width: 56px;
                    height: 34px;
                  }
                }

                .UserShareBox-Link-btntwo {
                  position: static;
                  top: auto;
                  left: auto;

                  svg,
                  img.btn-action-icon {
                    width: 48px;
                    height: 36px;
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  /* 3. 預約服務看板 (.UserRatingBox-bottom) 深邃寶石海藍高光 */
  .UserRatingBox-bottom {
    position: relative;

    &::before {
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;
      opacity: 0;
      transition: opacity 2.8s cubic-bezier(0.25, 1, 0.5, 1);
      z-index: 0;
      background: radial-gradient(
        ellipse 90% 75% at 85% 15%,
        rgba(106, 160, 242, 0.38) 0%,
        rgba(69, 112, 182, 0) 70%
      );
    }

    & > * {
      position: relative;
      z-index: 1;
    }

    &.is-inview::before {
      animation: ambient-soft-breath 4.5s cubic-bezier(0.25, 1, 0.5, 1) forwards;
    }
  }

  /* 講座按鈕（.UserShareBox-Link-btntwo）專屬防護：z-index 高於下方環境輪播圖；hover / active / focus 保持白底不變，杜絕深藍底色 */
  .UserShareBox-Link-btntwo {
    z-index: 20 !important;
  }
  .UserShareBox-Link-btntwo,
  .UserShareBox-Link-btntwo:hover,
  .UserShareBox-Link-btntwo:focus,
