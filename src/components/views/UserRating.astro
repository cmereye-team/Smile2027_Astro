---
/*
 * @Author: Antigravity AI
 * @Date: 2026-09-01
 * @FilePath: /src/components/views/UserRating.astro
 * @Description: 希瑪微笑矯視中心用戶評分與預約服務板塊 (1:1 復刻原版 home.vue + 支援平滑拖拽與加速滾動)
 */
import { getLangFromUrl, useI18n, getLocalizedHref } from "@/i18n/utils";
import { evaluateListHk, evaluateListCn } from "@/data/evaluateData";

const lang = getLangFromUrl(Astro.url);
const { dict } = useI18n(Astro.url);
const isCn = lang === "zh-cn";
const evaluateList = isCn ? evaluateListCn : evaluateListHk;

// WhatsApp 轉化參數矩陣：首頁預約術前檢查使用 W-15
const whatsappUrl = "https://api.whatsapp.com/send?phone=85269408569&text=%E6%88%91%E6%83%B3%E9%A0%90%E7%B4%84(W-15)%E7%9F%AF%E8%A6%96%E5%89%8D%E6%AA%A2%E6%9F%A5%E5%8F%8A%E8%A9%AE%E8%A9%A2";
const appointFormUrl = getLocalizedHref("/ophthalmicInfo/AppointForm", lang);

const sectionTitle = dict.home.reviews.title;
const bookingTitle = dict.home.book.title;
---

<section class="UserRating" aria-labelledby="user-rating-heading">
  <div class="UserRatingContainer">
    <div class="UserRatingBox">
      <!-- 頂部：Google 用戶評分滾動看板 -->
      <div class="UserRatingBox-top">
        <div class="site-container">
          <div class="UserRatingBox-top-content">
            <h3 id="user-rating-heading">{sectionTitle}</h3>
            <div class="swiperWrapList" id="userRatingSwiper">
              <div class="swiper-wrapper">
                {
                  [...evaluateList, ...evaluateList].map((item) => (
                    <a
                      class="swiper-slide"
                      href={item.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      title={`${item.name} 於 Google Maps 的真實評論`}
                    >
                      <article class="swiperWrapList-item">
                        <p class="swiperWrapList-item-text">{item.commit}</p>
                        <div class="swiperWrapList-item-nameStart">
                          <span>{item.name}</span>
                          <div class="swiperWrapList-item-nameStart-star" role="img" aria-label="5星評價">
                            <!-- 單一高解析 SVG 圖像，由 CSS 自動等比響應縮放，杜絕多套代碼顯隱 -->
                            <img draggable="false"
                              src="/images/icons/icon-fivestar.svg"
                              alt="5星評價"
                              class="fivestar-img"
                              width="149"
                              height="25"
                              loading="lazy"
                            />
                          </div>
                        </div>
                      </article>
                    </a>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- 底部：預約服務引導與雙圓形動作按鈕 (100% 1:1 對標原版 home.vue 佈局) -->
      <div class="UserRatingBox-bottom">
        <div class="UserRatingBox-bottom-top site-container">
          <h2 id="booking-heading">{bookingTitle}</h2>
          <div class="UserRatingBox-bottom-content" set:html={dict.home.book.intro} />
          <div class="UserRatingBox-Link">
            <!-- 按鈕 1: 術前眼睛檢查 (WhatsApp 官方 W-15 追蹤) -->
            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="UserShareBox-Link-btnone"
              data-cta="whatsapp"
              aria-label={dict.home.book.button.appoint}
            >
              <span class="btn-action-icon" aria-hidden="true"></span>
              <span>{dict.home.book.button.appoint}</span>
            </a>

            <!-- 按鈕 2: 講座 (AppointForm 預約表格) -->
            <a
              href={appointFormUrl}
              class="UserShareBox-Link-btntwo"
              data-cta="lecture"
              aria-label={dict.home.book.button.lecture}
            >
              <img draggable="false"
                src="/images/icons/icon-lecture-dialog.svg"
                alt=""
                width="141"
                height="106"
                class="btn-action-icon"
                aria-hidden="true"
              />
              <span>{dict.home.book.button.lecture}</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import Swiper from "swiper";
  import { Autoplay, FreeMode } from "swiper/modules";

  function initUserRatingSwiper() {
    const el = document.getElementById("userRatingSwiper");
    if (!el) return;
    if ((el as any).swiper) {
      (el as any).swiper.destroy(true, true);
    }

    let isDragging = false;
    let dragDist = 0;
    let startY = 0;

    new Swiper(el, {
      modules: [Autoplay, FreeMode],
      direction: "vertical",
      loop: true,
      slidesPerView: "auto",
      spaceBetween: 0,
      speed: 1800, // 速度加快，流暢快速滾動推進
      autoplay: {
        delay: 1500, // 1.5s 即推進下一條，節奏輕快敏捷
        disableOnInteraction: false,
        pauseOnMouseEnter: true, // 鼠標懸停自動暫停
      },
      freeMode: {
        enabled: true,
        momentum: true,
        momentumRatio: 1.5,
      },
      allowTouchMove: true, // 支援滑鼠拖拽滑動
      grabCursor: true,
    });

    // 拖拽與點擊分離：拖拽位移 > 6px 時攔截 a 標籤跳轉
    el.addEventListener("mousedown", (e) => {
      startY = e.pageY;
      dragDist = 0;
      isDragging = false;
    });

    el.addEventListener("mousemove", (e) => {
      dragDist = Math.abs(e.pageY - startY);
      if (dragDist > 6) {
        isDragging = true;
      }
    });

    el.querySelectorAll<HTMLAnchorElement>(".swiper-slide").forEach((link) => {
      link.addEventListener("click", (e) => {
        if (isDragging) {
          e.preventDefault();
          e.stopPropagation();
        }
      });
    });
  }

  document.addEventListener("DOMContentLoaded", initUserRatingSwiper);
  document.addEventListener("astro:page-load", initUserRatingSwiper);
</script>

