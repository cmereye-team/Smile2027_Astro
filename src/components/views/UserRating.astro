  /* 移動端 (< 992px) */
  @media (max-width: 991px) {
    .UserRating {
      width: 100%;
      overflow: visible;
      position: relative;
      z-index: 10;
      .UserRatingContainer {
        .UserRatingBox {
          .UserRatingBox-top {
            width: 100%;
            height: clamp(422.5px, 216.67vw, 845px);
            background: url("https://static.cmermedical.com.hk/smile/assets/VisionCorrectionCenter/UserRating/UserRating-top-mb.webp")
              no-repeat;
            background-size: cover;
            background-position: 0 center;
            padding-top: clamp(21.5px, 11.03vw, 43px);

            .UserRatingBox-top-content {
              padding: clamp(24px, 12.31vw, 48px) clamp(15px, 7.69vw, 30px) 0;
              margin: 0 auto 0;
              width: clamp(180.5px, 92.56vw, 361px);
              height: clamp(218px, 111.79vw, 436px);
              background: url("https://static.cmermedical.com.hk/smile/assets/VisionCorrectionCenter/UserRating/UserRating-top-rate-mb.png")
                no-repeat;
              background-size: cover;
              position: relative;

              &::before {
                content: "";
                position: absolute;
                z-index: 1;
                width: clamp(48.5px, 24.87vw, 97px);
                height: clamp(32.5px, 16.67vw, 65px);
                right: clamp(8.5px, 4.36vw, 17px);
                top: clamp(-24px, -6.15vw, 12px);
                background: url("https://static.cmermedical.com.hk/smile/assets/VisionCorrectionCenter/UserRating/UserRating-top-rate-mb-before.jpg")
                  no-repeat;
                background-size: cover;
              }

              h2,
              h3,
              h5 {
                text-align: center;
                color: #4570b6;
                font-family: -apple-system, BlinkMacSystemFont, "PingFang HK",
                  "PingFang TC", "Noto Sans HK", "Microsoft JhengHei",
                  sans-serif;
                font-size: 24px;
                font-style: normal;
                font-weight: 700;
                line-height: 1.2;
                letter-spacing: 2px;
                padding-bottom: 12px;
              }

              .swiperWrapList {
                height: clamp(174px, 89.23vw, 348px);
                overflow: hidden;
                position: relative;
                cursor: grab;

                &:active {
                  cursor: grabbing;
                }

                .swiper-wrapper {
                  display: flex;
                  flex-direction: column;
                  margin: 0 auto;
                }

                .swiper-slide {
                  height: auto !important;
                  text-decoration: none;
                  display: block;
                  cursor: pointer;

                  .swiperWrapList-item {
                    padding-bottom: 12px;
                    margin-top: 12px;
                    border-bottom: 1.5px dotted #4570b6;

                    .swiperWrapList-item-text {
                      color: #6d6e71;
                      font-family: -apple-system, BlinkMacSystemFont,
                        "PingFang HK", "PingFang TC", "Noto Sans HK",
                        "Microsoft JhengHei", sans-serif;
                      font-size: 16px;
                      font-style: normal;
                      font-weight: 400;
                      line-height: 1.5;
                      letter-spacing: 0.5px;
                    }

                    .swiperWrapList-item-nameStart {
                      margin-top: 6px;
                      display: flex;
                      justify-content: space-between;
                      align-items: center;

                      & > span {
                        color: #6d6e71;
                        font-family: var(--font-hk);
                        font-size: 16px;
                        font-style: normal;
                        font-weight: 700;
                        line-height: 1.4;
                        letter-spacing: 0.5px;
                      }

                      .swiperWrapList-item-nameStart-star {
                        display: flex;
                        align-items: center;

                        .fivestar-img {
                          width: 149px;
                          height: auto;
                          max-height: 25px;
                          display: block;
                        }
                      }
                    }
                  }
                }
              }
            }
          }

          .UserRatingBox-bottom {
            padding-top: 40px;
            width: 100%;
            background: #4570b6;

            .UserRatingBox-bottom-top {
              position: relative;
              z-index: 2;
              padding-bottom: clamp(115px, 58.97vw, 230px);

              h2,
              h4 {
                text-align: center;
                color: #fff;
                font-family: -apple-system, BlinkMacSystemFont, "PingFang HK",
                  "PingFang TC", "Noto Sans HK", "Microsoft JhengHei",
                  sans-serif;
                font-size: 24px;
                font-style: normal;
                font-weight: 700;
                line-height: 1.25;
                letter-spacing: 3px;
              }

              :global(p) {
                padding: 0;
                color: #fff;
                text-align: justify;
                font-family: -apple-system, BlinkMacSystemFont, "PingFang HK",
                  "PingFang TC", "Noto Sans HK", "Microsoft JhengHei",
                  sans-serif;
                font-size: 16px;
                font-style: normal;
                font-weight: 400;
                line-height: 1.85;
                letter-spacing: 0.5px;
                margin-top: 15px;

                :global(span) {
                  font-weight: 700;
                }
              }

              .UserRatingBox-Link {
                position: absolute;
                bottom: clamp(25px, 12.82vw, 50px);
                left: 50%;
                transform: translateX(-50%);
                width: clamp(160px, 82.05vw, 320px);
                margin: 0 auto;

                a {
                  width: clamp(80px, 41.03vw, 160px);
                  height: clamp(80px, 41.03vw, 160px);
                  border-radius: 50%;
                  border: 0.5px solid #fff;
                  display: flex;
                  justify-content: center;
                  align-items: center;
                  flex-direction: column;
                  gap: clamp(6.5px, 3.33vw, 13px);
                  text-decoration: none;

                  span {
                    color: #fff;
                    text-align: center;
                    font-family: -apple-system, BlinkMacSystemFont,
                      "PingFang HK", "PingFang TC", "Noto Sans HK",
                      "Microsoft JhengHei", sans-serif;
                    font-size: 16px;
                    font-style: normal;
                    font-weight: 700;
                    line-height: 1.1;
                  }
                }

                .UserShareBox-Link-btnone {
