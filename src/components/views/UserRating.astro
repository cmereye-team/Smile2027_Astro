                  gap: 16px;
                  text-decoration: none;
                  color: #fff;
                  transition: all 0.3s ease;

                  span {
                    color: currentColor;
                    text-align: center;
                    font-family: var(--font-hk);
                    font-size: 28px;
                    font-style: normal;
                    font-weight: 900;
                    line-height: 1;
                    transition: color 0.3s ease;
                  }

                  &:hover {
                    background: #fff;
                    color: var(--color-primary, #4570b6);

                    span {
