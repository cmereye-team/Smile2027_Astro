---
import "@/styles/swiper-base.css";

const CDN_INDEX = "https://static.cmermedical.com.hk/smile/assets/index";

const banners = [
  {
    id: 1,
    pc: `${CDN_INDEX}/environment-pc-01.webp`,
    mb: `${CDN_INDEX}/environment-mb-01.webp`,
    title: "香港希瑪微笑矯視中心 - 現代化眼科接待大堂與寬敞舒適等候區",
    alt: "香港希瑪微笑矯視中心現代化接待大堂環境",
  },
  {
    id: 2,
    pc: `${CDN_INDEX}/environment-pc-02.webp`,
    mb: `${CDN_INDEX}/environment-mb-02.webp`,
    title: "香港希瑪微笑矯視中心 - 德國蔡司國際標準百級無菌層流手術室",
    alt: "希瑪微笑矯視中心德國蔡司全飛秒無菌手術室",
  },
  {
    id: 3,
    pc: `${CDN_INDEX}/environment-pc-03.webp`,
    mb: `${CDN_INDEX}/environment-mb-03.webp`,
    title: "香港希瑪微笑矯視中心 - 精密屈光術前多維度眼睛檢查室與儀器設備",
    alt: "希瑪微笑矯視精密術前檢查室與儀器設備",
  },
  {
    id: 4,
    pc: `${CDN_INDEX}/environment-pc-04.webp`,
    mb: `${CDN_INDEX}/environment-mb-04.webp`,
    title: "香港希瑪微笑矯視中心 - 一對一專科醫生獨立諮詢與精準診症室",
    alt: "希瑪微笑矯視專科醫生獨立諮詢與診症空間",
  },
];
---

<section class="section-environment" aria-label="希瑪微笑矯視中心門市與手術室環境展示">
  <div class="swiper env-carousel-wrapper" id="envCarousel">
    <div class="swiper-wrapper">
      {
        banners.map((banner) => (
          <div class="swiper-slide env-carousel-slide">
            <picture class="block w-full h-full">
              <source media="(min-width: 1024px)" srcset={banner.pc} type="image/webp" width="1442" height="813" />
              <img
                src={banner.mb}
                alt={banner.alt}
                title={banner.title}
                width="749"
                height="520"
                loading="lazy"
                decoding="async"
                fetchpriority="low"
                draggable="false"
                class="w-full h-full object-cover"
              />
            </picture>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style lang="scss">
  .section-environment {
    width: 100%;
    position: relative;
    z-index: 1;
    margin-bottom: 2rem;
    @media (min-width: 768px) {
      margin-bottom: 4rem;
    }
    @media (min-width: 1024px) {
      margin-bottom: 6rem;
    }
  }
  .env-carousel-wrapper {
    width: 100%;
    overflow: hidden;
    position: relative;
    background-color: #fff;
    max-height: 280px;
    @media (min-width: 560px) {
      max-height: 340px;
      height: 340px;
    }
    @media (min-width: 1024px) {
      max-height: 450px;
      height: 450px;
    }

    picture {
      display: block;
      width: 100%;
      height: 100%;
      overflow: hidden;
    }

    img {
      width: 100%;
      height: 100%;
      aspect-ratio: 749 / 520;
      object-fit: cover;
      transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
      @media (min-width: 560px) {
        aspect-ratio: auto;
        height: 340px !important;
        max-height: 340px !important;
      }
      @media (min-width: 1024px) {
        aspect-ratio: auto;
        height: 450px !important;
        max-height: 450px !important;
        object-fit: cover;
      }
    }

    :global(.swiper-slide:hover) img {
      transform: scale(1.04);
    }

    :global(.swiper-wrapper) {
      display: flex !important;
      flex-direction: row !important;
      width: 100%;
      height: 100%;
      position: relative;
      transition-timing-function: linear !important;
    }
    :global(.swiper-slide) {
      flex-shrink: 0 !important;
      height: 100% !important;
      position: relative;
      overflow: hidden;
      @media (min-width: 560px) {
        max-height: 340px !important;
        height: 340px !important;
      }
      @media (min-width: 1024px) {
        max-height: 450px !important;
        height: 450px !important;
      }
    }
  }
</style>

<script>
  import Swiper from "swiper";
  import { Autoplay } from "swiper/modules";

  function startEnvCarousel() {
    const el = document.getElementById("envCarousel");
    if (!el) return;

    const runInit = () => {
      if ((el as any).swiper) {
        (el as any).swiper.destroy(true, true);
      }

      new Swiper(el, {
        modules: [Autoplay],
        loop: true,
        speed: 5000,
        autoplay: {
          delay: 0,
          disableOnInteraction: false,
        },
        spaceBetween: 0,
        slidesPerView: 1,
        breakpoints: {
          560: {
            slidesPerView: 2,
          },
          1280: {
            slidesPerView: 2.2,
          },
          1560: {
            slidesPerView: 2.5,
          },
        },
      });
    };

    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        (entries, obs) => {
          if (entries[0]?.isIntersecting) {
            obs.disconnect();
            runInit();
          }
        },
        { rootMargin: "200px" }
      );
      observer.observe(el);
    } else {
      runInit();
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", startEnvCarousel);
  } else {
    startEnvCarousel();
  }
  document.addEventListener("astro:page-load", startEnvCarousel);
</script>
