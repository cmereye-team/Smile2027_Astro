---
/*
 * @FilePath: /src/components/views/LegalPage.astro
 * @Description: 法律條款與政策通用語意渲染組件 (單一 H1 + 共享 .site-container + 純淨閱讀排版)
 */
import type { LegalBlock } from "@/data/legalData";

interface Props {
  title: string;
  blocks: LegalBlock[];
}

const { title, blocks } = Astro.props;
---

<section class="legal-page" aria-labelledby="legal-page-heading">
  <div class="site-container">
    <article class="legal-article">
      <header class="legal-header">
        <h1 id="legal-page-heading" class="legal-title">{title}</h1>
      </header>

      <div class="legal-body">
        {
          blocks.map((block) => {
            if (block.type === "heading") {
              return <h2 class="legal-subtitle">{block.text}</h2>;
            }
            if (block.type === "html") {
              return <p class="legal-paragraph" set:html={block.html} />;
            }
            return <p class="legal-paragraph">{block.text}</p>;
          })
        }
      </div>
    </article>
  </div>
</section>

<style lang="scss">
  .legal-page {
    padding-top: 2.5rem;
    padding-bottom: 6rem;
  }

  .legal-header {
    display: flex;
    justify-content: center;
    margin-bottom: 1.5rem;
  }

  .legal-title {
    margin: 0;
    color: var(--color-primary);
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.4;
    text-align: center;
  }

  .legal-subtitle {
    margin-top: 0.5rem;
    margin-bottom: 1rem;
    color: #25395e;
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.5;
  }

  .legal-paragraph {
    margin: 0;
    padding-bottom: 1rem;
    color: var(--color-desc);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.8;

    &:last-child {
      padding-bottom: 0;
    }

    :global(a) {
      color: #25395e;
      text-decoration: underline;
      text-underline-offset: 3px;
      transition: color var(--dur-fast) var(--ease-out);

      &:hover {
        color: var(--color-primary);
      }
    }
  }

  @media (min-width: 768px) {
    .legal-page {
      padding-top: 3rem;
      padding-bottom: 6rem;
    }

    .legal-title {
      font-size: 1.75rem;
    }

    .legal-subtitle {
      font-size: 1.375rem;
    }
  }
</style>
