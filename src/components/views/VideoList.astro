---
import { Image } from "astro:assets";
import { ALL_VIDEOS, VIDEO_TABS, type VideoType } from "@/data/videoData";
import { useI18n } from "@/i18n/utils";
const { dict } = useI18n(Astro.url);
const defaultType = "smilepro";
const typeConfig: Record<VideoType, { bg: string; label: string; color: string }> = {
  smilepro: { bg: "bg-[#4570B6]", label: "SMILE Pro", color: "#4570B6" },
  smile: { bg: "bg-[#30ABE2]", label: "SMILE", color: "#30ABE2" },
  icl: { bg: "bg-[#EB981A]", label: "ICL", color: "#EB981A" },
};
---

<section class="site-container mb-12 lg:mb-17">
  <div class="search mb-8 lg:mb-10 px-4 md:px-0">
    <div class="border border-primary rounded-lg overflow-hidden flex w-full max-w-md mx-auto">
      <div class="center p-3 bg-primary size-12 shrink-0">
        <img draggable="false"
          src="/images/icons/icon-search.svg"
          alt={dict.page.video.search}
          title={dict.page.video.search}
          width="24"
          height="25"
          aria-hidden="true"
         loading="lazy" decoding="async"/>
      </div>
      <div class="flex-1 py-2 px-3 flex items-center">
        <input
          id="video-search"
          type="search"
          placeholder={dict.page.video.search}
          class="w-full focus:outline-none text-desc text-base font-normal leading-normal tracking-wider"
          maxlength="20"
        />
      </div>
    </div>
  </div>

  <div
    class="media-pill-tabs"
    id="video-tabs-container"
    role="tablist"
    aria-label={dict.common.menu.news.case}
  >
    {
      VIDEO_TABS.map((tab) => {
        const isActive = defaultType === tab.key;
        return (
          <button
            type="button"
            role="tab"
            aria-selected={isActive ? "true" : "false"}
            data-tab-key={tab.key}
            class={`media-pill-tab ${isActive ? "is-active" : ""}`}
          >
            {tab.label}
          </button>
        );
      })
    }
  </div>

  <div class="media-fluid-section">
    <div class="video-list media-fluid-grid">
      {
        ALL_VIDEOS.map((item, index) => {
          const hasDefault = item.type.includes(defaultType);
          const cardDisplayType = hasDefault ? defaultType : item.type[0];
          const currentConfig = typeConfig[cardDisplayType];
          const cleanTitle = item.title.replace(/<[^>]+>/g, " ").replace(/\s+/g, " ").trim();
          const cardTitle = [cleanTitle, item.name, item.enName].filter(Boolean).join(" - ");
          return (
            <article
              class="video-item media-card video-media-card group"
              data-types={item.type.join(",")}
              data-name={item.name || ""}
              data-en-name={item.enName || ""}
              style={{ display: hasDefault ? "flex" : "none" }}
            >
              <a
                href={item.link}
                target="_blank"
                rel="noopener noreferrer"
                title={cardTitle}
                class="media-card-link"
              >
                <div class="media-card-thumb">
                  <Image
                    src={item.img}
                    alt={cardTitle}
                    title={cardTitle}
                    width={265}
                    height={439}
                    loading={index < 4 ? "eager" : "lazy"}
                    draggable="false"
                  />
                  {currentConfig && (
                    <span
                      data-label
                      data-smilepro-bg="bg-[#4570B6]"
                      data-smilepro-text="SMILE Pro"
                      data-smilepro-color="#4570B6"
                      data-smile-bg="bg-[#30ABE2]"
                      data-smile-text="SMILE"
                      data-smile-color="#30ABE2"
                      data-icl-bg="bg-[#EB981A]"
                      data-icl-text="ICL"
                      data-icl-color="#EB981A"
                      class={`media-card-badge ${currentConfig.bg}`}
                    >
                      {currentConfig.label}
                    </span>
                  )}
                  <div class="media-card-body video-card-scrim">
                    <h3
                      set:html={item.title}
                      class="video-title media-card-title"
                      style={currentConfig ? `--title-color: ${currentConfig.color}` : ""}
                    />
                    {(item.name || item.enName) && (
                      <p class="media-card-meta">
                        {item.name && <span>{item.name}</span>}
                        {item.name && item.enName && <span aria-hidden="true">·</span>}
                        {item.enName && <span>{item.enName}</span>}
                      </p>
                    )}
                  </div>
                </div>
              </a>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
<script>
  function initVideoFilter() {
    const container = document.getElementById("video-tabs-container");
    const searchInput = document.getElementById("video-search") as HTMLInputElement | null;
    if (!container) return;

    const tabs = container.querySelectorAll("button");

    // 状态管理：保存当前选中的 Tab 类型和当前的搜索关键词
    let currentType = "smilepro"; // 需与 Astro 模板中的 defaultType 保持一致
    let searchQuery = "";

    // 1. 绑定 Tabs 点击事件
    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const activeType = tab.getAttribute("data-tab-key");
        if (!activeType) return;

        currentType = activeType;

        // 切换 Tab 激活状态
        tabs.forEach((t) => {
          const selected = t === tab;
          t.classList.toggle("is-active", selected);
          t.setAttribute("aria-selected", selected ? "true" : "false");
        });

        // 执行联合过滤
        applyFilter();
      });
    });

    // 2. 绑定 搜索框 输入事件
    if (searchInput) {
      searchInput.addEventListener("input", (e) => {
        const target = e.target as HTMLInputElement;
        searchQuery = target.value.trim().toLowerCase();
        applyFilter();
      });
    }

    // 3. 联合过滤核心逻辑
    function applyFilter() {
      const videoList = document.querySelectorAll(".video-item");

      videoList.forEach((card) => {
        const htmlCard = card as HTMLElement;

        const typesStr = htmlCard.getAttribute("data-types") || "";
        const typesArray = typesStr.split(",");
        const name = htmlCard.getAttribute("data-name") || "";
        const enName = (htmlCard.getAttribute("data-en-name") || "").toLowerCase();

        const matchesType = typesArray.includes(currentType);
        const matchesSearch = !searchQuery || name.includes(searchQuery) || enName.includes(searchQuery);

        if (matchesType && matchesSearch) {
          htmlCard.style.display = "flex";

          const labelEl = htmlCard.querySelector("[data-label]") as HTMLElement | null;
          const titleEl = htmlCard.querySelector(".video-title") as HTMLElement | null;

          if (labelEl) {
            const targetBg = labelEl.getAttribute(`data-${currentType}-bg`);
            const targetText = labelEl.getAttribute(`data-${currentType}-text`);
            const targetColor = labelEl.getAttribute(`data-${currentType}-color`);

            if (targetBg && targetText) {
              labelEl.textContent = targetText;
              labelEl.classList.remove("bg-[#4570B6]", "bg-[#30ABE2]", "bg-[#EB981A]");
              labelEl.classList.add(targetBg);
            }

            if (titleEl && targetColor) {
              titleEl.style.setProperty("--title-color", targetColor);
            }
          }
        } else {
          htmlCard.style.display = "none";
        }
      });
    }
  }

  initVideoFilter();
  document.addEventListener("astro:page-load", initVideoFilter);
</script>
<style>
  .video-list.media-fluid-grid {
    align-items: start;
  }

  .video-media-card {
    border: 0;
  }

  .video-media-card .media-card-thumb {
    aspect-ratio: auto;
  }

  .video-media-card .media-card-thumb img {
    width: 100%;
    height: auto;
    object-fit: cover;
    display: block;
  }

  .video-media-card .video-card-scrim {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    z-index: 2;
    padding: 48px 16px 16px;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 0, 0, 0.58) 45%,
      rgba(0, 0, 0, 0.85) 100%
    );
    gap: 4px;
  }

  .video-media-card .media-card-title {
    color: #ffffff;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.45);
  }

  .video-media-card .media-card-meta {
    margin: 0;
    padding-top: 2px;
    color: rgba(255, 255, 255, 0.92);
  }

  .video-title :global(br) {
    display: none;
  }
</style>
