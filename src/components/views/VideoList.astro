---
import { Image } from "astro:assets";
import { ALL_VIDEOS, VIDEO_TABS, type VideoType } from "@/data/videoData";
import { useI18n } from "@/i18n/utils";
const { dict } = useI18n(Astro.url);
const defaultType = "smilepro";
const typeConfig: Record<VideoType, { bg: string; label: string; color: string }> = {
  smilepro: { bg: "bg-[#4570B6]", label: "SMILE Pro", color: "#4570B6" },
  smile: { bg: "bg-[#30ABE2]", label: "SMILE", color: "#30ABE2" },
  icl: { bg: "bg-[#EB981A]", label: "ICL", color: "#EB981A" },
};
---

<section class="site-container mb-12 lg:mb-17">
  <div class="search mb-8 lg:mb-10 px-4 md:px-0">
    <div class="border border-primary rounded-lg overflow-hidden flex w-full max-w-md mx-auto">
      <div class="center p-3 bg-primary size-12 shrink-0">
        <img draggable="false"
          src="/images/icons/icon-search.svg"
          alt={dict.page.video.search}
          title={dict.page.video.search}
          width="24"
          height="25"
          aria-hidden="true"
         loading="lazy" decoding="async"/>
      </div>
      <div class="flex-1 py-2 px-3 flex items-center">
        <input
          id="video-search"
          type="search"
          aria-label={dict.page.video.search}
          placeholder={dict.page.video.search}
          class="w-full focus:outline-none text-desc text-base font-normal leading-normal tracking-wider"
          maxlength="20"
        />
      </div>
    </div>
  </div>

  <div
    class="media-pill-tabs"
    id="video-tabs-container"
    role="tablist"
    aria-label={dict.common.menu.news.case}
  >
    {
      VIDEO_TABS.map((tab) => {
        const isActive = defaultType === tab.key;
        return (
          <button
            type="button"
            role="tab"
            aria-selected={isActive ? "true" : "false"}
            data-tab-key={tab.key}
            class={`media-pill-tab ${isActive ? "is-active" : ""}`}
          >
            {tab.label}
          </button>
        );
      })
    }
  </div>

  <h2 class="sr-only">{dict.common.menu.news.case}</h2>
  <div class="media-fluid-section">
    <div class="video-list media-fluid-grid">
      {
        ALL_VIDEOS.map((item, index) => {
          const hasDefault = item.type.includes(defaultType);
          const cardDisplayType = hasDefault ? defaultType : item.type[0];
          const currentConfig = typeConfig[cardDisplayType];
          const cleanTitle = item.title.replace(/<[^>]+>/g, " ").replace(/\s+/g, " ").trim();
          const cardTitle = [cleanTitle, item.name, item.enName].filter(Boolean).join(" - ");
          return (
            <article
              class="video-item media-card video-media-card group"
              data-types={item.type.join(",")}
              data-name={item.name || ""}
              data-en-name={item.enName || ""}
              style={{ display: hasDefault ? "flex" : "none" }}
            >
              <a
                href={item.link}
                target="_blank"
                rel="noopener noreferrer"
                title={cardTitle}
                class="media-card-link"
              >
                <div class="media-card-thumb">
                  <Image
                    src={item.img}
                    alt={cardTitle}
                    title={cardTitle}
                    width={265}
                    height={439}
                    loading={index < 4 ? "eager" : "lazy"}
                    draggable="false"
                  />
                  {currentConfig && (
                    <span
                      data-label
                      data-smilepro-bg="bg-[#4570B6]"
                      data-smilepro-text="SMILE Pro"
                      data-smilepro-color="#4570B6"
                      data-smile-bg="bg-[#30ABE2]"
                      data-smile-text="SMILE"
                      data-smile-color="#30ABE2"
                      data-icl-bg="bg-[#EB981A]"
                      data-icl-text="ICL"
                      data-icl-color="#EB981A"
                      class={`media-card-badge ${currentConfig.bg}`}
                    >
                      {currentConfig.label}
                    </span>
                  )}
                  <div
                    class="media-card-body video-card-scrim"
                    data-card-scrim
                    style={currentConfig ? `--accent-color: ${currentConfig.color}` : ""}
                  >
                    <h3
                      set:html={item.title}
                      class="video-title media-card-title"
                      style={currentConfig ? `--title-color: ${currentConfig.color}` : ""}
                    />
                    <span class="video-card-divider" aria-hidden="true" />
                    {(item.name?.trim() || item.enName?.trim()) && (
                      <p class="media-card-meta">
                        {item.name?.trim() && <span class="video-card-name-zh">{item.name.trim()}</span>}
                        {item.enName?.trim() && <span class="video-card-name-en">{item.enName.trim()}</span>}
                      </p>
                    )}
                  </div>
                </div>
              </a>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
<script>
  function initVideoFilter() {
    const container = document.getElementById("video-tabs-container");
    const searchInput = document.getElementById("video-search") as HTMLInputElement | null;
    if (!container) return;

    const tabs = container.querySelectorAll("button");

    // 状态管理：保存当前选中的 Tab 类型和当前的搜索关键词
    let currentType = "smilepro"; // 需与 Astro 模板中的 defaultType 保持一致
    let searchQuery = "";

    // 1. 绑定 Tabs 点击事件
    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const activeType = tab.getAttribute("data-tab-key");
        if (!activeType) return;

        currentType = activeType;

        // 切换 Tab 激活状态
        tabs.forEach((t) => {
          const selected = t === tab;
          t.classList.toggle("is-active", selected);
          t.setAttribute("aria-selected", selected ? "true" : "false");
        });

        // 执行联合过滤
        applyFilter();
      });
    });

    // 2. 绑定 搜索框 输入事件
    if (searchInput) {
      searchInput.addEventListener("input", (e) => {
        const target = e.target as HTMLInputElement;
        searchQuery = target.value.trim().toLowerCase();
        applyFilter();
      });
    }

    // 3. 联合过滤核心逻辑
    function applyFilter() {
      const videoList = document.querySelectorAll(".video-item");

      videoList.forEach((card) => {
        const htmlCard = card as HTMLElement;

        const typesStr = htmlCard.getAttribute("data-types") || "";
        const typesArray = typesStr.split(",");
        const name = htmlCard.getAttribute("data-name") || "";
        const enName = (htmlCard.getAttribute("data-en-name") || "").toLowerCase();

        const matchesType = typesArray.includes(currentType);
        const matchesSearch = !searchQuery || name.includes(searchQuery) || enName.includes(searchQuery);

        if (matchesType && matchesSearch) {
          htmlCard.style.display = "flex";

          const labelEl = htmlCard.querySelector("[data-label]") as HTMLElement | null;
          const titleEl = htmlCard.querySelector(".video-title") as HTMLElement | null;
          const scrimEl = htmlCard.querySelector("[data-card-scrim]") as HTMLElement | null;

          if (labelEl) {
            const targetBg = labelEl.getAttribute(`data-${currentType}-bg`);
            const targetText = labelEl.getAttribute(`data-${currentType}-text`);
            const targetColor = labelEl.getAttribute(`data-${currentType}-color`);

            if (targetBg && targetText) {
              labelEl.textContent = targetText;
              labelEl.classList.remove("bg-[#4570B6]", "bg-[#30ABE2]", "bg-[#EB981A]");
              labelEl.classList.add(targetBg);
            }

            if (titleEl && targetColor) {
              titleEl.style.setProperty("--title-color", targetColor);
            }

            if (scrimEl && targetColor) {
              scrimEl.style.setProperty("--accent-color", targetColor);
            }
          }
        } else {
          htmlCard.style.display = "none";
        }
      });
    }
  }

  initVideoFilter();
  document.addEventListener("astro:page-load", initVideoFilter);
</script>
<style>
  .media-pill-tabs {
    display: flex;
    flex-wrap: nowrap;
    align-items: stretch;
    width: 100%;
    margin-bottom: 36px;
    border-bottom: 1px solid #c8d5ea;
  }

  .media-pill-tab {
    display: inline-flex;
    flex: 1 1 0;
    min-width: 0;
    align-items: center;
    justify-content: center;
    padding: 18px 8px;
    border: 0;
    border-radius: 0;
    background-color: transparent;
    color: var(--color-primary);
    font-family: var(--font-en), var(--font-hk), sans-serif;
    font-size: clamp(15px, 4.2vw, 18px);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.08em;
    text-indent: 0.08em;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .media-pill-tab:hover {
    background-color: #f4f8fc;
  }

  .media-pill-tab.is-active,
  .media-pill-tab.is-active:hover {
    background-color: var(--color-primary);
    color: #ffffff;
  }

  @media (min-width: 640px) {
    .media-pill-tab {
      padding: 22px 12px;
      font-size: 22px;
      line-height: 1.1;
      letter-spacing: 0.16em;
      text-indent: 0.16em;
    }
  }

  @media (min-width: 1024px) {
    .media-pill-tabs {
      margin-bottom: 52px;
    }

    .media-pill-tab {
      min-height: 85px;
      padding: 27px 16px;
      font-size: 30px;
      line-height: 1;
      letter-spacing: 7.5px;
      text-indent: 7.5px;
    }
  }

  .video-list.media-fluid-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px 14px;
    align-items: start;
  }

  @media (min-width: 768px) {
    .video-list.media-fluid-grid {
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: 24px 20px;
    }
  }

  @media (min-width: 1024px) {
    .video-list.media-fluid-grid {
      gap: 28px 24px;
    }
  }

  .video-media-card {
    container-type: inline-size;
    border: 0;
    border-radius: 0;
  }

  .video-media-card .media-card-thumb {
    aspect-ratio: 265 / 439;
  }

  .video-media-card .media-card-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .video-media-card .media-card-badge {
    top: clamp(8px, 5.5cqi, 22px);
    right: clamp(8px, 5cqi, 20px);
    padding: clamp(3px, 1.8cqi, 8px) clamp(11px, 6.8cqi, 26px);
    border-radius: 9999px;
    font-family: var(--font-en), "Poppins", sans-serif;
    font-size: clamp(13px, 7.2cqi, 22px);
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: 0;
  }

  .video-media-card .video-card-scrim {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    z-index: 2;
    padding:
      clamp(36px, 22cqi, 64px)
      clamp(12px, 7cqi, 28px)
      clamp(14px, 8.5cqi, 32px)
      clamp(14px, 9.5cqi, 36px);
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 0, 0, 0.42) 48%,
      rgba(0, 0, 0, 0.78) 100%
    );
    gap: 0;
  }

  .video-media-card .media-card-title {
    color: #ffffff;
    font-family: var(--font-hk), "Noto Sans HK", sans-serif;
    font-size: clamp(12.5px, 6.4cqi, 21px);
    font-weight: 700;
    line-height: 1.44;
    letter-spacing: 0.06em;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.45);
  }

  .video-media-card .video-card-divider {
    display: block;
    width: clamp(44px, 25cqi, 84px);
    height: clamp(2px, 1cqi, 3px);
    margin: clamp(8px, 4cqi, 15px) 0;
    background-color: var(--accent-color, var(--color-primary));
  }

  .video-media-card .media-card-meta {
    margin: 0;
    padding-top: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35em;
    color: #ffffff;
    font-family: var(--font-hk), "Noto Sans HK", sans-serif;
    font-size: clamp(13.5px, 6.8cqi, 23px);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.06em;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.45);
  }

  .video-media-card .video-card-name-en {
    font-family: var(--font-en), "Poppins", sans-serif;
    font-weight: 700;
  }

  :global(html[lang="zh-cn"]) .video-media-card .media-card-title,
  :global(html[lang="zh-cn"]) .video-media-card .video-card-name-zh {
    font-family: var(--font-sc), "Noto Sans SC", sans-serif;
  }
</style>
