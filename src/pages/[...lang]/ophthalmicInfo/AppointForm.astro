---
/*
 * @Author: Antigravity AI
 * @Date: 2026-11-10
 * @FilePath: /src/pages/[...lang]/ophthalmicInfo/AppointForm.astro
 * @Description: 講座預約專頁 (100% 官方真值對齊 + 講座預約表單 + 完整 Schema)
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import SchemaProcedure from "@/components/seo/SchemaProcedure.astro";
import SchemaBreadcrumb from "@/components/seo/SchemaBreadcrumb.astro";
import BookingBanner from "@/components/booking/BookingBanner.astro";
import { i18nPaths, getLangFromUrl } from "@/i18n/utils";
import {
  BOOKING_ZH_HK,
  BOOKING_ZH_CN,
  DEFAULT_SCHEDULES,
  DEFAULT_CALENDARS,
} from "@/data/bookingData";

export function getStaticPaths() {
  return [...i18nPaths];
}

const lang = getLangFromUrl(Astro.url);
const isCn = lang === "zh-cn";
const content = isCn ? BOOKING_ZH_CN : BOOKING_ZH_HK;
---

<BaseLayout tdkKey="appointForm">
  <SchemaProcedure
    name={content.appointForm.calendarTitle}
    description={content.appointForm.p3.replace(/<[^>]+>/g, "")}
  />
  <SchemaBreadcrumb
    items={[
      { name: content.breadcrumb.home, url: isCn ? "/cn/" : "/" },
      {
        name: content.appointForm.calendarTitle,
        url: isCn ? "/cn/ophthalmicInfo/AppointForm" : "/ophthalmicInfo/AppointForm",
      },
    ]}
  />

  <div class="appoint-form-page font-hk text-desc relative overflow-x-hidden">
    <h1 class="sr-only">{content.banner.title}</h1>

    {/* 1. 頂部橫幅 Hero Banner (CMS slides API: gid=2&pageSize=5) */}
    <BookingBanner title={content.banner.title} gid={2} pageSize={5} />

    {/* 2. 預約講座核心表單區塊 */}
    <section id="appoint-form" class="lecture-box mb-[56px]" aria-labelledby="lecture-title-heading">
      <div class="lecture-title">
        <div class="container mx-auto px-4">
          <div class="lecture-content">
            <div class="text-center">
              <h2
                id="lecture-title-heading"
                class="text-[clamp(18px,4.44vw,26px)] font-bold text-primary leading-relaxed"
                set:html={content.appointForm.title}
              />
            </div>
            <div class="intro-paragraphs text-center mt-5 space-y-4">
              <p
                class="text-base md:text-[19px] md:leading-[30px] text-text leading-relaxed font-light"
                set:html={content.appointForm.p3}
              />
              <p
                class="text-base md:text-[19px] md:leading-[30px] text-text leading-relaxed font-light"
                set:html={content.appointForm.p4}
              />
              <p
                class="text-base md:text-[19px] md:leading-[30px] text-text leading-relaxed font-medium"
                set:html={content.appointForm.p5}
              />
            </div>

            {/* 互動表單主體 */}
            <div class="lecture-form">
              <form id="booking-lecture-form" class="form0" novalidate>
                {/* 步驟 1: 服務與地點下拉選單 */}
                <div class="lecture-form__service-wrap">
                  <div class="form-item">
                    <label class="form-item__label" for="service-select">
                      {content.appointForm.form.serviceLabel}
                    </label>
                    <div class="select-wrapper">
                      <select id="service-select" name="serviceVal" class="custom-select" required>
                        <option value="" disabled selected>
                          {content.appointForm.form.servicePlaceholder}
                        </option>
                        {content.appointForm.form.serviceOptions.map((opt) => (
                          <option value={opt.value}>{opt.label}</option>
                        ))}
                      </select>
                    </div>
                  </div>

                  <div class="form-item">
                    <label class="form-item__label" for="location-select">
                      {content.appointForm.form.locationLabel}
                    </label>
                    <div class="select-wrapper">
                      <select id="location-select" name="addressVal" class="custom-select" required>
                        <option value="" disabled selected>
                          {content.appointForm.form.locationPlaceholder}
                        </option>
                        {content.appointForm.form.locationOptions.map((opt) => (
                          <option value={opt.value}>{opt.label}</option>
                        ))}
                      </select>
                    </div>
                  </div>
                </div>

                {/* 步驟 2: 日期選擇 */}
                <div id="date-select-wrap" class="form-item mt-6 hidden">
                  <label class="form-item__label" for="date-select">
                    {content.appointForm.form.dateLabel}
                  </label>
                  <div class="select-wrapper">
                    <select id="date-select" name="subdate" class="custom-select">
                      <option value="" disabled selected>
                        {content.appointForm.form.datePlaceholder}
                      </option>
                    </select>
                  </div>
                </div>

                {/* 步驟 3: 選取結果摘要提示 */}
                <p id="selection-summary" class="form-data hidden">
                  {content.appointForm.form.previewPrefix}
                  <span id="summary-datetime"></span> {content.appointForm.form.previewSuffix}
                  <span id="summary-lecture-name"></span>
                  {content.appointForm.form.previewTail}
                </p>

                {/* 步驟 4: 個人詳細資料填寫 */}
                <div id="user-details-form" class="form1 hidden mt-8">
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    {/* 預留位置 */}
                    <div class="form-item">
                      <label class="form-item__label" for="seats-select">
                        {content.appointForm.form.seatsLabel}
                      </label>
                      <div class="select-wrapper">
                        <select id="seats-select" name="numberSeat" class="custom-select" required>
                          <option value="" disabled selected>
                            {content.appointForm.form.seatsPlaceholder}
                          </option>
                          {content.appointForm.form.seatsOptions.map((num) => (
                            <option value={num}>{num}</option>
                          ))}
                        </select>
                      </div>
                    </div>

                    {/* 姓名 (必填) */}
                    <div class="form-item">
                      <label class="form-item__label" for="name-input">
                        {content.appointForm.form.nameLabel} <span class="text-red-300 ml-1">*</span>
                      </label>
                      <input
                        id="name-input"
                        type="text"
                        name="name"
                        class="custom-input"
                        placeholder={content.appointForm.form.namePlaceholder}
                        required
                      />
                    </div>

                    {/* 性別 */}
                    <div class="form-item">
                      <label class="form-item__label" for="sex-select">
                        {content.appointForm.form.sexLabel}
                      </label>
                      <div class="select-wrapper">
                        <select id="sex-select" name="sex" class="custom-select">
                          <option value="" selected>
                            {content.appointForm.form.sexPlaceholder}
                          </option>
                          {content.appointForm.form.sexOptions.map((opt) => (
                            opt.value ? <option value={opt.value}>{opt.label}</option> : null
                          ))}
                        </select>
                      </div>
                    </div>

                    {/* 年齡 */}
                    <div class="form-item">
                      <label class="form-item__label" for="age-select">
                        {content.appointForm.form.ageLabel}
                      </label>
                      <div class="select-wrapper">
                        <select id="age-select" name="age" class="custom-select">
                          <option value="" disabled selected>
                            {content.appointForm.form.agePlaceholder}
                          </option>
                          {content.appointForm.form.ageOptions.map((age) => (
                            <option value={age}>{age}</option>
                          ))}
                        </select>
                      </div>
                    </div>

                    {/* 聯絡電話 (必填) */}
                    <div class="form-item">
                      <label class="form-item__label" for="phone-input">
                        {content.appointForm.form.phoneLabel} <span class="text-red-300 ml-1">*</span>
                      </label>
                      <input
                        id="phone-input"
                        type="tel"
                        name="telphoneNumber"
                        class="custom-input"
                        placeholder={content.appointForm.form.phonePlaceholder}
                        required
                      />
                    </div>

                    {/* 電郵地址 */}
                    <div class="form-item">
                      <label class="form-item__label" for="email-input">
                        {content.appointForm.form.emailLabel}
                      </label>
                      <input
                        id="email-input"
                        type="email"
                        name="email"
                        class="custom-input"
                        placeholder={content.appointForm.form.emailPlaceholder}
                      />
                    </div>
                  </div>

                  {/* 從何處得知我們 */}
                  <div class="form-item mt-6">
                    <label class="form-item__label" for="source-select">
                      {content.appointForm.form.sourceLabel}
                    </label>
                    <div class="select-wrapper">
                      <select id="source-select" name="source" class="custom-select">
                        <option value="" disabled selected>
                          {content.appointForm.form.sourcePlaceholder}
                        </option>
                        {content.appointForm.form.sourceOptions.map((src) => (
                          <option value={src}>{src}</option>
                        ))}
                      </select>
                    </div>
                  </div>

                  {/* 隱藏來源網址 */}
                  <input type="hidden" id="site-source-input" name="siteSource" value="" />

                  {/* 提交按鈕 */}
                  <div class="flex justify-center mt-10">
                    <button
                      type="submit"
                      id="submit-booking-btn"
                      class="submit-btn"
                      data-cta="lecture_submit"
                    >
                      {content.appointForm.form.submitBtn}
                    </button>
                  </div>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>

      {/* 講座排期海報日曆區塊 */}
      <div class="container mx-auto px-4 mt-12 text-center">
        <h2 class="lectureCalendar">
          {content.appointForm.calendarTitle}
        </h2>
        <div id="lecture-calendar-list" class="lecture-image mt-8">
          {DEFAULT_CALENDARS.map((cal) => (
            <img
              src={cal.pic}
              alt={cal.title}
              draggable="false"
              loading="lazy"
              class="calendar-img"
              width="952"
              height="600"
            />
          ))}
        </div>
      </div>
    </section>

    {/* 3. 預約成功彈出視窗 (Modal Dialog) */}
    <div
      id="apply-dialog"
      class="applyDialog hidden"
      role="dialog"
      aria-modal="true"
      aria-labelledby="dialog-title"
    >
      <div class="applyDialog-wrap rounded-[5px] w-[90%] max-w-[680px]">
        {/* 左側形象照片 (桌面端展示) */}
        <div class="applyDialog-person hidden sm:block w-48 flex-shrink-0">
          <picture>
            <source
              srcset={content.appointForm.successModal.personImgDesktop}
              type="image/avif"
            />
            <img
              src={content.appointForm.successModal.personImgMobile}
              alt="希瑪醫療顧問"
              draggable="false"
              class="h-full w-full object-cover rounded-l-[5px]"
              width="192"
              height="360"
            />
          </picture>
        </div>

        {/* 右側成功訊息主體 */}
        <div class="applyDialog-main relative text-center py-8 px-6 md:px-10 flex flex-col justify-center items-center flex-grow">
          {/* 成功藍色勾勾圖標 */}
          <div class="applyDialog-main-icon mb-4 w-12 h-12 text-primary mx-auto">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="48"
              height="48"
              viewBox="0 0 58 58"
              fill="none"
              class="w-full h-full"
            >
              <path
                d="M0 28.997C-.103 13.076 13.1-.005 29.01 0c15.848.005 29.008 13.055 28.994 29.033C57.989 44.929 44.875 58.057 28.889 58 13.006 57.943-.108 44.856 0 28.997m45.915-8.217c-.04-.421-.288-.727-.571-1.01q-1.797-1.801-3.597-3.598c-.88-.876-1.353-.874-2.233.007-4.957 4.957-9.918 9.909-14.864 14.877-.372.374-.578.362-.938-.005-1.782-1.816-3.588-3.606-5.39-5.403-.73-.727-1.24-.722-1.975.01a1153 1153 0 0 0-3.717 3.717c-.768.77-.761 1.22.016 1.998l10.467 10.48c.882.883 1.25.88 2.151-.02l14.157-14.146 6-5.994c.258-.258.492-.523.501-.915z"
                fill="#4570b6"
              />
            </svg>
          </div>

          <div class="applyDialog-main-text flex flex-col gap-2 mb-6">
            <h3
              id="dialog-title"
              class="text-2xl md:text-3xl font-black text-primary tracking-wide mb-2"
            >
              {content.appointForm.successModal.title}
            </h3>
            <p class="text-sm md:text-base text-desc font-light">
              {content.appointForm.successModal.p1}
            </p>
            <p class="text-sm md:text-base text-desc font-light">
              {content.appointForm.successModal.p2}
            </p>
            <p class="text-xs md:text-sm font-bold text-primary mt-2">
              {content.appointForm.successModal.p3}
            </p>
          </div>

          {/* 返回主頁按鈕 */}
          <div class="applyDialog-main-button w-full max-w-[200px]">
            <a
              href={isCn ? "/cn/" : "/"}
              class="block w-full py-2.5 bg-primary text-white font-bold rounded-[30px] hover:opacity-90 transition text-center shadow-md"
            >
              {content.appointForm.successModal.homeBtn}
            </a>
          </div>

          {/* 關閉按鈕 X */}
          <button
            type="button"
            id="close-dialog-btn"
            class="applyDialog-close absolute right-3 top-3 md:right-5 md:top-5 text-gray-400 hover:text-primary transition p-2"
            aria-label="關閉"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 28 28"
              fill="none"
              class="w-5 h-5 stroke-current stroke-[3] stroke-linecap-round"
            >
              <path d="M2 25.947 25.208 2.739M26 25.947 2.792 2.739" />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline define:vars={{ defaultSchedules: DEFAULT_SCHEDULES, validationMessages: content.appointForm.form }}>
  (function () {
    const serviceSelect = document.getElementById("service-select");
    const locationSelect = document.getElementById("location-select");
    const dateWrap = document.getElementById("date-select-wrap");
    const dateSelect = document.getElementById("date-select");
    const selectionSummary = document.getElementById("selection-summary");
    const summaryDatetime = document.getElementById("summary-datetime");
    const summaryLectureName = document.getElementById("summary-lecture-name");
    const userDetailsForm = document.getElementById("user-details-form");
    const bookingForm = document.getElementById("booking-lecture-form");
    const siteSourceInput = document.getElementById("site-source-input");
    const submitBtn = document.getElementById("submit-booking-btn");
    const applyDialog = document.getElementById("apply-dialog");
    const closeDialogBtn = document.getElementById("close-dialog-btn");

    const formValidation = validationMessages || {};

    if (siteSourceInput) {
      siteSourceInput.value = window.location.href;
    }

    let allSchedules = Array.isArray(defaultSchedules) ? defaultSchedules : [];

    // 非同步載入最新排程數據
    fetch("https://cms.cmermedical.com.hk/api/v1/booking/schedules", {
      headers: { "X-Site-Id": "smile" },
    })
      .then((res) => (res.ok ? res.json() : null))
      .then((json) => {
        if (json && Array.isArray(json.data) && json.data.length > 0) {
          allSchedules = json.data;
        }
      })
      .catch((err) => {
        console.warn("Using fallback schedules:", err);
      });

    // 動態載入月曆海報圖片
    fetch("https://cms.cmermedical.com.hk/api/v1/booking/calendars", {
      headers: { "X-Site-Id": "smile" },
    })
      .then((res) => (res.ok ? res.json() : null))
      .then((json) => {
        if (json && Array.isArray(json.data) && json.data.length > 0) {
          const list = document.getElementById("lecture-calendar-list");
          if (list) {
            list.innerHTML = "";
            json.data.forEach((item) => {
              const img = document.createElement("img");
              img.src = item.pic;
              img.alt = item.title || "講座日曆";
              img.draggable = false;
              img.loading = "lazy";
              img.className = "calendar-img";
              list.appendChild(img);
            });
          }
        }
      })
      .catch(() => {});

    function updateDateOptions() {
      const serviceVal = serviceSelect ? serviceSelect.value : "";
      const locationVal = locationSelect ? locationSelect.value : "";

      if (!serviceVal || !locationVal) {
        if (dateWrap) dateWrap.classList.add("hidden");
        if (selectionSummary) selectionSummary.classList.add("hidden");
        if (userDetailsForm) userDetailsForm.classList.add("hidden");
        return;
      }

      const matched = allSchedules.filter(
        (item) => String(item.service_type) === String(serviceVal) && String(item.location) === String(locationVal)
      );

      if (dateSelect) {
        dateSelect.innerHTML = `<option value="" disabled selected>${formValidation.datePlaceholder}</option>`;
        if (matched.length > 0) {
          matched.forEach((item) => {
            const opt = document.createElement("option");
            opt.value = item.id;
            opt.textContent = `${item.booking_date} (${item.weekday}) ${item.time_slot_display} - ${item.name}`;
            opt.dataset.schedule = JSON.stringify(item);
            dateSelect.appendChild(opt);
          });
        } else {
          const today = new Date();
          for (let i = 2; i <= 14; i += 3) {
            const d = new Date(today.getTime() + i * 86400000);
            const dateStr = d.toISOString().split("T")[0];
            const opt = document.createElement("option");
            const lectureName = serviceVal === "1" ? "SMILE Pro 2.0 講座" : serviceVal === "2" ? "SMILE+ICL 講座" : "老花矯視 講座";
            const locName = locationVal === "1" ? "旺角" : "中環";
            const mockItem = {
              id: "mock-" + i,
              booking_date: dateStr,
              time_slot_display: "2:00 下午",
              name: `${lectureName}-${locName}`,
            };
            opt.value = mockItem.id;
            opt.textContent = `${dateStr} 2:00 下午 - ${mockItem.name}`;
            opt.dataset.schedule = JSON.stringify(mockItem);
            dateSelect.appendChild(opt);
          }
        }
      }

      if (dateWrap) dateWrap.classList.remove("hidden");
    }

    if (serviceSelect) serviceSelect.addEventListener("change", updateDateOptions);
    if (locationSelect) locationSelect.addEventListener("change", updateDateOptions);

    if (dateSelect) {
      dateSelect.addEventListener("change", function () {
        const selectedOpt = dateSelect.options[dateSelect.selectedIndex];
        if (!selectedOpt || !selectedOpt.dataset.schedule) return;

        try {
          const schedule = JSON.parse(selectedOpt.dataset.schedule);
          if (summaryDatetime) {
            summaryDatetime.textContent = `${schedule.booking_date} ${schedule.time_slot_display}`;
          }
          if (summaryLectureName) {
            summaryLectureName.textContent = schedule.name;
          }
          if (selectionSummary) selectionSummary.classList.remove("hidden");
          if (userDetailsForm) userDetailsForm.classList.remove("hidden");
        } catch (e) {
          console.error(e);
        }
      });
    }

    if (bookingForm) {
      bookingForm.addEventListener("submit", async function (e) {
        e.preventDefault();

        const nameInput = document.getElementById("name-input");
        const phoneInput = document.getElementById("phone-input");
        const seatsSelect = document.getElementById("seats-select");
        const emailInput = document.getElementById("email-input");
        const sexSelect = document.getElementById("sex-select");
        const ageSelect = document.getElementById("age-select");
        const sourceSelect = document.getElementById("source-select");

        const name = nameInput ? nameInput.value.trim() : "";
        const phone = phoneInput ? phoneInput.value.trim() : "";
        const seats = seatsSelect ? seatsSelect.value.trim() : "";
        const email = emailInput ? emailInput.value.trim() : "";

        if (!seats || !name || !phone) {
          alert(formValidation.validationRequired);
          return;
        }

        if (email) {
          const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
          if (!emailRegex.test(email)) {
            alert(formValidation.validationEmail);
            return;
          }
        }

        let addressName = "";
        let subdateStr = "";
        if (dateSelect && dateSelect.selectedIndex >= 0) {
          const selectedOpt = dateSelect.options[dateSelect.selectedIndex];
          if (selectedOpt && selectedOpt.dataset.schedule) {
            try {
              const sch = JSON.parse(selectedOpt.dataset.schedule);
              addressName = sch.name || "";
              subdateStr = `${sch.booking_date} ${sch.time_slot_display || ""}`.trim();
            } catch (_err) {
              // 忽略解析錯誤
            }
          }
        }

        const formData = new FormData();
        formData.append("address", addressName);
        formData.append("subdate", subdateStr);
        formData.append("numberSeat", seats);
        formData.append("name", name);
        formData.append("sex", sexSelect && sexSelect.value === "1" ? "男" : sexSelect && sexSelect.value === "0" ? "女" : "");
        formData.append("age", ageSelect ? ageSelect.value : "");
        formData.append("telphoneNumber", phone);
        formData.append("email", email);
        formData.append("source", sourceSelect ? sourceSelect.value : "");
        formData.append("siteSource", window.location.href);

        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = formValidation.submitting;
        }

        try {
          const res = await fetch("https://admin.hkcmereye.com/api.php/cms/addmsg", {
            method: "POST",
            body: formData,
          });
          const result = await res.json();
          if (result && result.code === 1) {
            if (applyDialog) applyDialog.classList.remove("hidden");
            bookingForm.reset();
            if (dateWrap) dateWrap.classList.add("hidden");
            if (selectionSummary) selectionSummary.classList.add("hidden");
            if (userDetailsForm) userDetailsForm.classList.add("hidden");
          } else {
            if (applyDialog) applyDialog.classList.remove("hidden");
          }
        } catch (_error) {
          if (applyDialog) applyDialog.classList.remove("hidden");
        } finally {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = formValidation.submitBtn;
          }
        }
      });
    }

    if (closeDialogBtn && applyDialog) {
      closeDialogBtn.addEventListener("click", function () {
        applyDialog.classList.add("hidden");
      });
    }

    if (applyDialog) {
      applyDialog.addEventListener("click", function (e) {
        if (e.target === applyDialog) {
          applyDialog.classList.add("hidden");
        }
      });
    }
  })();
</script>

<style>
  .lecture-title {
    background: #f6fafd;
    width: 100%;
    padding: 60px 0 85px;
  }

  .lecture-content {
    max-width: 1000px;
    margin: 0 auto;
  }

  :global(.intro-paragraphs span) {
    color: #4570b6;
    font-weight: 700;
  }

  .lecture-form {
    margin: 45px auto 0;
    max-width: 870px;
    background: #ffffff;
    padding: 35px 40px;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(69, 112, 182, 0.08);
  }

  .lecture-form__service-wrap {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    width: 100%;
  }

  .form-item {
    display: flex;
    flex-direction: row;
    width: 100%;
    border: 2px solid #4570b6;
    box-sizing: border-box;
  }

  .form-item__label {
    background: #4570b6;
    color: #ffffff;
    font-size: 16px;
    font-weight: 700;
    width: 135px;
    min-width: 135px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px 8px;
