---
/*
 * @Author: Antigravity AI
 * @Date: 2026-11-10
 * @FilePath: /src/pages/[...lang]/vision-correction-icl.astro
 * @Description: ICL 植入式隱形眼鏡專頁 (100% 官方真值對齊 + 雙端響應式 + W-13 轉換追蹤 + 完整 Schema)
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import SchemaProcedure from "@/components/seo/SchemaProcedure.astro";
import SchemaBreadcrumb from "@/components/seo/SchemaBreadcrumb.astro";
import UserShare from "@/components/views/UserShare.astro";
import VideoFacade from "@/components/common/VideoFacade.astro";
import { i18nPaths, getLangFromUrl, getLocalizedHref } from "@/i18n/utils";
import {
  VISION_CORRECTION_ICL_ZH_HK,
  VISION_CORRECTION_ICL_ZH_CN,
  ICL_SHARE_DATA,
} from "@/data/visionCorrectionIclData";
import "@/styles/icl.scss";

export function getStaticPaths() {
  return [...i18nPaths];
}

const lang = getLangFromUrl(Astro.url);
const isCn = lang === "zh-cn";
const content = isCn ? VISION_CORRECTION_ICL_ZH_CN : VISION_CORRECTION_ICL_ZH_HK;
const feeUrl = getLocalizedHref("/fee#table1", lang);
---

<BaseLayout tdkKey="icl">
  <SchemaProcedure
    name={content.banner.title}
    description={content.center.p1.text1 +
      content.center.p1.text2 +
      content.center.p2.span1 +
      content.center.p2.text2 +
      content.center.p2.span2 +
      content.center.p2.text3}
  />
  <SchemaBreadcrumb
    items={[
      { name: content.breadcrumb.home, url: isCn ? "/cn/" : "/" },
      {
        name: content.breadcrumb.service,
        url: isCn ? "/cn/vision-correction-icl" : "/vision-correction-icl",
      },
      {
        name: content.breadcrumb.current,
        url: isCn ? "/cn/vision-correction-icl" : "/vision-correction-icl",
      },
    ]}
  />

  <div class="page-icl font-hk text-desc relative overflow-x-clip">
    {/* 1. 頂部主橫幅 Hero Banner */}
    <div class="site-container smile-NewBanner position-relative">
      <img draggable="false"
        class="banner-lens-img"
        decoding="async"
        src={content.banner.imgPc}
        alt="ICL 植入式隱形眼鏡 - 香港希瑪微笑矯視中心"
        title="ICL 植入式隱形眼鏡 - 香港希瑪微笑矯視中心"
        loading="eager"
        fetchpriority="high"
        width="685"
        height="563"
        srcset={`${content.banner.imgMb} 400w, ${content.banner.imgMb} 640w, ${content.banner.imgPc}`}
        sizes="(max-width: 992px) 100vw, 1216px"
      />
      <div class="smile-NewBanner-Title">
        <span>{content.banner.tag}</span>
        <h1 class="icl-h1">{content.banner.title}</h1>
        <p>{content.banner.subtitle}</p>
      </div>
      <div class="smile-NewBanner-Tip">
        <div class="smile-NewBanner-Tip-Title">
          <p>{content.banner.tipTitle}</p>
        </div>
        <div class="smile-NewBanner-Tip-Content">
          {content.banner.tipItems.map((tip) => <p>{tip}</p>)}
        </div>
      </div>
    </div>

    {/* 2. 中心介紹與麵包屑導航 */}
    <section class="smile-newCenter" aria-labelledby="center-intro-title">
      <div class="site-container">
        <nav class="smile-newCenter-menu" aria-label="麵包屑導航">
          <a href={isCn ? "/cn/" : "/"} title={content.breadcrumb.home}>{content.breadcrumb.home}</a>&nbsp;&gt;&nbsp;<span class="text-text">{content.breadcrumb.service}</span>&nbsp;&gt;&nbsp;<a href={isCn ? "/cn/vision-correction-icl" : "/vision-correction-icl"} title={content.breadcrumb.current}>{content.breadcrumb.current}</a>
        </nav>
      </div>
      <div class="w-full smile-newCenter-content">
        <div class="site-container smile-newCenter-content-text">
          <h2 id="center-intro-title" class="text-center d-xl-none">
            {content.center.title}
          </h2>
          <div class="smile-newCenter-content-text-p">
            <h2 class="text-center d-none d-xl-block">
              {content.center.title}
            </h2>
            <p>
              {content.center.p1.text1}<span>{content.center.p1.text2}</span>。
            </p>
            <p>
              <i>{content.center.p2.italic1}</i><span>{content.center.p2.span1}</span>{content.center.p2.text2}<i>{content.center.p2.italic2}</i><span>{content.center.p2.span2}</span>{content.center.p2.text3}
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* 3. 為何選擇希瑪 */}
    <section class="icl-WhatChoose" aria-labelledby="why-choose-title">
      <h2 id="why-choose-title" class="icl-WhatChoose-title">
        {content.whyChoose.title}
      </h2>
      <div class="icl-WhatChoose-content-one site-container">
        <div class="icl-WhatChoose-content-one-img">
          <img draggable="false"
            decoding="async"
            src={content.whyChoose.imgPc}
            alt="為何選擇希瑪 - 官方認證EVO ICL國際培訓中心"
            title="為何選擇希瑪 - 官方認證EVO ICL國際培訓中心"
            loading="lazy"
            width="595"
            height="384"
            srcset={`${content.whyChoose.imgMb} 400w, ${content.whyChoose.imgMb} 640w, ${content.whyChoose.imgPc}`}
            sizes="(max-width: 992px) 100vw, 1216px"
          />
        </div>
        <div class="icl-WhatChoose-content-one-text">
          <p>
            <Fragment set:html={content.whyChoose.one.text1} /><span>{content.whyChoose.one.text2}</span><Fragment set:html={content.whyChoose.one.text3} /><span>{content.whyChoose.one.text4}</span>{content.whyChoose.one.text5}<span><Fragment set:html={content.whyChoose.one.text6} /></span>{content.whyChoose.one.text7}
          </p>
          <p>
            {content.whyChoose.one.text8}
          </p>
        </div>
      </div>
      <div class="icl-WhatChoose-content-two site-container">
        {content.whyChoose.features.map((feat) => (
          <div>
            <div class="flex items-center icl-WhatChoose-content-two-title">
              <h3>{feat.title}</h3>
              <span class="span-new">{feat.badge}</span>
            </div>
            <div class="text">
              <p>{feat.desc}</p>
            </div>
          </div>
        ))}
      </div>
      <a
        target="_blank"
        rel="noopener noreferrer"
        href={content.whyChoose.whatsappUrl}
        class="mx-auto icl-btn cta-pulse"
        data-cta="whatsapp"
        title={content.whyChoose.btn}
        aria-label="預約諮詢 (W-13)"
      >
        <span>{content.whyChoose.btn}</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="17"
          height="17"
          viewBox="0 0 17 17"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M2 14.5399L14.5714 1.96851"
            stroke="white"
            stroke-width="3"
            stroke-linecap="round"
          />
          <path
            d="M3.83179 1.5686H14.9999V12.3686"
            stroke="white"
            stroke-width="2.7"
            stroke-linecap="round"
          />
        </svg>
      </a>
    </section>

    {/* 4. ICL植入式隱形眼鏡費用 */}
    <div class="bg-[#F6FAFD] py-8 px-2 md:px-0 md:pb-32 md:pt-24 mb-9 md:mb-[72px]">
      <div class="w-full flex flex-col items-center mx-auto">
        <h2 class="text-[#4A74B8] text-xl md:text-3xl font-black mb-[40px] md:mb-10 tracking-wider text-center">
          {content.fee.title}
        </h2>
        <div class="w-full">
          <div class="site-container space-y-2 md:space-y-4">
            {content.fee.cards.map((card) => (
              <div class="bg-white border border-[#4570B6] rounded-2xl p-5 md:p-8 flex flex-row justify-between items-center transition-all group">
                <div class="text-[#6D6E71] text-base md:text-3xl font-bold">
                  {card.title}
                </div>
                <div class="text-[#F59E0B] -ml-[60px] sm:ml-0 flex-1 font-bold tracking-tight text-right group-hover:scale-105 transition-transform">
                  <span class="text-2xl md:text-5xl">{card.currency}</span>
                  <span class="text-lg min-[360px]:text-2xl md:text-6xl md:pb-2">
                    {card.price}
                  </span>
                  {card.extra && (
                    <p class="text-xs min-[360px]:text-sm md:text-xl">{card.extra}</p>
                  )}
                </div>
              </div>
            ))}
          </div>
          <div class="mt-8 md:mt-12 flex flex-col items-center">
            <a
              href={feeUrl}
              title={content.fee.btn}
              class="md:w-auto bg-[#4570B6] text-white px-10 py-4 md:py-5 md:px-[100px] rounded-full text-2xl md:text-4xl font-bold flex items-center justify-center gap-3 transition-colors hover:bg-[#345996] cta-pulse"
              data-cta="fee"
            >
              {content.fee.btn}
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-[13px] w-[13px] md:h-[26px] md:w-[26px]"
                viewBox="0 0 34 34"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M3.18018 30.3632L29.8334 3.70996"
                  stroke="white"
                  stroke-width="6.36042"
                  stroke-linecap="round"
                />
                <path
                  d="M7.06396 2.8623H30.742V25.7598"
                  stroke="white"
                  stroke-width="5.72438"
                  stroke-linecap="round"
                />
              </svg>
            </a>
            <div class="text-text mt-2 md:mt-4 text-center font-light text-base md:text-2xl leading-relaxed">
              {content.fee.notes.map((note) => <p>{note}</p>)}
            </div>
          </div>
        </div>
      </div>
    </div>

    {/* 5. EVO ICL 產品系列介紹 — V4C｜V5｜V6 型號比較 */}
    <div class="icl-model mb-9 lg:mb-20 site-container">
      <h2 class="model-title mb-6 lg:mb-10 text-center">
        {content.modelComparison.titlePrefix} <span class="hidden md:inline"> — </span><br class="block md:hidden" />{content.modelComparison.titleSuffix}
      </h2>
      <div class="model-main">
        <table class="model-table w-full text-center">
          <thead>
            <tr>
              <th class="table-item line-bottom line-project">{content.modelComparison.project}</th>
              <th class="project-name line-bottom line-project">{content.modelComparison.cols[0]}</th>
              <th class="project-name line-bottom line-project">{content.modelComparison.cols[1]}</th>
              <th class="project-name line-bottom">{content.modelComparison.cols[2]}</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th class="table-item line-bottom line-project">{content.modelComparison.range.title}</th>
              <td class="line-bottom line-right model-star">
                {content.modelComparison.range.v4c.prefix}<br class="md:hidden" />
                <strong class="text-[#F89B03] font-bold">{content.modelComparison.range.v4c.strong1}</strong>
                <strong class="text-[#F89B03] font-bold">{content.modelComparison.range.v4c.strong2}</strong>
                {content.modelComparison.range.v4c.mid}<br />
                {content.modelComparison.range.v4c.suffix}
              </td>
              <td class="line-bottom line-right">
                {content.modelComparison.range.v5}
              </td>
              <td class="line-bottom">
                {content.modelComparison.range.v6.p1}<br />
                {content.modelComparison.range.v6.p2}
              </td>
            </tr>
            <tr>
              <th class="table-item line-bottom line-project">{content.modelComparison.tech.title}</th>
              <td class="line-bottom line-right">{content.modelComparison.tech.v4c}</td>
              <td class="line-bottom line-right">{content.modelComparison.tech.v5}</td>
              <td class="line-bottom model-star text-[#F89B03] font-bold">{content.modelComparison.tech.v6}</td>
            </tr>
            <tr>
              <th class="table-item line-bottom line-project">{content.modelComparison.materials.title}</th>
              <td class="line-bottom line-right">{content.modelComparison.materials.v4c}</td>
              <td colspan="2" class="line-bottom">{content.modelComparison.materials.intro}</td>
            </tr>
            <tr>
              <th class="table-item line-bottom line-project">{content.modelComparison.audience.title}</th>
              <td class="line-bottom line-right">{content.modelComparison.audience.v4c}</td>
              <td class="line-bottom line-right">{content.modelComparison.audience.v5}</td>
              <td class="line-bottom">
                {content.modelComparison.audience.v6.p1}<br />
                {content.modelComparison.audience.v6.p2}
              </td>
            </tr>
            <tr>
              <th class="table-item line-bottom line-project">{content.modelComparison.night.title}</th>
              <td class="line-bottom line-right">{content.modelComparison.night.v4c}</td>
              <td colspan="2" class="line-bottom">{content.modelComparison.night.intro}</td>
            </tr>
            <tr>
              <th class="table-item line-project">{content.modelComparison.reversibility.title}</th>
              <td colspan="3">{content.modelComparison.reversibility.intro}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    {/* 6. ICL矯視的好處 */}
    <section class="icl-Good" aria-labelledby="icl-good-title">
      <h2 id="icl-good-title" class="new-pubile-title">
        <span>{content.good.tag}</span>{content.good.title}
      </h2>
      <div class="icl-Good-List">
        {content.good.items.map((item) => (
          <div class="icl-Good-List-item">
            <div class="lg:size-20 flex justify-center items-center">
              <img decoding="async" draggable="false" src={item.icon} alt={item.title} title={item.title} loading="lazy" width="60" height="60" />
            </div>
            <h3>{item.title}</h3>
            <div>
              {item.text.map((t) => <p>{t}</p>)}
            </div>
          </div>
        ))}
      </div>
    </section>

    {/* 7. EVO Visian ICL鏡片7大特色 (Master-Detail Redesign) */}
    <section class="icl-peculiarity" aria-labelledby="icl-peculiarity-title" id="iclFeatureSection">
      <h2 id="icl-peculiarity-title" class="new-pubile-title">
        <span>{content.peculiarity.tag}</span>{content.peculiarity.title}
      </h2>
      <div class="icl-peculiarity-container site-container">
        <p class="icl-peculiarity-text">
          {content.peculiarity.desc}
        </p>

        <div class="icl-feature-master-detail">
          {/* Left Rail (Desktop) / Horizontal Chips (Mobile) */}
          <div class="icl-feature-nav" role="tablist" aria-label="EVO Visian ICL 7大特色">
            {content.peculiarity.items.map((item, idx) => (
              <button
                type="button"
                role="tab"
                id={`icl-feature-tab-${idx}`}
                class:list={["icl-feature-tab", { active: idx === 0 }]}
                aria-selected={idx === 0 ? "true" : "false"}
                aria-controls={`icl-feature-panel-${idx}`}
                data-feature-index={idx}
              >
                <span class="icl-feature-tab-num">{item.footerNum.slice(-2)}</span>
                <span class="icl-feature-tab-title">{item.title}</span>
              </button>
            ))}
          </div>

          {/* Right Detail Panel */}
          <div class="icl-feature-panels" id="iclFeaturePanels">
            {content.peculiarity.items.map((item, idx) => (
              <div
                class:list={["icl-feature-panel", { active: idx === 0 }]}
                id={`icl-feature-panel-${idx}`}
                role="tabpanel"
                aria-labelledby={`icl-feature-tab-${idx}`}
                hidden={idx !== 0}
              >
                <div class="icl-feature-panel-card">
                  <div class="icl-feature-panel-icon-wrap">
                    <img
                      decoding="async"
                      draggable="false"
                      src={item.boxImg}
                      alt={item.title}
                      title={item.title}
                      loading="lazy"
                      width="120"
                      height="120"
                    />
                  </div>
                  <div class="icl-feature-panel-info">
                    <div class="icl-feature-panel-meta">
                      <span class="icl-tag-badge">{item.tag}</span>
                      <span class="icl-feature-panel-marker">feature {item.footerNum}</span>
                    </div>
                    <h3 class="icl-feature-panel-title">
                      {item.boxTitleText.join("") || item.title}
                    </h3>
                    <div class="icl-feature-panel-desc">
                      {item.boxDes.map((d) => <p>{d}</p>)}
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* 8. 過程與介紹影片 */}
    <section class="icl-introVedio overflow-hidden" aria-labelledby="icl-intro-title">
      <div class="icl-introVedio-intro site-container">
        <div class="icl-introVedio-intro-number">
          {/* 左側數字列表 */}
          <div class="steps" id="iclStepButtons">
            {content.steps.list.map((step, idx) => (
              <button
                type="button"
                class:list={["step-btn", { active: idx === 0 }]}
                data-step-index={idx}
                aria-label={`步驟 ${step.number}`}
              >
                {step.number}
              </button>
            ))}
          </div>
          {/* 右側內容區域 */}
          <div class="content-area">
            <div class="content-panel">
              <div class="content-area-title">
                <h2 id="icl-intro-title" class="m-0 p-0 text-inherit font-inherit">
                  {content.steps.titlePrefix}<br />
                  {content.steps.titleSuffix}
                </h2>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="19"
                  height="20"
                  viewBox="0 0 19 20"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="M0.726577 1.2312L17.593 18.0976"
                    stroke="#4570B6"
                    stroke-width="1.34165"
                    stroke-linecap="round"
                  />
                  <path
                    d="M18.1296 3.68896L18.1296 18.6727L3.63983 18.6727"
                    stroke="#4570B6"
                    stroke-width="1.34165"
                    stroke-linecap="round"
                  />
                </svg>
              </div>
              <div class="content-area-img">
                <img decoding="async" draggable="false"
                  id="iclStepImgMb"
                  class="d-xl-none"
                  src={content.steps.list[0].image}
                  alt="ICL 手術過程"
                  title="ICL 手術過程"
                  loading="lazy"
                  width="300"
                  height="200"
                />
                <img decoding="async" draggable="false"
                  id="iclStepImgPc"
                  class="d-none d-xl-block"
                  src={content.steps.list[0].imagePc}
                  alt="ICL 手術過程"
                  title="ICL 手術過程"
                  loading="lazy"
                  width="540"
                  height="360"
                />
                <p id="iclStepText" class="content-area-text">
                  {content.steps.list[0].text}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="icl-introVedio-vedio">
        <div class="site-container">
          <h2 class="new-pubile-title">
            <span>{content.videos.tag} </span>{content.videos.title}
          </h2>
          <div class="icl-introVedio-vedio-list">
            {content.videos.list.map((vid) => (
              <div>
                <VideoFacade
                  videoId={vid.src}
                  title={vid.title}
                />
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* 9. 合適對象 */}
    <div class="SuitableObject">
      {content.suitable.items.map((item, idx) => (
        <div class="SuitableObject-item" data-number={idx + 1}>
          <div class="SuitableObject-description">
            {item.desc.map((d) => <p>{d}</p>)}
          </div>
          <img decoding="async" draggable="false" class="SuitableObject-image" src={item.image} alt={item.desc.join('')} title={item.desc.join('')} loading="lazy" width="220" height="220" />
        </div>
      ))}
      <div class="SuitableObject-speical">
        <span>合適<br />對象</span>
      </div>
    </div>

    {/* 10. 全面術前眼睛檢查項目 */}
    <section class="icl-CheckObject" aria-labelledby="icl-check-title">
      <div class="CheckObject site-container">
        <h2 id="icl-check-title">
          {content.check.title}<span class="d-xl-none">{content.check.sub}</span>
          <p class="d-none d-xl-block"><br />{content.check.sub}</p>
        </h2>
        <ul>
          {content.check.items.map((item) => (
            <li>
              <span class="CheckObject-number">{item.number}</span>
              <span class="CheckObject-description">{item.desc}</span>
              {item.isNew && <span class="CheckObject-new">NEW!</span>}
            </li>
          ))}
        </ul>
      </div>
      <a
        target="_blank"
        rel="noopener noreferrer"
        href={content.check.whatsappUrl}
        class="mx-auto icl-btn cta-pulse"
        data-cta="whatsapp"
        aria-label="預約諮詢 (W-13)"
        title={content.check.btn}
      >
        <span>{content.check.btn}</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="17"
          height="17"
          viewBox="0 0 17 17"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M2 14.5399L14.5714 1.96851"
            stroke="white"
            stroke-width="3"
            stroke-linecap="round"
          />
          <path
            d="M3.83179 1.5686H14.9999V12.3686"
            stroke="white"
            stroke-width="2.7"
            stroke-linecap="round"
          />
        </svg>
      </a>
    </section>

    {/* 11. 用家分享 */}
    <UserShare
      title={content.shareTitle}
      items={ICL_SHARE_DATA}
      id="iclUserShareList"
      sectionId="section-icl-share"
    />

    {/* 12. 最新動態 */}
    <section class="latestNews" aria-labelledby="latest-news-title">
      <div class="latestNews-tip">{content.latestNews.badge}</div>
      <div class="latestNews-in">
        <h2 id="latest-news-title" class="latestNews-title">
          <i>{content.latestNews.i}</i> <span>{content.latestNews.span}</span> {content.latestNews.title}
        </h2>
        <p>
          {content.latestNews.desc}
        </p>
      </div>
      <a href={getLocalizedHref(content.latestNews.href, lang)} class="latestNews-btn cta-pulse" title={content.latestNews.btn}>
        <svg
