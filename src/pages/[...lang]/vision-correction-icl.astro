<script is:inline define:vars={{ stepsData: content.steps.list }}>
  function initIclPage() {
    let activeStep = 0;
    let timer = null;
    const stepBtns = document.querySelectorAll("#iclStepButtons .step-btn");
    const stepImgMb = document.getElementById("iclStepImgMb");
    const stepImgPc = document.getElementById("iclStepImgPc");
    const stepText = document.getElementById("iclStepText");
    const stepsContainer = document.querySelector(".icl-introVedio-intro");

    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    function setStep(idx) {
      if (idx < 0 || idx >= stepsData.length) return;
      activeStep = idx;
      stepBtns.forEach((btn, i) => {
        btn.classList.toggle("active", i === activeStep);
      });
      const data = stepsData[activeStep];
      if (!data) return;

      if (prefersReducedMotion) {
        if (stepImgMb) {
          stepImgMb.src = data.image;
          stepImgMb.title = data.text;
        }
        if (stepImgPc) {
          stepImgPc.src = data.imagePc;
          stepImgPc.title = data.text;
        }
        if (stepText) stepText.textContent = data.text;
        return;
      }

      // Fade on content change (opacity transition 250ms)
      [stepImgMb, stepImgPc, stepText].forEach((el) => {
        if (el) el.style.opacity = "0";
      });

      setTimeout(() => {
        if (stepImgMb) {
          stepImgMb.src = data.image;
          stepImgMb.title = data.text;
        }
        if (stepImgPc) {
          stepImgPc.src = data.imagePc;
          stepImgPc.title = data.text;
        }
        if (stepText) stepText.textContent = data.text;

        [stepImgMb, stepImgPc, stepText].forEach((el) => {
          if (el) el.style.opacity = "1";
        });
      }, 120);
    }

    function startTimer() {
      if (prefersReducedMotion) return;
      stopTimer();
      timer = setInterval(() => {
        activeStep = (activeStep + 1) % stepsData.length;
        setStep(activeStep);
      }, 3000);
    }

    function stopTimer() {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    }

    stepBtns.forEach((btn, idx) => {
      btn.addEventListener("click", () => {
        setStep(idx);
      });
      btn.addEventListener("mouseenter", () => {
        setStep(idx);
      });
    });

    if (stepsContainer) {
      stepsContainer.addEventListener("mouseenter", stopTimer);
      stepsContainer.addEventListener("mouseleave", startTimer);
      stepsContainer.addEventListener("focusin", stopTimer);
      stepsContainer.addEventListener("focusout", startTimer);
    }

    if (!prefersReducedMotion) {
      startTimer();
    }

    // I19. 7大特色 Master-Detail Controller
    const featureTabs = document.querySelectorAll(".icl-feature-tab");
    const featurePanels = document.querySelectorAll(".icl-feature-panel");
    const featureContainer = document.getElementById("iclFeatureSection");
    let activeFeature = 0;
    let featureTimer = null;

    function setFeature(idx) {
      if (idx < 0 || idx >= featureTabs.length) return;
      activeFeature = idx;

      featureTabs.forEach((tab, i) => {
        const isActive = i === activeFeature;
        tab.classList.toggle("active", isActive);
        tab.setAttribute("aria-selected", String(isActive));
        if (isActive && window.innerWidth < 1024) {
          tab.scrollIntoView({ behavior: prefersReducedMotion ? "auto" : "smooth", block: "nearest", inline: "nearest" });
        }
      });

      featurePanels.forEach((panel, i) => {
        const isActive = i === activeFeature;
        panel.classList.toggle("active", isActive);
        panel.hidden = !isActive;
      });
    }

    function startFeatureTimer() {
      if (prefersReducedMotion) return;
      stopFeatureTimer();
      featureTimer = setInterval(() => {
        setFeature((activeFeature + 1) % featureTabs.length);
      }, 5000);
    }

    function stopFeatureTimer() {
      if (featureTimer) {
        clearInterval(featureTimer);
        featureTimer = null;
      }
    }

    featureTabs.forEach((tab, idx) => {
      tab.addEventListener("click", () => {
        setFeature(idx);
      });

      tab.addEventListener("keydown", (e) => {
        if (e.key === "ArrowRight" || e.key === "ArrowDown") {
          e.preventDefault();
          const next = (idx + 1) % featureTabs.length;
          featureTabs[next].focus();
          setFeature(next);
        } else if (e.key === "ArrowLeft" || e.key === "ArrowUp") {
          e.preventDefault();
          const prev = (idx - 1 + featureTabs.length) % featureTabs.length;
          featureTabs[prev].focus();
          setFeature(prev);
        }
      });
    });

    if (featureContainer) {
      featureContainer.addEventListener("mouseenter", stopFeatureTimer);
      featureContainer.addEventListener("mouseleave", startFeatureTimer);
      featureContainer.addEventListener("focusin", stopFeatureTimer);
      featureContainer.addEventListener("focusout", startFeatureTimer);
    }

    if (!prefersReducedMotion) {
      startFeatureTimer();
    }

    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("revealed");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.15 }
      );
      featureCards.forEach((card) => observer.observe(card));
    } else {
      featureCards.forEach((card) => card.classList.add("revealed"));
    }

    // 社交分享及複製鏈接
    const copyBtn = document.getElementById("copyCurrentUrlIcl");
    if (copyBtn) {
      copyBtn.addEventListener("click", async () => {
        try {
          if (navigator.clipboard && navigator.clipboard.writeText) {
            await navigator.clipboard.writeText(window.location.href);
          } else {
            const textArea = document.createElement("textarea");
            textArea.value = window.location.href;
            document.body.appendChild(textArea);
            textArea.select();
            document.execCommand("copy");
            document.body.removeChild(textArea);
          }
          alert("鏈接已複製到剪貼簿！");
        } catch (e) {
          console.error("複製失敗:", e);
        }
      });
    }

    const shareBtn = document.getElementById("shareCurrentPageIcl");
    if (shareBtn) {
      shareBtn.addEventListener("click", () => {
        if (navigator.share) {
          navigator.share({
            title: document.title,
            url: window.location.href,
          }).catch(() => {});
        } else {
          const url = encodeURIComponent(window.location.href);
          window.open(`https://api.whatsapp.com/send?text=${url}`, "_blank");
        }
      });
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initIclPage);
  } else {
    initIclPage();
  }
</script>
