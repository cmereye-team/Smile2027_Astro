---
/*
 * @Author: Antigravity AI
 * @Date: 2026-11-11
 * @FilePath: /src/pages/[...lang]/contact-us.astro
 * @Description: 聯絡我們專頁 (100% 線上官網逐字與版面還原 + 繁簡雙語 + 共享 .site-container + 結構化數據)
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import SchemaBreadcrumb from "@/components/seo/SchemaBreadcrumb.astro";
import { i18nPaths, getLangFromUrl } from "@/i18n/utils";
import {
  CONTACT_US_ZH_HK,
  CONTACT_US_ZH_CN,
} from "@/data/contactUsData";

export function getStaticPaths() {
  return [...i18nPaths];
}

const lang = getLangFromUrl(Astro.url);
const isCn = lang === "zh-cn";
const content = isCn ? CONTACT_US_ZH_CN : CONTACT_US_ZH_HK;

const breadcrumbItems = [
  { name: content.breadcrumb.home, url: isCn ? "/cn/" : "/" },
  {
    name: content.breadcrumb.current,
    url: isCn ? "/cn/contact-us" : "/contact-us",
  },
];

const initialMapSrc = content.maps.smileList[0]?.src ?? "";
---

<BaseLayout tdkKey="contact">
  <SchemaBreadcrumb items={breadcrumbItems} />

  <div class="contact-us">
    {/* 1. 頂部橫幅 Banner */}
    <section class="banner-section" aria-label={content.banner.title}>
      <div class="site-container banner-box">
        <div class="banner-img banner-text-default">
          <h1 class="banner-title">{content.banner.title}</h1>
          <p class="banner-subtitle">{content.banner.subtitle}</p>
        </div>
      </div>
    </section>

    {/* 2. 服務熱線表格 */}
