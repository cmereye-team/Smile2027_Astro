<script>
  function initContactUsMapTabs() {
    const iframe = document.getElementById(
      "contact-map-iframe"
    ) as HTMLIFrameElement | null;
    const smileTab = document.getElementById("clickable-item-center");
    const eyeTab = document.getElementById("clickable-item-eye");
    const smilePanel = document.querySelector<HTMLElement>(
      '[data-map-panel="smile"]'
    );
    const eyePanel = document.querySelector<HTMLElement>(
      '[data-map-panel="eye"]'
    );

    if (!iframe || !smileTab || !eyeTab || !smilePanel || !eyePanel) return;

    function selectClinicRow(panel: HTMLElement, targetIndex: number) {
      const rows = panel.querySelectorAll<HTMLButtonElement>(".maps-row");
      rows.forEach((btn, idx) => {
        const isSelected = idx === targetIndex;
        btn.classList.toggle("maps-paper-item", isSelected);
        btn.setAttribute("aria-pressed", String(isSelected));
        if (isSelected && btn.dataset.mapSrc && iframe) {
          iframe.src = btn.dataset.mapSrc;
        }
      });
    }

    function switchMode(mode: "smile" | "eye") {
      const isSmile = mode === "smile";
      smileTab?.classList.toggle("maps-title-active-left", isSmile);
      eyeTab?.classList.toggle("maps-title-active-right", !isSmile);
      smileTab?.setAttribute("aria-selected", String(isSmile));
      eyeTab?.setAttribute("aria-selected", String(!isSmile));

      if (smilePanel && eyePanel) {
        smilePanel.hidden = !isSmile;
        eyePanel.hidden = isSmile;
        selectClinicRow(isSmile ? smilePanel : eyePanel, 0);
      }
    }

    smileTab.addEventListener("click", () => switchMode("smile"));
    eyeTab.addEventListener("click", () => switchMode("eye"));

    [smilePanel, eyePanel].forEach((panel) => {
      panel.addEventListener("click", (event) => {
        const target = (event.target as HTMLElement | null)?.closest<HTMLButtonElement>(
          ".maps-row"
        );
        if (!target) return;
        const idx = Number(target.dataset.mapIndex ?? "0");
        selectClinicRow(panel, Number.isFinite(idx) ? idx : 0);
      });
    });
  }

  initContactUsMapTabs();
</script>

