    </section>

    {/* 3. 地圖與診所分店切換區 */}
    <section
      id="contact-us-maps"
      class="contact-us-maps site-container"
      aria-label={content.maps.iframeTitle}
    >
      <div class="maps-table">
        <iframe
          id="contact-map-iframe"
          title={content.maps.iframeTitle}
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          src={initialMapSrc}
        ></iframe>
      </div>

      <div class="maps-title" role="tablist" aria-label={content.maps.iframeTitle}>
        <button
          type="button"
          id="clickable-item-center"
          role="tab"
          aria-selected="true"
          aria-controls="maps-panel-smile"
          data-map-tab="smile"
          class="maps-tab-btn maps-title-active-left"
        >
          {content.maps.tabs.smile}
        </button>
        <button
          type="button"
          id="clickable-item-eye"
          role="tab"
          aria-selected="false"
          aria-controls="maps-panel-eye"
          data-map-tab="eye"
          class="maps-tab-btn"
        >
          {content.maps.tabs.eye}
        </button>
      </div>

