---
/*
 * @FilePath: /src/pages/[...lang]/flow-of-vision-correction.astro
 * @Description: 矯視流程專頁 (100% 對齊舊站 pages/flow-of-vision-correction/index.vue + 繁簡雙語 + 共享 .site-container + BreadcrumbList/Procedure Schema)
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import SchemaBreadcrumb from "@/components/seo/SchemaBreadcrumb.astro";
import SchemaProcedure from "@/components/seo/SchemaProcedure.astro";
import { i18nPaths, getLangFromUrl } from "@/i18n/utils";
import {
  FLOW_ZH_HK,
  FLOW_ZH_CN,
} from "@/data/flowOfVisionCorrectionData";

export function getStaticPaths() {
  return [...i18nPaths];
}

const lang = getLangFromUrl(Astro.url);
const isCn = lang === "zh-cn";
const content = isCn ? FLOW_ZH_CN : FLOW_ZH_HK;

const breadcrumbItems = [
  { name: content.breadcrumb.home, url: isCn ? "/cn/" : "/" },
  {
    name: content.breadcrumb.current,
    url: isCn
      ? "/cn/flow-of-vision-correction"
      : "/flow-of-vision-correction",
  },
];
---

<BaseLayout tdkKey="flowOfVisionCorrection">
  <SchemaProcedure
    name={content.banner.title}
    description={content.process.intro}
  />
  <SchemaBreadcrumb items={breadcrumbItems} />

  <div class="flow-page font-hk text-desc relative overflow-x-clip">
    {/* 1. 頂部橫幅 Banner */}
    <section class="main_banner" aria-label={content.banner.title}>
      <div class="site-container">
        <div class="banner">
          <div class="des_box">
            <h1 class="gradient_font">{content.banner.title}</h1>
          </div>
        </div>
      </div>
    </section>

    {/* 2. 矯視流程步驟圖 */}
    <section
      class="process-section site-container"
      aria-labelledby="process-heading"
    >
      <div class="flex justify-center md:mt-28 mt-10">
        <h2 id="process-heading">{content.process.title}</h2>
      </div>
      <div class="text-center process-text mb-20">
        <span>{content.process.intro}</span>
      </div>
      <div>
        <div class="flex my-10 process-step justify-around">
          {
            content.process.steps.map((item) => (
              <div class="step-box">
                <div class="step">
                  <img
                    src={item.img}
                    alt=""
                    draggable="false"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="step-txt">
                  <span set:html={item.textHtml} />
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* 3. 注意事項 */}
    <section
      class="regard-section site-container"
      aria-labelledby="regard-heading"
    >
      <div class="flex justify-center md:mt-28 mt-10">
        <h2 id="regard-heading">{content.regard.title}</h2>
      </div>

      <div class="regard-think">
        {
          content.regard.topCards.map((box) => (
            <div class="regard-box text-center">
              <span class="title">{box.title}</span>
              <div class="md:flex regard-items">
                {box.items.map((item) => (
                  <div class="regard">
                    <img
                      src={item.img}
                      alt=""
                      draggable="false"
                      loading="lazy"
                      decoding="async"
                      class:list={["mb-5", item.imgClass]}
                    />
                    <span set:html={item.textHtml} />
                  </div>
                ))}
              </div>
            </div>
          ))
        }
      </div>

      <div class="regard-think-two">
        <div class="regard-box text-center">
          <span class="title">{content.regard.bottomCard.title}</span>
          {
            content.regard.bottomCard.items.map((item) => (
              <div class="regard">
                <img
                  src={item.img}
                  alt=""
                  draggable="false"
                  loading="lazy"
                  decoding="async"
                  class:list={["mb-5", item.imgClass]}
                />
                <span set:html={item.textHtml} />
              </div>
            ))
          }
        </div>
      </div>

      <div class="flex justify-center my-10 mbShow">
        <a
          href={content.cta.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-yuyue-link"
          data-cta="whatsapp"
        >
          <div class="flex btn-yuyue items-center">
            <img
              src={content.cta.icon}
              alt=""
              draggable="false"
              loading="lazy"
              decoding="async"
              class="btn-yuyue-icon"
            />
            <div class="flex flex-col justify-center btn-yuyue-text">
              <span>{content.cta.label}</span>
              <span>{content.cta.phone}</span>
            </div>
          </div>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style lang="scss">
  .flow-page {
    background: #ffffff;

    h2 {
      font-size: 25px;
      color: #4570b6;
      text-align: center;
      position: relative;
      margin-bottom: 30px;
    }

    .gradient_font {
      display: inline-block;
      background: linear-gradient(90.57deg, #4570b6 0, #81dbec 60%);
      background-clip: text;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .banner {
      display: flex;
      justify-content: flex-start;
      align-items: center;
      background-repeat: no-repeat;
      background-size: cover;
      background-position: center;
    }

    .des_box {
      h1 {
        font-style: normal;
        font-weight: 500;
        display: flex;
        align-items: center;
        text-align: center;
        letter-spacing: 0.15em;
        margin: 0;
      }
    }

    .step-txt {
      position: absolute;
      top: 67px;
      left: 89px;
      font-style: normal;
      font-weight: 700;
      font-size: 20px;
      line-height: 20px;
      text-align: right;
      letter-spacing: 0.1em;
      background: linear-gradient(90.57deg, #4570b6 -11.77%, #81dbec 111.92%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;

      :global(span) {
        font-style: normal;
        font-weight: 700;
        font-size: 20px;
        line-height: 20px;
        text-align: right;
        letter-spacing: 0.1em;
        background: linear-gradient(
          90.57deg,
          #4570b6 -11.77%,
          #81dbec 111.92%
        );
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        white-space: pre;
      }
    }

    .btn-yuyue-link {
      text-decoration: none;
    }

    .btn-yuyue-icon {
      width: 12vw;
      max-width: 54px;
      height: auto;
    }

    .btn-yuyue-text {
      padding: 0 10px;
    }

    .btn-yuyue {
      border: 1px solid transparent;
      border-radius: 99px;
      background-clip: padding-box, border-box;
      background-origin: padding-box, border-box;
      background-image:
        linear-gradient(to right, #fff, #fff),
        linear-gradient(90deg, #4671b7 -23.33%, #7cd2e7 122.38%);
      padding: 2.5vw 5vw;

      span {
        font-style: normal;
        font-weight: 500;
        font-size: 16px;
        line-height: 20px;
        text-align: center;
        letter-spacing: 0.1em;
        background: linear-gradient(90deg, #4671b7 -23.33%, #7cd2e7 122.38%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }
    }
  }

  @media screen and (min-width: 768px) {
    .flow-page {
      .mbShow {
        display: none !important;
      }

      .banner {
        background-image: url("https://statichk.cmermedical.com/imgs/2023/03/f749408bdb90b101.jpg");
        height: 480px;
        padding-left: 50px;
        margin-top: 16px;
      }

      .des_box {
        width: 930px;
        max-width: 100%;
        margin-bottom: 35px;

        h1 {
          font-size: 38px;
          line-height: 42px;
        }
      }

      .step-box {
        position: relative;
        width: 165px;
        border-bottom: 0.5px solid #4570b6;

        .step img {
          width: 120px;
        }
      }

      .step-box:nth-child(3) {
        width: 210px;
      }

      .process-text {
        font-style: normal;
        font-weight: 300;
        font-size: 15px;
        line-height: 30px;
        text-align: center;
        letter-spacing: 0.1em;
        color: #6d6e71;
        max-width: 68%;
        margin: auto;
        padding-bottom: 15px;

        span {
          font-size: 20px;
          font-weight: 300;
        }
      }

      .regard-think {
        display: flex;
      }

      .regard-think-two {
        display: flex;

        .regard-box {
          width: 100%;
          margin: 40px 15px;
          align-items: center;
          justify-content: space-between;
          flex-wrap: wrap;
        }

        .regard-box .regard {
          margin: 0 36px;
        }
      }

      .regard-box {
        margin: 0 10px;
        border: 3px solid #d9e9ec;
        border-radius: 30px;
        display: flex;
        width: 50%;
        padding: 24px;
        position: relative;

        .title {
          font-style: normal;
          font-weight: 700;
          font-size: 32px;
          line-height: 40px;
          text-align: center;
          letter-spacing: 0.1em;
          background: linear-gradient(180deg, #5286c2 0%, #78cce5 100%);
          -webkit-background-clip: text;
          -webkit-text-fill-color: transparent;
          background-clip: text;
          overflow-wrap: break-word;
          width: 50px;
          flex-shrink: 0;
        }

        .regard-items {
          flex: 1;
          justify-content: center;
        }

        .regard {
          margin: 0 20px;
          display: flex;
          flex-direction: column;
          align-items: center;
          align-content: center;

          img {
            height: 110px;
            width: auto;
            object-fit: contain;
          }

          :global(span) {
            font-style: normal;
            font-weight: 300;
            font-size: 20px;
            line-height: 30px;
            white-space: pre;
            text-align: center;
            letter-spacing: 0.1em;
            color: #6d6e71;
          }
        }
      }

      .regard-box:first-child .regard:last-child {
        margin: 0;
      }
    }
  }

  @media screen and (min-width: 1139px) {
    .flow-page {
      .regard-box {
        padding: 31px;

        .regard {
          margin: 0 35px;
        }
      }

      .regard-think-two .regard-box {
        flex-wrap: nowrap;

        .regard {
          margin: 0 64px;
        }
      }
    }
  }

  @media screen and (max-width: 767px) {
    .flow-page {
      h2 {
        font-size: 16px;
      }

      .regard-section h2 {
        font-size: 18px;
      }

      .banner {
        background-image: url("https://statichk.cmermedical.com/imgs/2023/03/8a339705a6d7abed.jpg");
        background-position: top;
        background-size: 100% auto;
        width: 100%;
        aspect-ratio: 1 / 1;
        margin: 12px auto 10vw;
        font-size: 20px;
        padding: 0 20px;
      }

      .des_box h1 {
        font-size: 30px;
        line-height: 1.25;
      }

      .process-text {
        color: #6d6e71;
      }

      .process-step {
        display: flex;
        flex-direction: column;

        .step-box {
          position: relative;
          width: 100%;
          margin-bottom: 41px;

          .step img {
            width: 120px;
          }
        }

        .step-box:nth-child(1)::after {
          content: "";
          position: absolute;
          width: 50%;
          height: 1px;
          display: block;
          margin: 0 auto;
          border-bottom: 1px solid #4570b6;
        }

        .step-box:nth-child(3)::after {
          content: "";
          position: absolute;
          width: 60%;
          height: 1px;
          display: block;
          margin: 0 auto;
          border-bottom: 1px solid #4570b6;
        }

        .step-box:nth-child(2)::after,
        .step-box:nth-child(4)::after {
          content: "";
          position: absolute;
          width: 50%;
          height: 1px;
          display: block;
          margin: 0 auto;
          border-bottom: 1px solid #4570b6;
          bottom: 0;
          right: 0;
        }

        .step-box:nth-child(2),
        .step-box:nth-child(4) {
          display: flex;
          padding-right: 40vw;
          justify-content: flex-end;

          .step-txt {
            position: absolute;
            left: auto;
            right: 40px;
          }
        }
      }

      .step-txt {
        position: absolute;
        top: 51px;
        left: 89px;
      }

      .regard-think {
        display: flex;
        flex-direction: column;
      }

      .regard-think-two {
        display: flex;
        flex-direction: column;

        .regard-box {
          margin: 40px 0 10vw;
          align-items: center;
          display: flex;
          flex-direction: column;
          justify-content: flex-start;

          .regard {
            margin: 10vw 64px;
          }
        }
      }

      .regard-box {
        flex-direction: row;
        border: 3px solid #d9e9ec;
        border-radius: 30px;
        display: flex;
        padding: 31px 0 31px 31px;
        justify-content: center;
        margin-bottom: 39px;
        position: relative;

        .title {
          font-style: normal;
          font-weight: 700;
          font-size: 32px;
          line-height: 40px;
          width: min-content;
          text-align: center;
          letter-spacing: 0.1em;
          background: linear-gradient(180deg, #5286c2 0%, #78cce5 100%);
          -webkit-background-clip: text;
          -webkit-text-fill-color: transparent;
          background-clip: text;
          position: absolute;
          left: 10vw;
          top: 12vw;
        }

        .regard {
          display: flex;
          flex-direction: column;
          align-items: center;
          align-content: center;
          margin-bottom: 10vw;

          img {
            height: 110px;
            width: auto;
            object-fit: contain;
          }

          :global(span) {
            font-style: normal;
            font-weight: 300;
            font-size: 16px;
            line-height: 20px;
            white-space: pre;
            text-align: center;
            letter-spacing: 0.1em;
            color: #6d6e71;
          }
        }
      }
    }
  }
</style>
