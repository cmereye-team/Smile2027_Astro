---
import BaseLayout from "@/layouts/BaseLayout.astro";
import VideoList from "@/components/views/VideoList.astro";
import { i18nPaths, useI18n, getLangFromUrl, getLocalizedHref } from "@/i18n/utils";
export function getStaticPaths() {
  return [...i18nPaths];
}
const { dict } = useI18n(Astro.url);
const lang = getLangFromUrl(Astro.url);
const homeUrl = getLocalizedHref("/", lang);
---

<BaseLayout tdkKey="video">
  <section class="page-banner" aria-label={dict.common.menu.news.case}>
    <div class="site-container">
      <div class="page-banner-card">
        <div class="page-banner-content">
          <span class="page-banner-eyebrow">VIDEO</span>
          <h1 class="page-banner-title">{dict.common.menu.news.case}</h1>
          <p class="page-banner-subtitle">Case Sharing</p>
          <nav class="page-banner-breadcrumb" aria-label="麵包屑導航">
            <a href={homeUrl}>{dict.common.menu.home}</a>
            <span aria-hidden="true"> &gt; </span>
            <span>{dict.common.menu.news.title}</span>
            <span aria-hidden="true"> &gt; </span>
            <span class="page-banner-breadcrumb-current">{dict.common.menu.news.case}</span>
          </nav>
        </div>
      </div>
    </div>
  </section>
  <VideoList />
</BaseLayout>
