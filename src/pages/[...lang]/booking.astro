---
/*
 * @Author: Antigravity AI
 * @Date: 2026-11-10
 * @FilePath: /src/pages/[...lang]/booking.astro
 * @Description: 預約服務入口專頁 (100% 官方真值對齊 + 講座與術前檢查導向 + MW-01 轉換追蹤 + 完整 Schema)
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import SchemaProcedure from "@/components/seo/SchemaProcedure.astro";
import SchemaBreadcrumb from "@/components/seo/SchemaBreadcrumb.astro";
import BookingBanner from "@/components/booking/BookingBanner.astro";
import { i18nPaths, getLangFromUrl } from "@/i18n/utils";
import { BOOKING_ZH_HK, BOOKING_ZH_CN } from "@/data/bookingData";

export function getStaticPaths() {
  return [...i18nPaths];
}

const lang = getLangFromUrl(Astro.url);
const isCn = lang === "zh-cn";
const content = isCn ? BOOKING_ZH_CN : BOOKING_ZH_HK;
---

<BaseLayout tdkKey="booking">
  <SchemaProcedure
    name={content.banner.title}
    description={content.appointForm.p3.replace(/<[^>]+>/g, "")}
  />
  <SchemaBreadcrumb
    items={[
      { name: content.breadcrumb.home, url: isCn ? "/cn/" : "/" },
      {
        name: content.breadcrumb.current,
        url: isCn ? "/cn/booking" : "/booking",
      },
    ]}
  />

  <div class="booking-page font-hk text-desc relative overflow-x-hidden">
    <h1 class="sr-only">{content.banner.title}</h1>

    {/* 1. 頂部橫幅 Hero Banner (CMS slides API: gid=2&pageSize=5) */}
    <BookingBanner title={content.banner.title} gid={2} pageSize={5} />

    {/* 2. 預約服務卡片區塊 (講座 & 術前眼睛檢查 + WhatsApp 立即預約/查詢) */}
    <section class="page_container serve-page" aria-label={content.banner.title}>
      <div class="flex md:justify-center flex-col items-center md:flex-row">
        {/* 卡片 1: 講座 (跳轉至講座預約專頁 /ophthalmicInfo/AppointForm) */}
        <a
          href={isCn ? "/cn/ophthalmicInfo/AppointForm" : "/ophthalmicInfo/AppointForm"}
          class="serve-box-link"
        >
          <div class="serve-box">
            <img
              src={content.serve.lectureIcon}
              alt={content.serve.lectureTitle}
              draggable="false"
              loading="eager"
              width="100"
              height="100"
            />
            <p>{content.serve.lectureTitle}</p>
          </div>
        </a>

        {/* 卡片 2: 術前眼睛檢查 (跳轉至診症須知術前檢查) */}
        <a
          href={isCn ? "/cn/patient-info#PreCorrection" : "/patient-info#PreCorrection"}
          class="serve-box-link"
        >
          <div class="serve-box">
            <img
              src={content.serve.examIcon}
              alt={content.serve.examTitle}
              draggable="false"
              loading="eager"
              width="100"
              height="100"
            />
            <p>{content.serve.examTitle}</p>
          </div>
        </a>
      </div>

      {/* WhatsApp 立即預約/查詢按鈕 (官方保留 MW-01 追蹤代碼) */}
      <div class="flex justify-center my-10">
        <a
          href={content.serve.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="whatsapp-booking-btn"
          data-cta="whatsapp"
        >
          <div class="flex btn-yuyue items-center">
            <img
              src={content.serve.whatsappIcon}
              alt=""
              draggable="false"
              class="w-10 h-10 md:w-12 md:h-12"
              width="48"
              height="48"
            />
            <div class="flex flex-col justify-center text-left pl-3 pr-2">
              <span class="text-xs md:text-sm font-medium leading-tight">
                {content.serve.whatsappCta}
              </span>
              <span class="text-sm md:text-base font-bold tracking-wide">
                {content.serve.whatsappPhone}
              </span>
            </div>
          </div>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* 預約服務卡片區塊 */
  .serve-page {
    max-width: 1200px;
    margin: 40px auto;
    padding: 0 16px;
  }

  .serve-box-link {
    text-decoration: none;
    display: block;
  }

  .serve-box {
    width: 315px;
    height: 288px;
    border: 2px solid #4570b6;
    border-radius: 10px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin: 0 50px 40px;
    background: #ffffff;
    box-shadow: 0 4px 15px rgba(69, 112, 182, 0.06);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .serve-box:hover {
    border: 2px solid #81dbec;
    box-shadow: 0 10px 25px rgba(129, 219, 236, 0.25);
    transform: translateY(-4px);
  }

  .serve-box img {
    width: 100px;
    height: 100px;
    object-fit: contain;
    transition: transform 0.3s ease;
  }

  .serve-box:hover img {
    transform: scale(1.05);
  }

  .serve-box p {
    font-weight: 500;
    font-size: 20px;
    line-height: 30px;
    margin-top: 36px;
    text-align: center;
    letter-spacing: 0.1em;
    color: #6d6e71;
  }

  .whatsapp-booking-btn {
    text-decoration: none;
  }

  .btn-yuyue {
    background: linear-gradient(104.24deg, #5184c1 5.95%, #7cd3e8 114.4%);
    border-radius: 35px;
    padding: 10px 28px;
    color: #ffffff;
    box-shadow: 0 6px 18px rgba(81, 132, 193, 0.3);
    transition: all 0.3s ease;
  }

  .btn-yuyue:hover {
    box-shadow: 0 8px 24px rgba(81, 132, 193, 0.45);
    transform: scale(1.02);
  }

  @media screen and (max-width: 768px) {
    .serve-page {
      margin: 20px auto 30px;
    }

    .serve-box {
      width: 240px;
      height: 210px;
      margin: 15px auto;
    }

    .serve-box img {
      width: 64px;
      height: 64px;
    }

    .serve-box p {
      font-size: 16px;
      margin-top: 18px;
    }
  }
</style>
