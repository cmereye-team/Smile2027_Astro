---
/*
 * @Author: Antigravity AI
 * @Date: 2026-11-10
 * @FilePath: /src/pages/[...lang]/vision-correction-lasik.astro
 * @Description: LASIK 激光矯視專頁 (100% 官方真值對齊 + 雙端響應式 + W-07 轉換追蹤 + 完整 Schema)
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import SchemaProcedure from "@/components/seo/SchemaProcedure.astro";
import SchemaBreadcrumb from "@/components/seo/SchemaBreadcrumb.astro";
import { i18nPaths, getLangFromUrl } from "@/i18n/utils";
import {
  LASIK_ZH_HK,
  LASIK_ZH_CN,
} from "@/data/lasikData";

export function getStaticPaths() {
  return [...i18nPaths];
}

const lang = getLangFromUrl(Astro.url);
const isCn = lang === "zh-cn";
const content = isCn ? LASIK_ZH_CN : LASIK_ZH_HK;
---

<BaseLayout tdkKey="lasik">
  <SchemaProcedure
    name={`LASIK ${content.banner.title}`}
    description={content.principle.desc}
  />
  <SchemaBreadcrumb
    items={[
      { name: content.breadcrumb.home, url: isCn ? "/cn/" : "/" },
      {
        name: content.breadcrumb.service,
        url: isCn ? "/cn/vision-correction-lasik" : "/vision-correction-lasik",
      },
      {
        name: content.breadcrumb.current,
        url: isCn ? "/cn/vision-correction-lasik" : "/vision-correction-lasik",
      },
    ]}
  />

  <div class="lasik font-hk text-desc relative overflow-x-hidden">
    {/* 1. 頂部橫幅 Hero Banner */}
    <div class="Banner banner-box">
      <div class="banner-img banner-text-default">
        <h1 class="banner-title">
          LASIK<br class="md:hidden" />{content.banner.title}
        </h1>
        <p class="banner-subtitle">
          Laser-Assisted <br class="md:hidden" />in Situ Keratomileusis
        </p>
      </div>
    </div>

    {/* 2. 激光技術介紹 */}
    <section class="laser_technology" aria-labelledby="laser-tech-heading">
      <h2 id="laser-tech-heading">
        <span>{content.laserTechnology.title}</span>
      </h2>
      <p class="laser_technology-in">
        {content.laserTechnology.desc}
      </p>
    </section>

    {/* 3. 激光矯視原理 */}
    <section class="principle" aria-labelledby="principle-heading">
      <div class="principle-top">
        <div>
          <img
            draggable="false"
            loading="lazy"
            decoding="async"
            src={content.principle.icon}
            alt={content.principle.iconAlt}
            title={content.principle.iconAlt}
            width="108"
            height="108"
          />
        </div>
        <h3 id="principle-heading">
          LASIK<br />
          {content.principle.title}
        </h3>
      </div>
      <div class="principle-img">
        {content.principle.images.map((imgSrc, idx) => (
          <div class="principle-img-in">
            <img
              draggable="false"
              loading="lazy"
              decoding="async"
              src={imgSrc}
              alt={`${content.principle.title} 步驟 ${idx + 1}`}
              width="185"
              height="185"
            />
          </div>
        ))}
      </div>
      <div class="principle-text">
        <p>
          {content.principle.desc}
        </p>
      </div>
    </section>

    {/* 4. LASIK激光矯視的好處 */}
    <section class="benefits" aria-labelledby="benefits-heading">
      <h2 id="benefits-heading">
        <span>{content.benefits.title}</span>
      </h2>
      <div class="benefits-lists">
        {content.benefits.items.map((item) => (
          <div class="benefits-lists-in">
            <div class="images">
              <img
                draggable="false"
                loading="lazy"
                decoding="async"
                src={item.img}
                alt={item.title}
                title={item.title}
              />
            </div>
            <h4>{item.title}</h4>
            <p>{item.text}</p>
          </div>
        ))}
      </div>
    </section>

    {/* 5. 合適對象 */}
    <section class="suitable_object" aria-labelledby="suitable-heading">
      <div class="suitable_object-top">
        <img
          draggable="false"
          loading="lazy"
          decoding="async"
          src={content.suitable.icon}
          alt={content.suitable.title}
          title={content.suitable.title}
        />
        <h2 id="suitable-heading">
          <span>{content.suitable.title}</span>
        </h2>
      </div>
      <div class="suitable_object-lists">
        {content.suitable.items.map((item) => (
          <div class="suitable_object-lists-in">
            <div class="box">
              <div class="image">
                <img
                  draggable="false"
                  loading="lazy"
                  decoding="async"
                  src={item.img}
                  alt={item.text.join(" ")}
                />
              </div>
              <div class="text">
                {item.text.map((textItem) => (
                  <p>{textItem}</p>
                ))}
              </div>
              {item.mbText && (
                <div class="text mbText">
                  {item.mbText.map((textItem) => (
                    <p>{textItem}</p>
                  ))}
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>

    {/* 6. 預約諮詢按鈕 */}
    <div class="smile-pro-btn">
      <a
        href={content.appointment.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-cta="whatsapp-w07"
      >
        {content.appointment.btn}
      </a>
    </div>
  </div>
</BaseLayout>

