<script is:inline define:vars={{ stepsData: content.steps.list }}>
  function initRelexSmileInteractive() {
    // 1. 步驟切換交互
    const stepButtons = document.querySelectorAll(".steps-number .step");
    const stepImg = document.getElementById("relex-step-img");
    const stepText = document.getElementById("relex-step-text");

    if (stepButtons.length && stepImg && stepText) {
      stepButtons.forEach((btn, index) => {
        function activateStep() {
          stepButtons.forEach((b) => {
            b.classList.remove("active");
            b.setAttribute("aria-selected", "false");
          });
          btn.classList.add("active");
          btn.setAttribute("aria-selected", "true");

          const current = stepsData[index];
          if (current) {
            stepImg.src = current.image;
            stepImg.srcset = `${current.image} 768w, ${current.imagePc} 1200w`;
            stepText.textContent = current.text;
            stepText.className = `steps-content-text steps-content-${current.number}`;
          }
        }

        btn.addEventListener("click", activateStep);
        btn.addEventListener("mouseenter", activateStep);
      });
    }

    // 2. SMILE XTRA 滾動進入視口展開動畫
    const xtraSection = document.getElementById("relexXtraSection");
    if (xtraSection) {
      const xtraPaper = xtraSection.querySelector(".xtra-paper");
      const xtraItems = xtraSection.querySelectorAll(".xtra-paper-item");

      if (xtraPaper && xtraItems.length) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting && entry.intersectionRatio >= 0.25) {
                xtraPaper.classList.add("unfolded");
                xtraItems.forEach((item) => item.classList.add("unfolded"));
              } else if (!entry.isIntersecting && entry.intersectionRatio < 0.1) {
                xtraPaper.classList.remove("unfolded");
                xtraItems.forEach((item) => item.classList.remove("unfolded"));
              }
            });
          },
          { threshold: [0.1, 0.25, 0.5], rootMargin: "40px 0px" }
        );

        observer.observe(xtraSection);
      }
    }

    // 3. 好處卡片點擊激活切換
    const benefitItems = document.querySelectorAll(".benefit-item");
    benefitItems.forEach((item) => {
      item.addEventListener("click", () => {
        benefitItems.forEach((i) => i.classList.remove("active"));
        item.classList.add("active");
      });
    });
  }

  document.addEventListener("DOMContentLoaded", initRelexSmileInteractive);
  document.addEventListener("astro:page-load", initRelexSmileInteractive);
</script>

<style lang="scss">
