        <div class="steps-bg bg-white">
          <div class="steps-number" role="tablist" aria-label="矯視步驟">
            {
              content.steps.list.map((step, index) => (
                <button
                  type="button"
                  role="tab"
                  aria-selected={index === 0 ? "true" : "false"}
                  class:list={["step", { active: index === 0 }]}
