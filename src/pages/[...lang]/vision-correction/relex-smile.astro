      letter-spacing: 0.2vw;
    }
  }

  :global(#site-footer) {
    position: relative;
    z-index: 10;
    background-color: #f4fafc !important;
    margin-top: 0 !important;
  }

  @media screen and (max-width: 991px) {
    :global(#site-footer) {
      margin-top: -60px !important;
      background-color: #f4fafc !important;
    }
    :global(#site-footer .footer-bottom) {
      margin-bottom: 0 !important;
