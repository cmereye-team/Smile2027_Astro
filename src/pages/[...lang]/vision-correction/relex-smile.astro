        class="principles bg-primary text-white py-13 px-4 md:py-16 md:px-24"
        aria-labelledby="section-principles-heading"
      >
        <h2
          id="section-principles-heading"
          class="text-white font-hk text-xl md:text-3xl font-black leading-[30px]"
        >
          <span class="font-en font-bold">{content.principles.titlePrefix}</span>{content.principles.titleSuffix}
        </h2>
        <p set:html={content.principles.desc} />
        <a
          href={content.principles.whatsappUrl}
          rel="noopener noreferrer"
          target="_blank"
          class="more-button"
          data-cta="whatsapp"
          title="WhatsApp 預約 SMILE 矯視術前檢查及諮詢"
        >
          <span>{content.principles.btn}</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="30"
            height="29"
            viewBox="0 0 30 29"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M3.2 26.06 25.827 3.43"
              stroke="currentColor"
              stroke-width="5.4"
              stroke-linecap="round"></path>
            <path
              d="M6.496 2.711H26.6v19.44"
