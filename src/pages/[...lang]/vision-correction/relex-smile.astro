---
/*
 * @Author: Antigravity AI
 * @Date: 2026-11-09
 * @FilePath: /src/pages/[...lang]/vision-correction/relex-smile.astro
 * @Description: SMILE 微笑激光矯視 (100% 原版文案精確對齊 + 零 CLS + 完整 Schema & 埋點)
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import SchemaProcedure from "@/components/seo/SchemaProcedure.astro";
import SchemaBreadcrumb from "@/components/seo/SchemaBreadcrumb.astro";
import SchemaFAQ from "@/components/seo/SchemaFAQ.astro";
import UserShare from "@/components/views/UserShare.astro";
import SwiperRound from "@/components/views/SwiperRound.astro";
import SwiperCard from "@/components/views/SwiperCard.astro";
import { i18nPaths, getLangFromUrl } from "@/i18n/utils";
import { getBanners } from "@/data/bannerData";
import {
  RELEX_SMILE_ZH_HK,
  RELEX_SMILE_ZH_CN,
  SMILE_SHARE_DATA,
} from "@/data/relexSmileData";

export function getStaticPaths() {
  return [...i18nPaths];
}

const lang = getLangFromUrl(Astro.url);
const isCn = lang === "zh-cn";
const content = isCn ? RELEX_SMILE_ZH_CN : RELEX_SMILE_ZH_HK;
const banners = await getBanners(lang);
---

<BaseLayout tdkKey="smile">
  <SchemaProcedure
    name={content.hero.title}
    description={content.principles.desc.replace(/<[^>]+>/g, "")}
  />
  <SchemaBreadcrumb
    items={[
      { name: content.breadcrumb.home, url: isCn ? "/cn/" : "/" },
      {
        name: content.breadcrumb.service,
        url: isCn
          ? "/cn/vision-correction/relex-smile"
          : "/vision-correction/relex-smile",
      },
      {
        name: content.breadcrumb.current,
        url: isCn
          ? "/cn/vision-correction/relex-smile"
          : "/vision-correction/relex-smile",
      },
    ]}
  />
  <SchemaFAQ faqs={content.faqs} />

  <div class="page-smile font-hk">
    <div class="smile-main-column">
      {/* Section 1: Hero Banner */}
