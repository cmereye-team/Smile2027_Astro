            xmlns="http://www.w3.org/2000/svg"
            width="30"
            height="29"
            viewBox="0 0 30 29"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M3.2 26.06 25.827 3.43"
              stroke="#fff"
              stroke-width="5.4"
              stroke-linecap="round"></path>
            <path
              d="M6.496 2.71H26.6v19.44"
