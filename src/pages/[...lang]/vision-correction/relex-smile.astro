        <div
          class="newCenter-card pt-20 md:pt-[142px] pl-8 md:pl-[57px] pb-8 md:pb-12"
        >
          <div class="newCenter-card-title text-primary">
            <span
              class="font-bold text-[69.064px] md:text-[137.67px] leading-[75.556px] md:leading-[150.611px] font-en"
            >
              {content.hero.tag}
            </span>
            <h1
              id="hero-title"
              class="text-[37.289px] md:text-[74.332px] leading-[40.795px] md:leading-[81.319px]"
            >
              {content.hero.title}
            </h1>
            <p class="text-sm md:text-3xl leading-8 md:leading-[64.668px]">
              {content.hero.subtitle}
            </p>
          </div>
          <nav
            class="newCenter-card-nav mt-8 md:mt-[68.39px] text-text font-tc text-sm md:text-xl font-light leading-[21.822px] md:leading-[43.5px] tracking-[0.36px] md:tracking-[0.6px]"
            aria-label="麵包屑導航"
          >
            <a href={isCn ? "/cn/" : "/"}>{content.breadcrumb.home}</a>&nbsp;&gt;&nbsp;
            <span>{content.breadcrumb.service}</span>&nbsp;&gt;&nbsp;
            <a
              class="text-primary font-medium"
              href={isCn
                ? "/cn/vision-correction/relex-smile"
                : "/vision-correction/relex-smile"}
            >
              {content.breadcrumb.current}
            </a>
          </nav>
        </div>
      </section>

      {/* Section 2: 矯視原理 (principles) */}
