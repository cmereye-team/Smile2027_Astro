---
/*
 * @Author: Antigravity AI
 * @Date: 2026-11-11
 * @FilePath: /src/pages/[...lang]/medical-equipment.astro
 * @Description: 中心設備專頁 (100% 線上官網逐字與版面還原 + 繁簡雙語 + 共享 .site-container + BreadcrumbList Schema)
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import SchemaBreadcrumb from "@/components/seo/SchemaBreadcrumb.astro";
import SchemaEquipment from "@/components/seo/SchemaEquipment.astro";
import { i18nPaths, getLangFromUrl } from "@/i18n/utils";
import {
  EQUIPMENT_ZH_HK,
  EQUIPMENT_ZH_CN,
} from "@/data/equipmentData";

export function getStaticPaths() {
  return [...i18nPaths];
}

const lang = getLangFromUrl(Astro.url);
const isCn = lang === "zh-cn";
const content = isCn ? EQUIPMENT_ZH_CN : EQUIPMENT_ZH_HK;

const breadcrumbItems = [
  { name: content.breadcrumb.home, url: isCn ? "/cn/" : "/" },
  {
    name: content.breadcrumb.current,
    url: isCn ? "/cn/medical-equipment/" : "/medical-equipment/",
  },
];
---

<BaseLayout tdkKey="equipment">
  <SchemaBreadcrumb items={breadcrumbItems} />
  <SchemaEquipment content={content} lang={lang} />

  <div class="equipment">
    {/* 1. 頂部統一橫幅 Banner */}
    <section
      class="page-banner"
      aria-label={content.banner.title}
    >
      <div class="site-container">
        <div
          class="page-banner-card page-banner-card--light"
          style={{
            "--banner-bg-pc": "url('https://static.cmermedical.com.hk/smile/assets/bf7a6b723e77c2a8.webp')",
            "--banner-bg-mb": "url('https://static.cmermedical.com.hk/smile/assets/imgs/2024/05/b1b778ced1d15d71.png')",
          }}
        >
          <div class="page-banner-content">
            <h1 class="page-banner-title">{content.banner.title}</h1>
            <p class="page-banner-subtitle" set:html={content.banner.subtitleHtml} />
          </div>
        </div>
      </div>
    </section>

    {/* 2. 中心設備展示網格 */}
    <section
      class="equipment-box site-container"
      aria-labelledby="equipment-section-heading"
    >
      <h2 id="equipment-section-heading" class="equipment-heading">
        <span>{content.sectionTitle}</span>
      </h2>

      <input type="checkbox" id="equipment-show-all" class="sr-only" />
      <div class="equipment-items" id="equipment-grid">
        {
          content.items.map((item, index) => (
            <article
              class="equipment-card"
              data-equipment-id={item.id}
              data-category={item.category}
              data-mobile-hidden={index >= 8 ? "true" : "false"}
            >
              <details class="equipment-details">
                <summary
                  class="equipment-card-face"
                  aria-label={`${content.toggleAriaLabel}：${item.alt}`}
                >
                  <div class="equipment-img-wrap">
                    <img
                      src={item.img}
                      alt={item.alt}
                      title={item.alt}
                      width="320"
                      height="280"
                      draggable="false"
                      loading={index < 3 ? "eager" : "lazy"}
                      decoding="async"
                    />
                  </div>
                  <div class="equipment-name">
                    <span class="equipment-name-up" aria-hidden="true">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="50"
                        height="49"
                        viewBox="0 0 50 49"
                        fill="none"
                        aria-hidden="true"
                      >
                        <rect width="50" height="49" rx="11" fill="#4570B6" />
                        <path
                          d="M16 19.6515L24.4784 9.84839C24.8693 9.3964 25.5667 9.3859 25.9711 9.82592L35 19.6515"
                          stroke="white"
                          stroke-width="5"
                          stroke-linecap="round"
                        />
                        <path
                          d="M25.2124 9.28516V31.7397"
                          stroke="white"
                          stroke-width="5"
                          stroke-linecap="round"
                        />
                      </svg>
                    </span>
                    <h3 class={`equipment-name-text equipment-${item.id}`}>
                      {item.nameLines.map((line) => (
                        <span set:html={line} />
                      ))}
                    </h3>
                  </div>
                </summary>

                <div class="equipment-remark">
                  <div>{item.remark}</div>
                  <div>{item.source}</div>
                </div>
              </details>
            </article>
          ))
        }
      </div>

      <label for="equipment-show-all" class="more-btn" id="equipment-more-btn">
        {content.seeAllLabel}
      </label>
    </section>
  </div>
</BaseLayout>

<style lang="scss">
  .equipment {
    width: 100%;
    overflow-x: clip;
  }

  .equipment-heading {
    text-align: center;
    position: relative;
    border: none;
    margin: 0 auto 10px;

    &::before {
      content: none;
      border: none;
    }

    :global(span) {
      color: #4570b6;
      font-family: var(--font-hk), "Noto Sans HK", sans-serif;
      font-style: normal;
      font-weight: 500;
    }

    &::after {
      content: "";
      background: #a6e1d6;
      height: 5px;
      border-radius: 3px;
      position: absolute;
      left: 50%;
      bottom: 0;
      transform: translateX(-50%);
    }
  }

  .equipment-details {
    position: relative;
    width: 100%;
    height: 100%;
    display: block;
  }

  .equipment-card-face {
    list-style: none;
    cursor: pointer;

    &::-webkit-details-marker {
      display: none;
    }
  }

  .equipment-name-up {
    background: transparent;
    border: 0;
    padding: 0;
    cursor: pointer;
    display: block;

    svg {
      transition: transform var(--dur-slow) var(--ease-out);
    }
  }

  .equipment-remark {
    display: none;
    opacity: 0;
    transition: opacity var(--dur-slow) var(--ease-out);
  }

  .equipment-details[open] .equipment-remark {
    display: flex;
    opacity: 1;
  }

  .equipment-name-text {
    :global(span) {
      font-size: inherit;
      line-height: inherit;
      color: inherit;
    }
  }

  @media screen and (min-width: 768px) {
    .equipment-name-text :global(br.mbShow) {
      display: none;
    }

    .more-btn {
      display: none;
    }

    .equipment-heading {
      padding-bottom: 32px;
      margin-bottom: 50px;

      :global(span) {
        font-size: 30px;
        line-height: 30px;
        letter-spacing: 7.5px;
        padding-left: 5px;
      }

      &::after {
        width: 39px;
      }
    }

    .equipment-box {
      margin-bottom: 160px;
    }

    .equipment-items {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      justify-items: center;
      gap: 64px 32px;
    }

    @media screen and (min-width: 1139px) {
      .equipment-items {
        grid-template-columns: repeat(3, minmax(0, 1fr));
        justify-content: space-between;
        gap: 85px 36px;
      }
    }

    @media screen and (min-width: 1310px) {
      .equipment-items {
        grid-template-columns: repeat(3, 387px);
        justify-content: space-between;
        gap: 85px 40px;
      }
    }

    .equipment-card {
      position: relative;
      width: 100%;
      max-width: 387px;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .equipment-card-face {
      width: 100%;
      max-width: 387px;
      height: 430px;
      border-radius: 40px;
      background: #fff;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      padding-top: 36px;
      box-sizing: border-box;
    }

    .equipment-img-wrap {
      width: 100%;
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      padding: 0 12px;

      img {
        max-width: 100%;
        max-height: 280px;
        width: auto;
        height: auto;
        object-fit: contain;
      }
    }

    .equipment-name {
      position: relative;
      width: calc(100% + 15px);
      max-width: 402px;

      &::after {
        content: "";
        position: absolute;
        display: block;
        z-index: 2;
        width: 100%;
        height: 30px;
        border-radius: 20px;
        background: #a6e1d6;
        bottom: -10px;
        left: 0;
      }
    }

    .equipment-name-text {
      margin: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      position: relative;
      width: 100%;
      min-height: 103px;
      border-radius: 20px;
      background: #4570b6;
      color: #fff;
      text-align: center;
      font-family: var(--font-hk), "Noto Sans HK", sans-serif;
      font-size: 25px;
      font-style: normal;
      font-weight: 700;
      line-height: 40px;
      letter-spacing: 2.5px;
      z-index: 10;
      padding: 8px 10px;
      box-sizing: border-box;
    }

    .equipment-name-up {
      position: absolute;
      top: -40px;
      right: 10px;
      z-index: 10;

      svg:hover {
        box-shadow: 0 0 3px 3px #99b7df80;
        border-radius: 10px;
      }
    }

    .equipment-details[open] .equipment-name-up svg {
      box-shadow: 0 0 3px 3px #99b7df80;
      border-radius: 10px;
      transform: rotate(180deg);
    }

    .equipment-remark {
      flex-direction: column;
      align-items: center;
      border-radius: 40px;
      width: 100%;
      padding-top: 10px;
      position: absolute;
      top: 0;
      left: 0;
      z-index: 5;
      max-width: 387px;
      height: 100%;
      max-height: 340px;
      overflow-y: auto;
      background: #fff;

      & > div {
        color: #4570b6;
        text-align: center;
        font-family: var(--font-hk), "Noto Sans HK", sans-serif;
        font-size: 14px;
        font-style: normal;
        font-weight: 400;
        line-height: 30px;
        width: 90%;
      }
    }
  }

  @media screen and (max-width: 767px) {
    .equipment-name-text :global(br.mbShow) {
      display: inline;
    }

    .equipment-heading {
      display: flex;
      flex-direction: column;
      padding-bottom: 25px;
      margin-bottom: 30px;

      :global(span) {
        text-align: center;
        font-size: 20px;
        line-height: 30px;
        letter-spacing: 5px;
      }

      &::after {
        width: 37px;
      }
    }

    .equipment-items {
      margin-bottom: 55px;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 44px 12px;
    }

    #equipment-show-all:checked ~ .equipment-items .equipment-card[data-mobile-hidden="true"] {
      display: flex;
    }

    #equipment-show-all:checked ~ .more-btn {
      display: none;
    }

    .equipment-card {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;

      &[data-mobile-hidden="true"] {
        display: none;
      }

      &::after {
        content: "";
        position: absolute;
        z-index: 2;
        bottom: -6px;
        width: 96%;
        height: 20px;
        border-radius: 20px;
        background: #a6e1d6;
        display: inline-block;
      }
    }

    .equipment-card-face {
      display: flex;
      flex-direction: column;
      align-items: center;
      position: relative;
      width: 100%;
      height: 100%;
    }

    .equipment-img-wrap {
      padding-top: 12px;
      margin-bottom: 62px;
      width: 100%;
      height: 40vw;
      max-height: 180px;
      background: #fff;
      border-radius: 16px;
      display: flex;
      align-items: flex-start;
      justify-content: center;
      box-sizing: border-box;

      img {
        width: 82%;
        max-height: 100%;
        object-fit: contain;
        margin: 0 auto;
      }
    }

    .equipment-name {
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      z-index: 5;
    }

    .equipment-name-text {
      border-radius: 10px;
      background: #4570b6;
      width: 100%;
      min-height: 76px;
      height: auto;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      color: #fff;
      text-align: center;
      font-family: var(--font-hk), "Noto Sans HK", sans-serif;
      font-size: clamp(12px, 3.58vw, 14px);
      font-style: normal;
      font-weight: 500;
      line-height: 1.38;
      letter-spacing: 0.2px;
      padding: 8px 6px;
      box-sizing: border-box;
      overflow-wrap: break-word;

      &.equipment-27 {
        font-size: clamp(11.5px, 3.2vw, 13px);
      }
    }

    .equipment-name-up {
      width: 20px;
      height: 20px;
      position: absolute;
      right: 10px;
      top: -17px;
      z-index: 15;

      svg {
        width: 100%;
        height: 100%;
      }
    }

    .equipment-details[open] .equipment-name-up svg {
      box-shadow: 0 0 3px 3px #99b7df80;
      border-radius: 5px;
      transform: rotate(180deg);
    }

    .equipment-remark {
      flex-direction: column;
      border-radius: 16px 16px 0 0;
      padding: 8px 6px 10px;
      position: absolute;
      top: 0;
      left: 0;
      z-index: 4;
      width: 100%;
      height: calc(100% - 76px);
      max-height: 180px;
      overflow-y: auto;
      margin: 0;
      background: #fff;
      justify-content: flex-start;
      box-sizing: border-box;

      &::-webkit-scrollbar {
        width: 3px;
        height: 5px;
      }

      &::-webkit-scrollbar-track {
        background-color: #cbd5e1;
        border-radius: 10px;
      }

      & > div {
        color: #4570b6;
        text-align: left;
        font-family: var(--font-hk), "Noto Sans HK", sans-serif;
        font-size: 14px;
        font-style: normal;
        font-weight: 400;
        line-height: 1.55;
        width: 100%;
        padding: 4px 4px 0;
        height: max-content;
        box-sizing: border-box;
      }
    }

    .more-btn {
      margin: 55px auto;
      display: flex;
      color: #fff;
      text-align: center;
      font-family: var(--font-hk), "Noto Sans HK", sans-serif;
      font-size: 25px;
      font-style: normal;
      font-weight: 700;
      line-height: 20px;
      letter-spacing: 7.5px;
      background: #4570b6;
      border-radius: 25px;
      padding: 15px 30px 15px 35px;
      width: fit-content;
      border: 0;
      cursor: pointer;
    }
  }

  :global(html[lang="zh-cn"]) .equipment-heading :global(span),
  :global(html[lang="zh-cn"]) .equipment-name-text,
  :global(html[lang="zh-cn"]) .equipment-remark > div,
  :global(html[lang="zh-cn"]) .more-btn {
    font-family: var(--font-sc), "Noto Sans SC", sans-serif;
  }
</style>
