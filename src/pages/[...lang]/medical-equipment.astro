---
/*
 * @Author: Antigravity AI
 * @Date: 2026-11-11
 * @FilePath: /src/pages/[...lang]/medical-equipment.astro
 * @Description: 中心設備專頁 (100% 線上官網逐字與版面還原 + 繁簡雙語 + 共享 .site-container + BreadcrumbList Schema)
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import SchemaBreadcrumb from "@/components/seo/SchemaBreadcrumb.astro";
import { i18nPaths, getLangFromUrl } from "@/i18n/utils";
import {
  EQUIPMENT_ZH_HK,
  EQUIPMENT_ZH_CN,
} from "@/data/equipmentData";

export function getStaticPaths() {
  return [...i18nPaths];
}

const lang = getLangFromUrl(Astro.url);
const isCn = lang === "zh-cn";
const content = isCn ? EQUIPMENT_ZH_CN : EQUIPMENT_ZH_HK;

const breadcrumbItems = [
  { name: content.breadcrumb.home, url: isCn ? "/cn/" : "/" },
  {
    name: content.breadcrumb.current,
    url: isCn ? "/cn/medical-equipment" : "/medical-equipment",
  },
];

const toggleMoreLabel = isCn ? "了解更多" : "了解更多";
---

<BaseLayout tdkKey="equipment">
  <SchemaBreadcrumb items={breadcrumbItems} />

  <div class="equipment">
    {/* 1. 頂部統一橫幅 Banner */}
    <section
      class="page-banner"
      aria-label={content.banner.title}
    >
      <div class="site-container">
        <div
          class="page-banner-card page-banner-card--light"
          style={{
            "--banner-bg-pc": "url('https://statichk.cmermedical.com/smile/bf7a6b723e77c2a8.webp')",
            "--banner-bg-mb": "url('https://statichk.cmermedical.com/imgs/2024/05/b1b778ced1d15d71.png')",
          }}
        >
          <div class="page-banner-content">
            <h1 class="page-banner-title">{content.banner.title}</h1>
            <p class="page-banner-subtitle" set:html={content.banner.subtitleHtml} />
          </div>
        </div>
      </div>
    </section>

    {/* 2. 中心設備展示網格 */}
    <section
      class="equipment-box site-container"
      aria-labelledby="equipment-section-heading"
    >
      <h2 id="equipment-section-heading" class="equipment-heading">
        <span>{content.sectionTitle}</span>
      </h2>

      {/* E1: 分類篩選導航 Chips */}
      <div class="equipment-filter-bar mb-8 md:mb-12" role="toolbar" aria-label="設備分類篩選">
        <div class="filter-chips-container" id="equipment-filters">
          {content.categories.map((cat, idx) => (
            <button
              type="button"
              class:list={["filter-chip", { active: idx === 0 }]}
              data-category={cat.id}
              aria-pressed={idx === 0 ? "true" : "false"}
            >
              <span class="chip-name">{cat.name}</span>
              <span class="chip-count">({cat.count})</span>
            </button>
          ))}
        </div>
      </div>

      {/* E2, E3, E4: 設備網格 */}
      <div class="equipment-items" id="equipment-grid">
        {
          content.items.map((item, index) => (
            <article
              class="equipment-card"
              data-equipment-id={item.id}
              data-category={item.category}
              data-mobile-hidden={index >= 8 ? "true" : "false"}
              tabindex="0"
              role="button"
              aria-expanded="false"
              aria-label={`${item.alt} - ${content.toggleAriaLabel}`}
            >
              <div class="equipment-card-inner">
                {/* E3: Fixed 4:3 Image Container on White Background */}
                <div class="equipment-img-container">
                  <img
                    src={item.img}
                    alt={item.alt}
                    title={item.alt}
                    draggable="false"
                    loading={index < 3 ? "eager" : "lazy"}
                    decoding="async"
                  />
                </div>

                {/* E4: Unified Name Plate inside card */}
                <div class="equipment-name-plate">
                  <div class={`equipment-name-text equipment-${item.id}`}>
                    {item.nameLines.map((line) => (
                      <span set:html={line} />
                    ))}
                  </div>
                </div>

                {/* E2: Excerpt + Expanded details */}
                <div class="equipment-content-body">
                  <div class="equipment-remark-wrap">
                    <p class="equipment-remark-text line-clamp-2">
                      {item.remark}
                    </p>
                    <p class="equipment-source-text hidden">
                      {item.source}
                    </p>
                  </div>
                  <div class="equipment-toggle-indicator">
                    <span class="toggle-text">{toggleMoreLabel}</span>
                    <svg
                      class="toggle-chevron"
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <polyline points="6 9 12 15 18 9" />
                    </svg>
                  </div>
                </div>
              </div>
            </article>
          ))
        }
      </div>

      <button type="button" class="more-btn" id="equipment-more-btn">
        {content.seeAllLabel}
      </button>
    </section>
  </div>
</BaseLayout>

<script>
  function initEquipmentPage() {
    const cards = Array.from(
      document.querySelectorAll<HTMLElement>(".equipment-card")
    );
    const filterChips = Array.from(
      document.querySelectorAll<HTMLButtonElement>(".filter-chip")
    );
    const moreBtn = document.getElementById("equipment-more-btn") as HTMLButtonElement | null;

    let currentCategory = "all";
    let visibleCount = 8;

    function isMobile() {
      return window.innerWidth < 768;
    }

    function updateCardVisibility() {
      const isMob = isMobile();
      let matchingCount = 0;

      cards.forEach((card) => {
        const cat = card.dataset.category;
        const matchesCategory = currentCategory === "all" || cat === currentCategory;

        if (!matchesCategory) {
          card.setAttribute("data-category-hidden", "true");
          card.setAttribute("data-mobile-hidden", "true");
        } else {
          card.removeAttribute("data-category-hidden");
          matchingCount++;
          if (isMob && matchingCount > visibleCount) {
            card.setAttribute("data-mobile-hidden", "true");
          } else {
            card.setAttribute("data-mobile-hidden", "false");
          }
        }
      });

      if (moreBtn) {
        if (!isMob || matchingCount <= visibleCount) {
          moreBtn.style.display = "none";
        } else {
          moreBtn.style.display = "block";
        }
      }
    }

    // Category filter click
    filterChips.forEach((chip) => {
      chip.addEventListener("click", () => {
        const cat = chip.dataset.category || "all";
        if (cat === currentCategory) return;
        currentCategory = cat;
        visibleCount = 8;

        filterChips.forEach((c) => {
          const isActive = c === chip;
          c.classList.toggle("active", isActive);
          c.setAttribute("aria-pressed", String(isActive));
        });

        updateCardVisibility();
      });
    });

    // Mobile "觀看更多" button
    if (moreBtn) {
      moreBtn.addEventListener("click", () => {
        visibleCount += 8;
        updateCardVisibility();
      });
    }

    // Card click & keyboard expand/collapse
    cards.forEach((card) => {
      function toggleCard() {
        const isOpen = card.classList.toggle("is-open");
        card.setAttribute("aria-expanded", String(isOpen));
        const toggleText = card.querySelector<HTMLElement>(".toggle-text");
        if (toggleText) {
          toggleText.textContent = isOpen ? "收起" : "了解更多";
        }
      }

      card.addEventListener("click", () => {
        toggleCard();
      });

      card.addEventListener("keydown", (e: KeyboardEvent) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          toggleCard();
        }
      });
    });

    window.addEventListener("resize", () => {
      updateCardVisibility();
    });

    updateCardVisibility();
  }

  initEquipmentPage();
</script>

<style lang="scss">
  .equipment {
    width: 100%;
    overflow-x: clip;
  }

  .equipment-heading {
    text-align: center;
    position: relative;
    border: none;
    margin: 0 auto 10px;

    &::before {
      content: none;
      border: none;
    }

    :global(span) {
      color: #4570b6;
      font-family: var(--font-hk), "Noto Sans HK", sans-serif;
      font-style: normal;
      font-weight: 500;
    }

    &::after {
      content: "";
      background: #a6e1d6;
      height: 5px;
      border-radius: 3px;
      position: absolute;
      left: 50%;
      bottom: 0;
      transform: translateX(-50%);
    }
  }

  /* E1: Category Filter Chips */
  .equipment-filter-bar {
    width: 100%;
  }

  .filter-chips-container {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin: 0 auto;
    max-width: 1000px;
  }

  .filter-chip {
    padding: 8px 16px;
    border-radius: 9999px;
    font-size: 14px;
    font-weight: 500;
    font-family: var(--font-hk);
    border: 1px solid #d4e4ff;
    background: #fff;
    color: #4570b6;
    cursor: pointer;
    transition: all var(--dur-fast) var(--ease-out);
    display: inline-flex;
    align-items: center;
    gap: 4px;

    .chip-count {
      opacity: 0.8;
      font-size: 13px;
    }

    &:hover {
      background: #f0f6ff;
      border-color: #a8cdff;
    }

    &.active {
      background: #4570b6;
      border-color: #4570b6;
      color: #fff;
      box-shadow: 0 4px 12px rgba(69, 112, 182, 0.25);
    }
  }

  /* E2, E3, E4: Equipment Grid & Cards */
  .equipment-items {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px 14px;
  }

  @media screen and (min-width: 768px) {
    .equipment-items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 32px 24px;
    }
  }

  @media screen and (min-width: 1024px) {
    .equipment-items {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 40px 32px;
    }
  }

  .equipment-card {
    width: 100%;
    border-radius: 20px;
    background: #fff;
    border: 1px solid #e2edfb;
    box-shadow: 0 4px 16px rgba(69, 112, 182, 0.06);
    overflow: hidden;
    cursor: pointer;
    transition: transform var(--dur) var(--ease-out), box-shadow var(--dur) var(--ease-out), border-color var(--dur) var(--ease-out);
    display: flex;
    flex-direction: column;
    outline: none;

    &:hover,
    &:focus-visible {
      transform: translateY(-4px);
      box-shadow: 0 10px 24px rgba(69, 112, 182, 0.12);
      border-color: #a8cdff;
    }

    &:focus-visible {
      box-shadow: 0 0 0 2px #4570b6, 0 10px 24px rgba(69, 112, 182, 0.12);
    }

    &[data-category-hidden="true"] {
      display: none !important;
    }
  }

  .equipment-card-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  /* E3: Fixed 4:3 Image Container */
  .equipment-img-container {
    width: 100%;
    aspect-ratio: 4 / 3;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    box-sizing: border-box;
    border-bottom: 1px solid #f0f4fa;

    img {
      max-width: 100%;
      max-height: 100%;
      width: auto;
      height: auto;
      object-fit: contain;
      transition: transform var(--dur) var(--ease-out);
    }
  }

  .equipment-card:hover .equipment-img-container img {
    transform: scale(1.03);
  }

  /* E4: Unified Name Plate inside card */
  .equipment-name-plate {
    background: #4570b6;
    color: #fff;
    padding: 12px 14px;
    min-height: 72px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  @media screen and (min-width: 768px) {
    .equipment-name-plate {
      min-height: 84px;
      padding: 14px 16px;
    }
  }

  .equipment-name-text {
    font-family: var(--font-hk);
    font-size: 15px;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: 0.5px;
    width: 100%;

    :global(span) {
      display: block;
    }
  }

  @media screen and (min-width: 768px) {
    .equipment-name-text {
      font-size: 18px;
    }
  }

  /* E2: Excerpt + Expanded details */
  .equipment-content-body {
    padding: 16px;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: #fafcff;
  }

  .equipment-remark-wrap {
    margin-bottom: 12px;
  }

  .equipment-remark-text {
    color: var(--color-desc, #515151);
    font-family: var(--font-hk);
    font-size: 13px;
    font-weight: 400;
    line-height: 1.6;
    margin: 0;
    transition: all var(--dur) var(--ease-out);

    &.line-clamp-2 {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  }

  @media screen and (min-width: 768px) {
    .equipment-remark-text {
      font-size: 14px;
      line-height: 1.7;
    }
  }

  .equipment-source-text {
    color: #8c9cb5;
    font-size: 12px;
    margin-top: 8px;
    margin-bottom: 0;
    padding-top: 8px;
    border-top: 1px dashed #dce8f8;
  }

  .equipment-toggle-indicator {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 8px;
    border-top: 1px solid #eef3fb;
    color: #4570b6;
    font-size: 12px;
    font-weight: 600;

    .toggle-chevron {
      transition: transform var(--dur) var(--ease-out);
    }
  }

  /* Expanded State */
  .equipment-card.is-open {
    border-color: #4570b6;
    box-shadow: 0 8px 24px rgba(69, 112, 182, 0.15);

    .equipment-remark-text.line-clamp-2 {
      -webkit-line-clamp: unset;
      display: block;
    }

    .equipment-source-text.hidden {
      display: block;
    }

    .toggle-chevron {
      transform: rotate(180deg);
    }
  }

  @media screen and (min-width: 768px) {
    .equipment-heading {
      padding-bottom: 32px;
      margin-bottom: 10px;

      :global(span) {
        font-size: 30px;
        line-height: 30px;
        letter-spacing: 7.5px;
        padding-left: 5px;
      }

      &::after {
        width: 39px;
      }
    }

    .equipment-box {
      margin-bottom: 160px;
    }

    .more-btn {
      display: none !important;
    }
  }

  @media screen and (max-width: 767px) {
    .equipment-heading {
      display: flex;
      flex-direction: column;
      padding-bottom: 25px;
      margin-bottom: 30px;

      :global(span) {
        text-align: center;
        font-size: 20px;
        line-height: 30px;
        letter-spacing: 5px;
      }

      &::after {
        width: 37px;
      }
    }

    .equipment-items {
      margin-bottom: 35px;
    }

    .equipment-card[data-mobile-hidden="true"] {
      display: none !important;
    }

    .more-btn {
      color: #fff;
      text-align: center;
      font-family: var(--font-hk), "Noto Sans HK", sans-serif;
      font-size: 20px;
      font-style: normal;
      font-weight: 500;
      line-height: 20px;
      letter-spacing: 5px;
      border-radius: 34.5px;
      background: #4570b6;
      border: 0;
      width: 100%;
      max-width: 353px;
      height: 40px;
      margin: 0 auto;
      display: block;
      cursor: pointer;
      box-shadow: 0 4px 12px rgba(69, 112, 182, 0.2);
    }
  }
</style>
