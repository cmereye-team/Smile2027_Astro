import { i18nPaths, getLangFromUrl } from "@/i18n/utils";
import { FEE_ZH_HK, FEE_ZH_CN } from "@/data/feeData";

export function getStaticPaths() {
  return [...i18nPaths];
}

const lang = getLangFromUrl(Astro.url);
const isCn = lang === "zh-cn";
const fee = isCn ? FEE_ZH_CN : FEE_ZH_HK;
