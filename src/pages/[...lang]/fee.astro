  <script>
  function initFeeFilterToggle() {
    const allRadio = document.getElementById("fee-filter-all") as HTMLInputElement | null;
    const scroller = document.querySelector<HTMLElement>(".fee-table1-wrap .smilepro-difference");
    if (!allRadio) return;

    const mobileQuery = window.matchMedia("(max-width: 991px)");
    const filterColMap: Record<string, number> = {
      "fee-filter-pro": 1,
      "fee-filter-icl": 5,
      "fee-filter-laser": 7,
    };

    let momentumRaf: number | null = null;
    const stopMomentum = () => {
      if (momentumRaf !== null) {
        window.cancelAnimationFrame(momentumRaf);
        momentumRaf = null;
      }
    };

    const getActiveFilterId = (): string | null => {
      const checked = document.querySelector<HTMLInputElement>('input[name="fee-filter"]:checked');
      if (!checked || checked.id === "fee-filter-all") return null;
      return checked.id;
    };

    // 切回「全部」時，精準錨定在用戶剛才觀看的分類位置，避免畫面跳回第 1 欄
    const unlockToAllAnchored = (activeId: string): number => {
      if (!scroller) {
        allRadio.checked = true;
        return 0;
      }

      if (activeId === "fee-filter-pro") {
        // SMILE Pro 原本即與全部模式同欄寬，直接保留原 scrollLeft（0px 跳動）
        const prevLeft = scroller.scrollLeft;
        allRadio.checked = true;
        scroller.scrollLeft = prevLeft;
        return prevLeft;
      }

      allRadio.checked = true;
      const maxScroll = Math.max(0, scroller.scrollWidth - scroller.clientWidth);

      if (activeId === "fee-filter-laser") {
        scroller.scrollLeft = maxScroll;
        return maxScroll;
      }

      const colIdx = filterColMap[activeId];
      const headerCells = scroller.querySelectorAll<HTMLTableCellElement>("thead tr th");
      const stickyCell = headerCells[0];
      const targetCell = colIdx !== undefined ? headerCells[colIdx] : undefined;
      if (!stickyCell || !targetCell) return scroller.scrollLeft;

      const stickyRect = stickyCell.getBoundingClientRect();
      const targetRect = targetCell.getBoundingClientRect();
      const rawTarget = scroller.scrollLeft + (targetRect.left - stickyRect.right);
      const anchored = Math.min(maxScroll, Math.max(0, Math.round(rawTarget)));
      scroller.scrollLeft = anchored;
      return anchored;
    };

    document.querySelectorAll<HTMLLabelElement>(".fee-filter-pill").forEach((pill) => {
      if (pill.dataset.bound) return;
      pill.dataset.bound = "true";
      pill.addEventListener("click", (e) => {
        const targetId = pill.getAttribute("for");
        if (!targetId || targetId === "fee-filter-all") return;
        const radio = document.getElementById(targetId) as HTMLInputElement | null;
        if (!radio) return;

        stopMomentum();
        if (radio.checked) {
          e.preventDefault();
          unlockToAllAnchored(targetId);
        } else if (scroller && mobileQuery.matches) {
          window.requestAnimationFrame(() => {
            scroller.scrollLeft = 0;
          });
        }
      });
    });

    if (scroller && !scroller.dataset.swipeBound) {
      scroller.dataset.swipeBound = "true";

      let startX = 0;
      let startY = 0;
      let dragAnchorX = 0;
      let dragBaseLeft = 0;
      let lastX = 0;
      let lastTime = 0;
      let velocity = 0;
      let mode: "undecided" | "vertical" | "manual" | "native" = "undecided";

      scroller.addEventListener(
        "touchstart",
        (e) => {
          stopMomentum();
          mode = "undecided";
          velocity = 0;
          if (!mobileQuery.matches) return;
          const t = e.touches[0];
          if (!t) return;
          startX = t.clientX;
          startY = t.clientY;
          lastX = t.clientX;
          lastTime = performance.now();
        },
        { passive: true },
      );

      scroller.addEventListener(
        "touchmove",
        (e) => {
          if (!mobileQuery.matches || mode === "vertical" || mode === "native") return;
          const t = e.touches[0];
          if (!t) return;

          if (mode === "undecided") {
            const activeId = getActiveFilterId();
            if (!activeId) {
              mode = "native";
              return;
            }
            const dx = t.clientX - startX;
            const dy = t.clientY - startY;
            if (Math.abs(dy) > 10 && Math.abs(dy) >= Math.abs(dx)) {
              mode = "vertical";
              return;
            }
            if (Math.abs(dx) > 12 && Math.abs(dx) > Math.abs(dy) * 1.2) {
              if (activeId === "fee-filter-pro") {
                unlockToAllAnchored(activeId);
                mode = "native";
                return;
              }
              // ICL / SMILE-LASIK 原本為 3 欄滿版無滾動，解鎖同時接管本次拖動與慣性，無需二次滑動
              e.preventDefault();
              dragBaseLeft = unlockToAllAnchored(activeId);
              dragAnchorX = t.clientX;
              lastX = t.clientX;
              lastTime = performance.now();
              velocity = 0;
              mode = "manual";
            }
            return;
          }

          if (mode === "manual") {
            e.preventDefault();
            const now = performance.now();
            const dt = Math.max(1, now - lastTime);
            const maxScroll = Math.max(0, scroller.scrollWidth - scroller.clientWidth);
            const nextLeft = Math.min(maxScroll, Math.max(0, dragBaseLeft - (t.clientX - dragAnchorX)));
            scroller.scrollLeft = nextLeft;
            const instV = (lastX - t.clientX) / dt;
            velocity = velocity * 0.4 + instV * 0.6;
            lastX = t.clientX;
            lastTime = now;
          }
        },
        { passive: false },
      );

      const finishTouch = () => {
        if (mode === "manual" && Math.abs(velocity) > 0.12) {
          let v = Math.max(-2.5, Math.min(2.5, velocity));
          let prev = performance.now();
          const step = (now: number) => {
            const dt = Math.min(32, Math.max(1, now - prev));
            prev = now;
            const maxScroll = Math.max(0, scroller.scrollWidth - scroller.clientWidth);
            const next = scroller.scrollLeft + v * dt;
            if (next <= 0 || next >= maxScroll || Math.abs(v) < 0.03) {
              scroller.scrollLeft = Math.min(maxScroll, Math.max(0, next));
              momentumRaf = null;
              return;
            }
            scroller.scrollLeft = next;
            v *= Math.pow(0.92, dt / 16);
            momentumRaf = window.requestAnimationFrame(step);
          };
          momentumRaf = window.requestAnimationFrame(step);
        }
        mode = "undecided";
      };

      scroller.addEventListener("touchend", finishTouch, { passive: true });
      scroller.addEventListener("touchcancel", finishTouch, { passive: true });

      // 兼顧桌面模擬器觸控板橫向滾輪 / 滾動條拖動
      scroller.addEventListener(
        "wheel",
        (e) => {
          if (!mobileQuery.matches) return;
          const activeId = getActiveFilterId();
          if (!activeId) return;
          if (Math.abs(e.deltaX) > 10 && Math.abs(e.deltaX) > Math.abs(e.deltaY)) {
            const base = unlockToAllAnchored(activeId);
            if (activeId !== "fee-filter-pro") {
              scroller.scrollLeft = base + e.deltaX;
            }
          }
        },
        { passive: true },
      );
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initFeeFilterToggle);
  } else {
    initFeeFilterToggle();
  }
  document.addEventListener("astro:page-load", initFeeFilterToggle);
</script>
</BaseLayout>

