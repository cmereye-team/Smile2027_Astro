/*
 * @Author: Antigravity AI
 * @Date: 2026-11-10
 * @FilePath: /src/pages/[...lang]/fee.astro
 * @Description: 收費詳情頁面 (100% 官方真值對齊 + 居中佈局 + W-14 轉換追蹤 + 完整 Schema)
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import SchemaFeeCatalog from "@/components/seo/SchemaFeeCatalog.astro";
import SchemaBreadcrumb from "@/components/seo/SchemaBreadcrumb.astro";
import { i18nPaths, getLangFromUrl } from "@/i18n/utils";
import { FEE_ZH_HK, FEE_ZH_CN } from "@/data/feeData";

export function getStaticPaths() {
  return [...i18nPaths];
}

const lang = getLangFromUrl(Astro.url);
const isCn = lang === "zh-cn";
const fee = isCn ? FEE_ZH_CN : FEE_ZH_HK;
