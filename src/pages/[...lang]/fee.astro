// 1. 頁內快捷分段導航（激光 / ICL 矯視 vs 老花矯視）
.fee-quick-nav {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
  padding-top: 20px;
  padding-bottom: 12px;

  .fee-quick-link {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 10px 12px;
    border-radius: 10px;
    border: 1.5px solid #4570b6;
    background: #fff;
    color: #4570b6;
    font-family: var(--font-hk), "Noto Sans HK", sans-serif;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.5px;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;

    &.is-active,
    &:hover {
      background: #4570b6;
      color: #fff;
    }
  }

  @media screen and (min-width: 1024px) {
    max-width: 560px;
    gap: 16px;
    padding-top: 32px;
    padding-bottom: 20px;

    .fee-quick-link {
      padding: 12px 24px;
      font-size: 18px;
      border-radius: 12px;
    }
  }
}

// 2. 療程分類篩選藥丸 + 移動端無縫滑動定位（移動端保持 8 欄連續橫滑、零回流切換；PC 端精準聚焦指定欄位）
.fee-table1-wrap {
  .fee-filter-bar {
    display: flex;
    flex-wrap: nowrap;
    justify-content: center;
    gap: 6px;
    padding-top: 4px;
    padding-bottom: 12px;

    @media screen and (min-width: 992px) {
      flex-wrap: wrap;
      gap: 8px;
    }
  }

  .fee-filter-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    padding: 6px 10px;
    border-radius: 999px;
    border: 1px solid #8cb3f3;
    background: #fff;
    color: #4570b6;
    font-family: var(--font-en), var(--font-hk), sans-serif;
    font-size: 12px;
    font-weight: 600;
    line-height: 1.3;
    white-space: nowrap;
    cursor: pointer;
    user-select: none;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;

    &:hover {
      background: #eaf2ff;
    }

    @media screen and (min-width: 992px) {
      padding: 8px 18px;
      font-size: 15px;
    }
  }

  .fee-filter-pill-all {
    display: none;

    @media screen and (min-width: 992px) {
      display: inline-flex;
    }
  }

  .fee-scroll-hint {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin: 0 auto 10px;
    color: #4570b6;
    font-family: var(--font-hk), "Noto Sans HK", sans-serif;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.4;
    opacity: 0.85;

    @media screen and (min-width: 992px) {
      display: none;
    }
  }

  // 選中藥丸高亮（子分類選中時於右側顯示 ×，提示再次點擊或橫滑即可恢復全部）
  &:has(#fee-filter-all:checked) .fee-filter-pill-all,
  &:has(#fee-filter-pro:checked) .fee-filter-pill-pro,
  &:has(#fee-filter-icl:checked) .fee-filter-pill-icl,
  &:has(#fee-filter-laser:checked) .fee-filter-pill-laser {
    background: #4570b6;
    border-color: #4570b6;
    color: #fff;
  }

  &:has(#fee-filter-pro:checked) .fee-filter-pill-pro::after,
  &:has(#fee-filter-icl:checked) .fee-filter-pill-icl::after,
  &:has(#fee-filter-laser:checked) .fee-filter-pill-laser::after {
    content: "×";
    font-size: 14px;
    line-height: 1;
    opacity: 0.9;
  }

  // SMILE Pro (顯示第 2~5 欄，隱藏第 6~9 欄)
  &:has(#fee-filter-pro:checked) .custom-comparison-table {
    tr > :nth-child(n + 6) {
      display: none;
    }
  }

  // ICL (顯示第 6~7 欄，隱藏第 2~5、8~9 欄；移動端 3 欄撐滿寬度方便對比，左右滑動可無縫解鎖回全部)
  &:has(#fee-filter-icl:checked) .custom-comparison-table {
    tr > :nth-child(2),
    tr > :nth-child(3),
    tr > :nth-child(4),
    tr > :nth-child(5),
    tr > :nth-child(8),
    tr > :nth-child(9) {
      display: none;
    }

    @media screen and (max-width: 991px) {
      width: 100%;
      table-layout: fixed;

      thead th:nth-child(1) {
        width: 30%;
        min-width: 0;
        padding: 0 6px;
        box-shadow: none;
      }

      tbody tr > td:nth-child(1) {
        display: table-cell;
        width: 30%;
        min-width: 0;
        padding: 0 6px;
        vertical-align: middle;
        line-height: 1.3;
        box-shadow: none;
      }

      thead th:nth-child(6),
      thead th:nth-child(7),
      tbody td:nth-child(6),
      tbody td:nth-child(7) {
        width: 35%;
        min-width: 0;
      }
    }
  }

  // SMILE / LASIK (顯示第 8~9 欄，隱藏第 2~7 欄；移動端 3 欄撐滿寬度方便對比，左右滑動可無縫解鎖回全部)
  &:has(#fee-filter-laser:checked) .custom-comparison-table {
    tr > :nth-child(2),
    tr > :nth-child(3),
    tr > :nth-child(4),
    tr > :nth-child(5),
    tr > :nth-child(6),
    tr > :nth-child(7) {
