---
/**
 * @FilePath: /src/pages/[...lang]/FreQuestions.astro
 * @Description: 常見問題 FAQ 專頁 (100% 官方真值對齊 + 繁簡雙語 + 原生 details/summary 手風琴 + 雙軌結構化數據 SchemaFAQ & Microdata)
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import SchemaBreadcrumb from "@/components/seo/SchemaBreadcrumb.astro";
import SchemaFAQ from "@/components/seo/SchemaFAQ.astro";
import { i18nPaths, getLangFromUrl } from "@/i18n/utils";
import { FAQ_ZH_HK, FAQ_ZH_CN } from "@/data/faqData";

export function getStaticPaths() {
  return [...i18nPaths];
}

const currentLang = getLangFromUrl(Astro.url);
const isCn = currentLang === "zh-cn";
const content = isCn ? FAQ_ZH_CN : FAQ_ZH_HK;

// 匯總全站 39 條常見問題作為 Schema.org FAQPage 結構化數據 (保留現有 FAQPage ld+json 不變)
const allSchemaFaqs = content.sections.flatMap((section) =>
  section.items.map((item) => ({
    question: item.title,
    answer: item.content.replace(/<[^>]+>/g, " ").replace(/\s+/g, " ").trim(),
  }))
);

const breadcrumbItems = [
  { name: content.breadcrumb.home, url: isCn ? "/cn/" : "/" },
  { name: content.breadcrumb.faq, url: isCn ? "/cn/FreQuestions" : "/FreQuestions" },
];

const faqQuickLinks = [
  { id: "faq-smile", label: "SMILE" },
  { id: "faq-lasik", label: "LASIK" },
  { id: "faq-icl", label: "ICL" },
  { id: "faq-presbyopia", label: isCn ? "老花矫视" : "老花矯視" },
];
---

<BaseLayout tdkKey="faq">
  <SchemaBreadcrumb items={breadcrumbItems} />
  <SchemaFAQ faqs={allSchemaFaqs} />

  <!-- 無障礙唯一 H1 標題 (SEO 標準地標) -->
  <h1 class="sr-only">{content.h1}</h1>

  <div class="questions site-container">
    <nav
      class="faq-quick-nav"
      aria-label={isCn ? "常见问题分类导航" : "常見問題分類導航"}
    >
      <ul>
        {
          faqQuickLinks.map((link, index) => (
            <li class={index === 0 ? "active" : ""} data-faq-tab={link.id}>
              <a href={`#${link.id}`}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    {
      content.sections.map((section) => (
        <section id={section.id} class="faq-section" aria-labelledby={`title-${section.id}`}>
          <h2 id={`title-${section.id}`} class="section-title">
            {section.title}
          </h2>

          <div class="faq-accordion-list">
            {section.items.map((item, index) => {
              const isOpen = index === 0;
              return (
                <details
                  name={section.id}
                  class="faq-item"
                  open={isOpen}
                  itemscope
                  itemtype="https://schema.org/Question"
                >
                  <summary class="faq-header">
                    <div class="faq-header-text" itemprop="name">{item.title}</div>
                    <span class="faq-toggle-indicator" aria-hidden="true" />
                  </summary>
                  <div
                    class="faq-content"
                    itemscope
                    itemprop="acceptedAnswer"
                    itemtype="https://schema.org/Answer"
                  >
                    <div class="faq-answer" itemprop="text" set:html={item.content} />
                  </div>
                </details>
              );
            })}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>

<script>
  const faqTabs = Array.from(
    document.querySelectorAll<HTMLLIElement>(".faq-quick-nav li[data-faq-tab]")
  );
  const setActiveFaq = (id: string) => {
    faqTabs.forEach((li) =>
      li.classList.toggle("active", li.dataset.faqTab === id)
    );
  };
  const syncFaqFromHash = () => {
    const h = window.location.hash.slice(1);
    if (faqTabs.some((li) => li.dataset.faqTab === h)) setActiveFaq(h);
  };
  syncFaqFromHash();
  window.addEventListener("hashchange", syncFaqFromHash);

  faqTabs.forEach((li) => {
    li.querySelector("a")?.addEventListener("click", (e) => {
      const id = li.dataset.faqTab;
      const target = id ? document.getElementById(id) : null;
      if (!id || !target) return;
      e.preventDefault();
      setActiveFaq(id);
      const reduced = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;
      target.scrollIntoView({ behavior: reduced ? "auto" : "smooth" });
      history.replaceState(null, "", `${window.location.pathname}#${id}`);
    });
  });

  if (faqTabs.length && "IntersectionObserver" in window) {
    const idMap = new Map<Element, string>();
    faqTabs.forEach((li) => {
      const id = li.dataset.faqTab;
      const el = id ? document.getElementById(id) : null;
      if (el && id) idMap.set(el, id);
    });
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const tabId = idMap.get(entry.target);
          if (entry.isIntersecting && tabId) setActiveFaq(tabId);
        }
      },
      { rootMargin: "-25% 0px -65% 0px" }
    );
    idMap.forEach((_, el) => io.observe(el));
  }
</script>

<style lang="scss">
  :root {
    interpolate-size: allow-keywords;
  }

  .questions {
    padding-top: 50px;
    margin-bottom: 80px;

    & > section {
      padding-top: 60px;
      scroll-margin-top: 195px;

      &:first-of-type {
        padding-top: 10px;
      }
    }
  }

  .faq-quick-nav {
    position: sticky;
    top: 112px;
    z-index: 9;
    padding: 8px 0 12px;
    margin-bottom: 24px;
    background: #fff;

    ul {
      display: flex;
      border: 1px solid #4570b6;
      width: fit-content;
      padding-inline: 0;
      margin: 0 auto;
      list-style: none;
      background: #fff;

      li {
        a {
          display: block;
          width: clamp(140px, 14vw, 240px);
          padding: clamp(12px, 1.1vw, 18px) 0;
          text-align: center;
          box-sizing: border-box;
          color: #4570b6;
          font-family: var(--font-hk), "Noto Sans HK", sans-serif;
          font-size: clamp(14px, 1.35vw, 22px);
          font-style: normal;
          font-weight: 500;
          line-height: 1;
          letter-spacing: clamp(2px, 0.25vw, 4px);
          background: #fff;
          text-decoration: none;
          transition:
            background-color var(--dur-fast) var(--ease-out),
            color var(--dur-fast) var(--ease-out);
        }

        & + li a {
          border-left: 1px solid #4570b6;
        }

        &.active a {
          font-weight: 900;
          color: #fff;
          background: #4570b6;
        }
      }
    }
  }

  /* FAQ 區塊標題與手風琴樣式已統一提取至 src/styles/comm.css */

  /* 移動端響應式斷點 (≤ 768px) */
  @media screen and (max-width: 768px) {
    .questions {
      padding-top: 25px;
      margin-bottom: 10vw;

      & > section {
        padding-top: 40px;
        scroll-margin-top: 130px;

        &:first-of-type {
          padding-top: 0;
        }
      }
    }

    .faq-quick-nav {
      top: 72px;
      margin-bottom: 20px;

      ul {
        width: 100%;

        li {
          flex: 1 1 0;

          a {
            width: 100%;
            padding: 10px 4px;
            font-size: 14px;
            letter-spacing: 0.05em;
          }
        }
      }
    }
  }
</style>
