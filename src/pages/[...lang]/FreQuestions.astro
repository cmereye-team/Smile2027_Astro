---
/**
 * @FilePath: /src/pages/[...lang]/FreQuestions.astro
 * @Description: 常見問題 FAQ 專頁 (100% 官方真值對齊 + 繁簡雙語 + 原生 details/summary 手風琴 + 雙軌結構化數據 SchemaFAQ & Microdata)
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import SchemaBreadcrumb from "@/components/seo/SchemaBreadcrumb.astro";
import SchemaFAQ from "@/components/seo/SchemaFAQ.astro";
import { i18nPaths, getLangFromUrl } from "@/i18n/utils";
import { FAQ_ZH_HK, FAQ_ZH_CN } from "@/data/faqData";

export function getStaticPaths() {
  return [...i18nPaths];
}

const currentLang = getLangFromUrl(Astro.url);
const isCn = currentLang === "zh-cn";
const content = isCn ? FAQ_ZH_CN : FAQ_ZH_HK;

// 匯總全站 39 條常見問題作為 Schema.org FAQPage 結構化數據 (保留現有 FAQPage ld+json 不變)
const allSchemaFaqs = content.sections.flatMap((section) =>
  section.items.map((item) => ({
    question: item.title,
    answer: item.content.replace(/<[^>]+>/g, " ").replace(/\s+/g, " ").trim(),
  }))
);

const breadcrumbItems = [
  { name: content.breadcrumb.home, url: isCn ? "/cn/" : "/" },
  { name: content.breadcrumb.faq, url: isCn ? "/cn/FreQuestions" : "/FreQuestions" },
];
---

<BaseLayout tdkKey="faq">
  <SchemaBreadcrumb items={breadcrumbItems} />
  <SchemaFAQ faqs={allSchemaFaqs} />

  <!-- 無障礙唯一 H1 標題 (SEO 標準地標) -->
  <h1 class="sr-only">{content.h1}</h1>

  <div class="questions site-container">
    {
      content.sections.map((section) => (
        <section id={section.id} class="faq-section" aria-labelledby={`title-${section.id}`}>
          <h2 id={`title-${section.id}`} class="section-title">
            {section.title}
          </h2>

          <div class="faq-accordion-list">
            {section.items.map((item, index) => {
              const isOpen = index === 0;
              return (
                <details
                  name={section.id}
                  class="faq-item"
                  open={isOpen}
                  itemscope
                  itemtype="https://schema.org/Question"
                >
                  <summary class="faq-header">
                    <div class="faq-header-text" itemprop="name">{item.title}</div>
                    <span class="faq-toggle-indicator" aria-hidden="true" />
                  </summary>
                  <div
                    class="faq-content"
                    itemscope
                    itemprop="acceptedAnswer"
                    itemtype="https://schema.org/Answer"
                  >
                    <div class="faq-answer" itemprop="text" set:html={item.content} />
                  </div>
                </details>
              );
            })}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style lang="scss">
  :root {
    interpolate-size: allow-keywords;
  }

  .questions {
    padding-top: 50px;
    margin-bottom: 80px;

    & > section {
      padding-top: 60px;
      scroll-margin-top: 130px;

      &:first-of-type {
        padding-top: 10px;
      }
    }
  }

  /* 區塊標題 H2 樣式 (純淨語意 Heading，無巢狀 span，底線裝飾收斂至 ::after) */
  .section-title {
    position: relative;
    text-align: center;
    border: none;
    padding-bottom: 32px;
    margin-bottom: 20px;
    color: #4570b6;
    font-family: var(--font-hk), "Noto Sans HK", sans-serif;
    font-size: 30px;
    font-style: normal;
    font-weight: 500;
    line-height: 30px;
    letter-spacing: 7.5px;
    padding-left: 5px;

    &::after {
      content: "";
      background: #a6e1d6;
      width: 39px;
      height: 5px;
      border-radius: 3px;
      position: absolute;
      left: 50%;
      bottom: 0;
      transform: translateX(-50%);
    }
  }

  /* 手風琴折疊外框 */
  .faq-accordion-list {
    border-top: 1px solid #ebeef5;
  }

  .faq-item {
    border-bottom: 1px solid #ebeef5;
    font-size: 20px;
    line-height: 35px;

    /* 原生 details 平滑展開高度動畫 (支援現代瀏覽器 ::details-content 規範，0 JS) */
    &::details-content {
      opacity: 0;
      block-size: 0;
      overflow: clip;
      transition: content-visibility var(--dur-slow) allow-discrete,
                  opacity var(--dur) var(--ease-out),
                  block-size var(--dur-slow) var(--ease-out);
    }

    &[open]::details-content {
      opacity: 1;
      block-size: auto;
    }
  }

  /* 手風琴標題 summary 原生重設與標題樣式 */
  summary.faq-header {
    width: 100%;
    display: block;
    text-align: left;
    background: transparent;
    border: none;
    cursor: pointer;
    box-sizing: border-box;
    padding: 20px 80px 20px 60px;
    position: relative;
    list-style: none;
    transition: background-color var(--dur) var(--ease-out), color var(--dur) var(--ease-out);

    &::-webkit-details-marker {
      display: none;
    }

    &::marker {
      display: none;
    }

    .faq-header-text {
      font-weight: 800;
      letter-spacing: 3px;
      background-image: linear-gradient(to top, #81dbec, #4570b6);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      color: #4570b6;
    }

    /* 左側 Q 圖標：全域統一左側內嵌距離 (28px)，尺寸與回答正文字體大小一致 (20px) */
    &::before {
      position: absolute;
      content: "";
      background-image: url("/images/faq/icon-q-inactive.png");
      background-repeat: no-repeat;
      background-size: contain;
      left: 28px;
      top: 50%;
      transform: translateY(-50%);
      display: inline-block;
      font-size: 20px;
      height: 20px;
      width: 20px;
      pointer-events: none;
    }
  }

  /* 右側原生純 CSS 兩條槓動畫加減號指示器 (0 JS) */
  .faq-toggle-indicator {
    position: absolute;
    right: 28px;
    top: 50%;
    transform: translateY(-50%);
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;

    /* 橫槓 (Horizontal bar) */
    &::before {
      content: "";
      position: absolute;
      width: 16px;
      height: 2px;
      border-radius: 1px;
      background-color: #4570b6;
      transition: transform var(--dur) var(--ease-out),
                  background-color var(--dur) var(--ease-out);
    }

    /* 直槓 (Vertical bar) */
    &::after {
      content: "";
      position: absolute;
      width: 2px;
      height: 16px;
      border-radius: 1px;
      background-color: #4570b6;
      transition: transform var(--dur) var(--ease-out),
                  opacity var(--dur) var(--ease-out),
                  background-color var(--dur) var(--ease-out);
    }
  }

  /* 展開中 (Active / details[open]) 狀態 */
  .faq-item[open] > summary.faq-header {
    background-color: #4570b6;
    background-image: linear-gradient(to top, #4570b6, #4570b6);

    .faq-header-text {
      -webkit-text-fill-color: #fff;
      color: #fff;
    }

    /* 左側展開中 Q 圖標 (純白)，保持與收起行完全相同 28px 內距，舒適合度 */
    &::before {
      background-image: url("/images/faq/icon-q-active.png");
    }

    /* 右側加號旋轉過渡轉為純白減號 (橫槓保持，直槓旋轉 90 度並淡出) */
    .faq-toggle-indicator {
      &::before {
        background-color: #ffffff;
        transform: rotate(180deg);
      }

      &::after {
        background-color: #ffffff;
        transform: rotate(90deg);
        opacity: 0;
      }
    }
  }

  /* 手風琴內容展開區 */
  .faq-content {
    box-sizing: border-box;
  }

  /* 優雅降級：對不支援 ::details-content 的瀏覽器提供內容淡入過渡 */
  @keyframes faqReveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .faq-item[open] .faq-content {
    animation: faqReveal var(--dur) var(--ease-out);
  }

  .faq-answer {
    color: #6d6e71;
    font-weight: 300;
    letter-spacing: 3px;
    padding: 20px 40px 20px 60px;

    /* set:html 富文本高亮 span 樣式遵循全域 :global 規範 */
    :global(span) {
      color: #4570b6;
      font-weight: bold;
    }
  }

  /* 移動端響應式斷點 (≤ 768px) */
  @media screen and (max-width: 768px) {
    .questions {
      padding-top: 25px;
      margin-bottom: 10vw;

      & > section {
        padding-top: 40px;
        scroll-margin-top: 90px;

        &:first-of-type {
          padding-top: 0;
        }
      }
    }

    .section-title {
      display: flex;
      flex-direction: column;
      align-items: center;
      padding-bottom: 25px;
      font-size: 20px;
      letter-spacing: 5px;
      padding-left: 0;

      &::after {
        width: 37px;
        height: 5px;
      }
    }

    .faq-item {
      font-size: 14px;
      line-height: 24px;
    }

    summary.faq-header {
      padding: 14px 45px 14px 40px;

      .faq-header-text {
        font-weight: 700;
      }

      &::before {
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 14px;
        height: 14px;
        width: 14px;
      }
    }

    .faq-toggle-indicator {
      right: 14px;
      width: 20px;
      height: 20px;

      &::before {
        width: 13px;
        height: 2px;
      }

      &::after {
        width: 2px;
        height: 13px;
      }
    }

    .faq-answer {
      letter-spacing: 0.05em;
      padding: 15px 15px 15px 40px;
    }
  }
</style>
