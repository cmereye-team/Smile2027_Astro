      & > .CorrectedVisionBefore-Process-item:nth-child(1),
      & > .CorrectedVisionBefore-Process-item:nth-child(3) {
        &::after {
          content: "";
          width: 16px;
          height: 1px;
          background: #4570b6;
          position: absolute;
          top: 50%;
          transform: translateY(-50%);
          left: 100%;
          z-index: -1;
