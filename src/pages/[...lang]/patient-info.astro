---
/*
 * @Author: Antigravity AI
 * @Date: 2026-11-11
 * @FilePath: /src/pages/[...lang]/patient-info.astro
 * @Description: 診症須知專頁 (100% 線上真值對齊 + W-16 轉換追蹤 + #PreCorrection 錨點 + BreadcrumbList Schema)
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import SchemaBreadcrumb from "@/components/seo/SchemaBreadcrumb.astro";
import { i18nPaths, getLangFromUrl } from "@/i18n/utils";
import {
  PATIENT_INFO_ZH_HK,
  PATIENT_INFO_ZH_CN,
} from "@/data/patientInfoData";

export function getStaticPaths() {
  return [...i18nPaths];
}

const lang = getLangFromUrl(Astro.url);
const isCn = lang === "zh-cn";
const content = isCn ? PATIENT_INFO_ZH_CN : PATIENT_INFO_ZH_HK;
---

<BaseLayout tdkKey="patientInfo">
  <SchemaBreadcrumb
    items={[
      { name: content.breadcrumb.home, url: isCn ? "/cn/" : "/" },
      {
        name: content.breadcrumb.current,
        url: isCn ? "/cn/patient-info" : "/patient-info",
      },
    ]}
  />

  <div class="patient-info font-hk text-desc relative overflow-x-clip">
    {/* 1. 頂部橫幅 Hero Banner */}
    <div class="site-container smile-NewBanner position-relative">
      <img
        draggable="false"
        decoding="async"
        src={content.banner.imgPc}
        alt=""
        loading="eager"
        fetchpriority="high"
        width="100%"
        height="100%"
        srcset={`${content.banner.imgMb} 400w, ${content.banner.imgMb} 640w, ${content.banner.imgPc}`}
        sizes="(max-width: 992px) 100vw, 1216px"
      />
      <div class="smile-NewBanner-Title">
        <span set:html={content.banner.tagHtml} />
        <h1>{content.banner.title}</h1>
      </div>
    </div>

    {/* 2. 麵包屑導航 */}
    <nav
      class="site-container menu-breadcrumb"
      aria-label={isCn ? "面包屑导航" : "麵包屑導航"}
    >
      <a href={isCn ? "/cn/" : "/"}>{content.breadcrumb.home} &gt; </a>
      <a href={isCn ? "/cn/patient-info" : "/patient-info"}
        >{content.breadcrumb.current}</a
      >
    </nav>

    {/* 3. 章節吸頂導航 Tabs */}
    <nav
      class="navgation-link"
      aria-label={isCn ? "诊症须知章节导航" : "診症須知章節導航"}
    >
      <ul class="site-container">
        {
          content.tabs.map((tab, index) => (
            <li class={index === 0 ? "active" : ""} data-tab-id={tab.id}>
              <a href={`#${tab.id}`}>{tab.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    {/* 4. 眼睛檢查及矯視前 */}
    <section
      class="check-eye"
      id="beforeJiaoShi"
      aria-labelledby="check-eye-heading"
    >
      <div class="site-container">
        <div class="check-eye-title mx-auto">
          <h2 id="check-eye-heading">{content.checkEye.title}</h2>
          <p
            class="check-eye-title-subtitle"
            set:html={content.checkEye.subtitleHtml}
          />
          <p class="check-eye-title-date">{content.checkEye.dateLabel}</p>
        </div>
        <ul class="check-eye-list d-flex flex-wrap">
          {
            content.checkEye.images.map((src) => (
              <li>
                <img
                  src={src}
                  alt=""
                  draggable="false"
                  loading="eager"
                  decoding="async"
                />
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {/* 5. 矯視前停con知多啲 + 矯視前檢查流程 (#PreCorrection) */}
    <section
      class="CorrectedVisionBefore site-container"
      aria-labelledby="stop-con-heading"
    >
      <div class="CorrectedVisionBefore-iframe">
        <img
          src={content.correctedVisionBefore.icon}
          alt=""
          draggable="false"
          loading="lazy"
          decoding="async"
        />
        <h2 id="stop-con-heading">
          {content.correctedVisionBefore.iframeTitle}
        </h2>
        <div class="iframe-container">
          <iframe
            src={content.correctedVisionBefore.iframeSrc}
            title="YouTube video player"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
          />
        </div>
      </div>

      <div class="pt-8 lg:pt-15" id="PreCorrection">
        <h2 class="CorrectedVisionBefore-Process-title">
          {content.correctedVisionBefore.processTitle}
        </h2>
        <div class="CorrectedVisionBefore-Process">
          {
            content.correctedVisionBefore.steps.map((step) => (
              <div class="CorrectedVisionBefore-Process-item">
                <img
                  class="CorrectedVisionBefore-Process-item-content"
                  src={step.img}
                  alt=""
                  draggable="false"
                  loading="lazy"
                  decoding="async"
                />
                <p set:html={step.textHtml} />
                <img
                  class="CorrectedVisionBefore-Process-item-icon"
                  src={step.icon}
                  alt=""
                  draggable="false"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            ))
          }
        </div>
      </div>

      <img
        class="CorrectedVisionBefore-line"
        src={content.correctedVisionBefore.lineImg}
        alt=""
        draggable="false"
        loading="lazy"
        decoding="async"
      />

      {/* 合適 / 不合適 */}
      <div class="CorrectedVisionBefore-suitable">
        <div>
          <h3>{content.correctedVisionBefore.suitable.unsuitableTitle}</h3>
          <p>{content.correctedVisionBefore.suitable.unsuitableDesc}</p>
        </div>
        <div>
          <h3>{content.correctedVisionBefore.suitable.suitableTitle}</h3>
          <p>{content.correctedVisionBefore.suitable.suitableDesc}</p>
        </div>
      </div>

      {/* WhatsApp 預約矯視前檢查按鈕 (W-16) */}
      <div class="CorrectedVisionBefore-button">
        <a
          href={content.correctedVisionBefore.cta.whatsappUrl}
          rel="noopener noreferrer"
          target="_blank"
          data-cta="whatsapp-w16"
        >
          <span>{content.correctedVisionBefore.cta.text}</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="30"
            height="29"
            viewBox="0 0 30 29"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M3.19922 26.0597L25.8278 3.43115"
              stroke="#ffffff"
              stroke-width="5.4"
              stroke-linecap="round"
            />
            <path
              d="M6.49609 2.71118H26.5987V22.1512"
              stroke="#ffffff"
              stroke-width="4.86"
              stroke-linecap="round"
            />
          </svg>
        </a>
      </div>

      {/* 備註 */}
      <div class="CorrectedVisionBefore-note">
        <h3>{content.correctedVisionBefore.notes.title}</h3>
        {
          content.correctedVisionBefore.notes.items.map((note) => (
            <p>
              <i>{note.num}</i>
              <span set:html={note.html} />
            </p>
          ))
        }
      </div>
    </section>

    {/* 6. 矯視流程 (#inJiaoShi) */}
    <section
      class="visionProcess"
      id="inJiaoShi"
      aria-labelledby="vision-process-heading"
    >
      <div class="site-container">
        <h2 id="vision-process-heading">{content.visionProcess.title}</h2>
        <p class="visionProcess-subtitle">{content.visionProcess.subtitle}</p>
        <div class="visionProcess_Plc">
          <ul>
            {
              content.visionProcess.steps.map((s) => (
                <li>
                  <h3>{s.step}</h3>
                  <i aria-hidden="true" />
                  <p set:html={s.labelHtml} />
                </li>
              ))
            }
          </ul>
        </div>

        {/* 矯視當日注意事項 */}
        <div class="visionProcess-Notice">
          <img
            src={content.visionProcess.noticeIcon}
            alt=""
            draggable="false"
            loading="lazy"
            decoding="async"
          />
          <h2>{content.visionProcess.noticeTitle}</h2>
          {
            content.visionProcess.cards.map((card) => (
              <div class={`visionProcess-Notice-Card ${card.extraClass || ""}`}>
                <h3>{card.title}</h3>
                <ul>
                  {card.items.map((item) => (
                    <li>
                      <img
                        src={item.img}
                        alt=""
                        draggable="false"
                        loading="lazy"
                        decoding="async"
                      />
                      <p set:html={item.textHtml} />
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* 7. 矯視後覆診與護理 (#afterJiaoShi) */}
    <section
      class="section-last"
      id="afterJiaoShi"
      aria-labelledby="after-jiaoshi-heading"
    >
      <div class="site-container">
        <div class="section-last-1">
          <h2 id="after-jiaoshi-heading">{content.afterJiaoShi.title}</h2>
          <ul>
            {
              content.afterJiaoShi.followUpItems.map((item) => (
                <li>
                  <div>
                    <img
                      src={item.img}
                      alt={item.alt}
                      draggable="false"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <p>{item.label}</p>
                  {item.note && <span>{item.note}</span>}
                </li>
              ))
            }
          </ul>
        </div>

        <div class="section-last-2">
          <p>
            <span>{content.afterJiaoShi.noteTitle}</span> <br />
            <i>*</i>
            {content.afterJiaoShi.noteText}
          </p>
          <h2>{content.afterJiaoShi.careVideoTitle}</h2>
          <div class="iframe-container">
            <iframe
              src={content.afterJiaoShi.careVideoSrc}
              title="YouTube video player"
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen
            />
          </div>
        </div>

        <div class="section-last-3">
          <img
            src={content.afterJiaoShi.careIcon}
            alt=""
            draggable="false"
            loading="lazy"
            decoding="async"
          />
          <h2>{content.afterJiaoShi.careTitle}</h2>
        </div>

        <div class="section-last-4">
          {
            content.afterJiaoShi.careCards.map((card) => (
              <div class="section-last-4-item">
                <h3>{card.title}</h3>
                <div class="section-last-4-item-content">
                  {card.groups.map((group) => (
                    <div class="section-last-4-item-content-text">
                      <h4 set:html={group.titleHtml} />
                      <div>
                        {group.items.map((item) => (
                          <p>
                            <i>{item.num}</i>
                            <span>{item.text}</span>
                          </p>
                        ))}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            ))
          }
        </div>

        <p class="section-last-5">{content.afterJiaoShi.emergencyNote}</p>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const tabs = Array.from(
    document.querySelectorAll<HTMLLIElement>(".navgation-link li[data-tab-id]")
  );
  const setActive = (id: string) => {
    tabs.forEach((li) => li.classList.toggle("active", li.dataset.tabId === id));
  };
  const syncFromHash = () => {
    const h = window.location.hash.slice(1);
    if (tabs.some((li) => li.dataset.tabId === h)) setActive(h);
    else if (h === "PreCorrection") setActive("beforeJiaoShi");
  };
  syncFromHash();
  window.addEventListener("hashchange", syncFromHash);

  tabs.forEach((li) => {
    li.querySelector("a")?.addEventListener("click", (e) => {
      const id = li.dataset.tabId;
      const target = id ? document.getElementById(id) : null;
      if (!id || !target) return;
      e.preventDefault();
      setActive(id);
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      target.scrollIntoView({ behavior: reduced ? "auto" : "smooth" });
      history.replaceState(null, "", `${window.location.pathname}#${id}`);
    });
  });

  const sections: Array<[Element | null, string]> = [
    [document.getElementById("beforeJiaoShi"), "beforeJiaoShi"],
    [document.querySelector(".CorrectedVisionBefore"), "beforeJiaoShi"],
    [document.getElementById("inJiaoShi"), "inJiaoShi"],
    [document.getElementById("afterJiaoShi"), "afterJiaoShi"],
  ];
  if (tabs.length && "IntersectionObserver" in window) {
    const idMap = new Map(sections.filter(([el]) => el) as Array<[Element, string]>);
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const tabId = idMap.get(entry.target);
          if (entry.isIntersecting && tabId) setActive(tabId);
        }
      },
      { rootMargin: "-25% 0px -65% 0px" }
    );
    idMap.forEach((_, el) => io.observe(el));
  }
</script>

<style lang="scss">
  :global(html) {
    scroll-behavior: smooth;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }
  }

  .patient-info {
    background: #fff;

    :global(.d-none) {
      display: none;
    }

    i {
      font-style: normal;
    }
  }

  /* 移動端樣式 (< 992px) */
  @media screen and (max-width: 991px) {
    .smile-NewBanner {
      padding: 0 3.85vw;
      height: 62.56vw;
      position: relative;

      img {
        width: 46.92vw;
        height: auto;
        position: absolute;
        top: 25.64vw;
        right: 3.08vw;
      }

      .smile-NewBanner-Title {
        position: absolute;
        top: 10vw;
        left: 28px;

        :global(span),
        span {
          font-style: normal;
          color: #4570b6;
          font-family: "Poppins", var(--font-en), sans-serif;
          font-size: 11.67vw;
          font-weight: 700;
          line-height: 12.74vw;
          display: block;
        }

        h1 {
          color: #4570b6;
          font-family: "Noto Sans TC", var(--font-hk), sans-serif;
          font-size: 6.28vw;
          font-style: normal;
          font-weight: 400;
          line-height: 109.4%;
        }
      }
    }

    /* 麵包屑 */
    .menu-breadcrumb {
      padding-left: 28px;

      a {
        color: #6d6e71;
        font-family: "Noto Sans TC", var(--font-hk), sans-serif;
        font-size: 3.08vw;
        font-style: normal;
        font-weight: 300;
        line-height: 362.5%;
        letter-spacing: 0.09vw;
        text-decoration: none;
      }

      & > a:last-child {
        color: #4570b6;
        font-weight: 500;
      }
    }

    /* 錨鏈接導航 */
    .navgation-link {
      position: sticky;
      top: 72px;
      opacity: 1;
      z-index: 9;

      ul {
        display: flex;
        border: 1px solid #4570b6;
        width: fit-content;
        padding-inline: 0;

        li {
          a {
            display: block;
            width: 32vw;
            text-align: center;
            box-sizing: border-box;
            color: #4570b6;
            font-family: "Noto Sans TC", var(--font-hk), sans-serif;
            font-size: 5.13vw;
            font-style: normal;
            font-weight: 400;
            line-height: 2;
            background: #fff;
            text-decoration: none;
          }
        }

        & > li:nth-child(2) a {
          border-left: 0.26vw solid #4570b6;
          border-right: 0.26vw solid #4570b6;
        }

        .active {
          a {
            font-weight: 900;
            color: #fff;
            background: #4570b6;
          }
        }
      }
    }

    [id="beforeJiaoShi"],
    [id="PreCorrection"],
    [id="inJiaoShi"],
    [id="afterJiaoShi"] {
      scroll-margin-top: calc(72px + 10.26vw + 2px);
    }

    /* 眼睛檢查及矯視前 */
    .check-eye {
      padding-top: 6.41vw;
      padding-bottom: 17.18vw;

      .check-eye-title {
        max-width: 84.62vw;
        text-align: center;

        h2 {
          margin-bottom: 0;
          color: #4570b6;
          font-family: "Noto Sans TC", var(--font-hk), sans-serif;
          font-size: 5.13vw;
          font-style: normal;
          font-weight: 900;
          line-height: 195%;
        }

        .check-eye-title-subtitle {
          margin-top: 2.82vw;
          margin-bottom: 7.69vw;
          color: #6d6e71;
          font-family: "Noto Sans HK", var(--font-hk), sans-serif;
          font-size: 3.59vw;
          font-style: normal;
          font-weight: 300;
          line-height: 250%;
          letter-spacing: 1.08vw;
        }

        .check-eye-title-date {
          color: #4570b6;
          font-family: "Noto Sans HK", var(--font-hk), sans-serif;
          font-size: 3.59vw;
          font-style: normal;
          font-weight: 700;
          line-height: 2.5;
          letter-spacing: 1.08vw;
        }
      }

      .check-eye-list {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        margin-top: 5.64vw;
        gap: 6.15vw 5.64vw;

        li {
          display: flex;
          justify-content: center;
          align-items: center;
          background: #fff;
          width: 39.49vw;
          height: 39.49vw;
          flex-shrink: 0;
          border-radius: 50%;
          border: 0.5px solid #4570b6;

          img {
            width: 35.64vw;
            height: auto;
          }
        }

        li:nth-child(even) {
          transform: translateY(7.69vw);
        }
      }
    }

    /* 矯視前停 con 知多啲 */
    .CorrectedVisionBefore {
      padding-top: 5.9vw;
      padding-bottom: 30px;

      .CorrectedVisionBefore-iframe {
        img {
          width: 11.79vw;
          height: 12.31vw;
          margin: 0 auto;
        }

        h2 {
          width: fit-content;
          margin: 2.05vw auto 4.36vw;
          color: #4570b6;
          font-family: "Noto Sans TC", var(--font-hk), sans-serif;
          font-size: 5.13vw;
          font-style: normal;
          font-weight: 900;
          line-height: 103.173%;
          letter-spacing: 0.51vw;
          position: relative;

          &::before {
            content: "";
            width: 8.72vw;
            height: 6.15vw;
            background: url("https://statichk.cmermedical.com/smile/patient-info/title-left.svg")
              no-repeat;
            background-size: 100% auto;
            position: absolute;
            left: -9.23vw;
            bottom: -1.03vw;
          }

          &::after {
            content: "";
            width: 8.72vw;
            height: 6.15vw;
            background: url("https://statichk.cmermedical.com/smile/patient-info/title-right.svg")
              no-repeat;
            background-size: 100% auto;
            position: absolute;
            right: -9.23vw;
            bottom: -1.03vw !important;
          }
        }

        .iframe-container {
          width: 100%;
          aspect-ratio: 560 / 315;

          iframe {
            width: 100%;
            height: 100%;
            border: none;
          }
        }
      }

      .CorrectedVisionBefore-Process-title {
        width: fit-content;
        margin: 5.05vw auto 6.36vw;
        color: #4570b6;
        font-family: "Noto Sans TC", var(--font-hk), sans-serif;
        font-size: 5.13vw;
        font-style: normal;
        font-weight: 900;
        line-height: 103.173%;
        letter-spacing: 0.51vw;
        position: relative;
      }

      .CorrectedVisionBefore-Process {
        margin-top: 8.97vw;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 10.26vw 4.1vw;

        .CorrectedVisionBefore-Process-item {
          position: relative;
          width: 41.28vw;
          height: 32.82vw;
          display: flex;
          flex-direction: column;
          align-items: center;
          justify-content: space-evenly;

          p {
            color: #4570b6;
            text-align: center;
            font-family: "Noto Sans TC", var(--font-hk), sans-serif;
            font-size: 3.59vw;
            font-style: normal;
            font-weight: 500;
            line-height: 121.429%;
          }

          .CorrectedVisionBefore-Process-item-icon {
            position: absolute;
            width: 11.28vw;
            left: 2.56vw;
            top: -3.59vw;
          }
        }

        & > .CorrectedVisionBefore-Process-item:nth-child(1),
        & > .CorrectedVisionBefore-Process-item:nth-child(3) {
          &::after {
            content: "";
            width: 4.1vw;
            height: 0.13vw;
            background: #4570b6;
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            right: -4.1vw;
            z-index: -1;
          }
        }

        & > .CorrectedVisionBefore-Process-item:nth-child(1) {
          background: url("https://statichk.cmermedical.com/smile/patient-info/CorrectedVisionBefore-Process-bg1.avif")
            no-repeat center;
          background-size: 100% auto;

          .CorrectedVisionBefore-Process-item-content {
            width: 13.08vw;
            height: auto;
          }
        }

        & > .CorrectedVisionBefore-Process-item:nth-child(2) {
          background: url("https://statichk.cmermedical.com/smile/patient-info/CorrectedVisionBefore-Process-bg2.avif")
            no-repeat center;
          background-size: 100% auto;

          .CorrectedVisionBefore-Process-item-content {
            width: 12.31vw;
            height: auto;
          }

          &::after {
            content: "";
            width: 0.13vw;
            height: 10.26vw;
            background: #4570b6;
            position: absolute;
            left: 50%;
            transform: translateX(-50%);
            bottom: -10.26vw;
            z-index: -1;
          }
        }

        & > .CorrectedVisionBefore-Process-item:nth-child(3) {
          background: url("https://statichk.cmermedical.com/smile/patient-info/CorrectedVisionBefore-Process-bg3.avif")
            no-repeat center;
          background-size: 100% auto;

          .CorrectedVisionBefore-Process-item-content {
            width: 17.44vw;
            height: auto;
          }
        }

        & > .CorrectedVisionBefore-Process-item:nth-child(4) {
          background: url("https://statichk.cmermedical.com/smile/patient-info/CorrectedVisionBefore-Process-bg4.avif")
            no-repeat center;
