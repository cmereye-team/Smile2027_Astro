    .CorrectedVisionBefore-suitable {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      width: 100%;
      margin: 0 0 32px;
      border: 1px solid #4471b7;

      & > div:nth-child(2) {
