        .CorrectedVisionBefore-Process-item-content {
          width: 64px;
          height: auto;
        }
      }

      & > .CorrectedVisionBefore-Process-item:nth-child(4) {
        background: url("https://statichk.cmermedical.com/smile/patient-info/CorrectedVisionBefore-Process-bg4.avif")
          no-repeat center;
