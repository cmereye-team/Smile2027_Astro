---
/*
 * @Author: Antigravity AI
 * @Date: 2026-11-11
 * @FilePath: /src/pages/[...lang]/patient-info.astro
 * @Description: 診症須知專頁 (100% 線上真值對齊 + W-16 轉換追蹤 + #PreCorrection 錨點 + BreadcrumbList Schema)
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import SchemaBreadcrumb from "@/components/seo/SchemaBreadcrumb.astro";
import { i18nPaths, getLangFromUrl } from "@/i18n/utils";
import {
  PATIENT_INFO_ZH_HK,
  PATIENT_INFO_ZH_CN,
} from "@/data/patientInfoData";

export function getStaticPaths() {
  return [...i18nPaths];
}

const lang = getLangFromUrl(Astro.url);
const isCn = lang === "zh-cn";
const content = isCn ? PATIENT_INFO_ZH_CN : PATIENT_INFO_ZH_HK;
---

<BaseLayout tdkKey="patientInfo">
  <SchemaBreadcrumb
    items={[
      { name: content.breadcrumb.home, url: isCn ? "/cn/" : "/" },
      {
        name: content.breadcrumb.current,
        url: isCn ? "/cn/patient-info" : "/patient-info",
      },
    ]}
  />

  <div class="patient-info font-hk text-desc relative overflow-x-clip">
    {/* 1. 頂部橫幅 Hero Banner + 麵包屑 */}
    <section class="patient-hero" aria-label={content.banner.title}>
      <div class="site-container">
        <div class="smile-NewBanner">
          <img
            draggable="false"
            decoding="async"
            src={content.banner.imgPc}
            alt={content.banner.title}
            title={content.banner.title}
            loading="eager"
            fetchpriority="high"
            width="388"
            height="377"
            srcset={`${content.banner.imgMb} 400w, ${content.banner.imgMb} 640w, ${content.banner.imgPc}`}
            sizes="(max-width: 991px) 45vw, 250px"
          />
          <div class="smile-NewBanner-Title">
            <span set:html={content.banner.tagHtml} />
            <h1>{content.banner.title}</h1>
          </div>
        </div>
      </div>

      {/* 2. 麵包屑導航 */}
      <nav
        class="site-container menu-breadcrumb"
        aria-label={isCn ? "面包屑导航" : "麵包屑導航"}
      >
        <a href={isCn ? "/cn/" : "/"} title={content.breadcrumb.home}>{content.breadcrumb.home} &gt; </a>
        <a href={isCn ? "/cn/patient-info" : "/patient-info"} title={content.breadcrumb.current}
          >{content.breadcrumb.current}</a
        >
      </nav>
    </section>

    {/* 3. 章節吸頂導航 Tabs */}
    <nav
      class="navgation-link"
      aria-label={isCn ? "诊症须知章节导航" : "診症須知章節導航"}
    >
      <div class="site-container">
        <ul>
          {
            content.tabs.map((tab, index) => (
              <li class={index === 0 ? "active" : ""} data-tab-id={tab.id}>
                <a href={`#${tab.id}`} title={tab.label}>{tab.label}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </nav>

    {/* 4. 眼睛檢查及矯視前 */}
    <section
      class="check-eye"
      id="beforeJiaoShi"
      aria-labelledby="check-eye-heading"
    >
      <div class="site-container">
        <div class="check-eye-title">
          <h2 id="check-eye-heading" class="typo-section-title">{content.checkEye.title}</h2>
          <p
            class="check-eye-title-subtitle typo-body"
            set:html={content.checkEye.subtitleHtml}
          />
          <p class="check-eye-title-date typo-body">{content.checkEye.dateLabel}</p>
        </div>
        <ul class="check-eye-list">
          {
            content.checkEye.images.map((src, idx) => (
              <li>
                <img
                  src={src}
                  alt={`${content.tabs[0].label} (${idx + 1})`}
                  title={`${content.tabs[0].label} (${idx + 1})`}
                  draggable="false"
                  loading="eager"
                  decoding="async"
                />
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {/* 5. 矯視前停con知多啲 + 矯視前檢查流程 (#PreCorrection) */}
    <section
      class="CorrectedVisionBefore site-container"
      aria-labelledby="stop-con-heading"
    >
      <div class="CorrectedVisionBefore-iframe">
        <img
          src={content.correctedVisionBefore.icon}
          alt={content.correctedVisionBefore.iframeTitle}
          title={content.correctedVisionBefore.iframeTitle}
          draggable="false"
          loading="lazy"
          decoding="async"
        />
        <h2 id="stop-con-heading" class="typo-section-title">
          {content.correctedVisionBefore.iframeTitle}
        </h2>
        <div class="iframe-container">
          <iframe
            src={content.correctedVisionBefore.iframeSrc}
            title="YouTube video player"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
          />
        </div>
      </div>

      <div class="pre-correction-block" id="PreCorrection">
        <h2 class="CorrectedVisionBefore-Process-title typo-section-title">
          {content.correctedVisionBefore.processTitle}
        </h2>
        <div class="CorrectedVisionBefore-Process">
          {
            content.correctedVisionBefore.steps.map((step) => {
              const stepLabel = step.textHtml.replace(/<[^>]+>/g, " ").replace(/\s+/g, " ").trim();
              return (
                <div class="CorrectedVisionBefore-Process-item">
                  <img
                    class="CorrectedVisionBefore-Process-item-content"
                    src={step.img}
                    alt={stepLabel}
                    title={stepLabel}
                    draggable="false"
                    loading="lazy"
                    decoding="async"
                  />
                  <p class="typo-list-text" set:html={step.textHtml} />
                  <img
                    class="CorrectedVisionBefore-Process-item-icon"
                    src={step.icon}
                    alt={stepLabel}
                    title={stepLabel}
                    aria-hidden="true"
                    draggable="false"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              );
            })
          }
        </div>
      </div>

      <img
        class="CorrectedVisionBefore-line"
        src={content.correctedVisionBefore.lineImg}
        alt={content.correctedVisionBefore.processTitle}
        title={content.correctedVisionBefore.processTitle}
        aria-hidden="true"
        draggable="false"
        loading="lazy"
        decoding="async"
      />

      {/* 合適 / 不合適 */}
      <div class="CorrectedVisionBefore-suitable">
        <div>
          <h3 class="typo-card-title">{content.correctedVisionBefore.suitable.unsuitableTitle}</h3>
          <p class="typo-body">{content.correctedVisionBefore.suitable.unsuitableDesc}</p>
        </div>
        <div>
          <h3 class="typo-card-title">{content.correctedVisionBefore.suitable.suitableTitle}</h3>
          <p class="typo-body">{content.correctedVisionBefore.suitable.suitableDesc}</p>
        </div>
      </div>

      {/* WhatsApp 預約矯視前檢查按鈕 (W-16) */}
      <div class="CorrectedVisionBefore-button">
        <a
          href={content.correctedVisionBefore.cta.whatsappUrl}
          rel="noopener noreferrer"
          target="_blank"
          data-cta="whatsapp-w16"
          title={content.correctedVisionBefore.cta.text}
        >
          <span>{content.correctedVisionBefore.cta.text}</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="30"
            height="29"
            viewBox="0 0 30 29"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M3.19922 26.0597L25.8278 3.43115"
              stroke="#ffffff"
              stroke-width="5.4"
              stroke-linecap="round"
            />
            <path
              d="M6.49609 2.71118H26.5987V22.1512"
              stroke="#ffffff"
              stroke-width="4.86"
              stroke-linecap="round"
            />
          </svg>
        </a>
      </div>

      {/* 備註 */}
      <div class="CorrectedVisionBefore-note">
        <h3 class="typo-card-title">{content.correctedVisionBefore.notes.title}</h3>
        {
          content.correctedVisionBefore.notes.items.map((note) => (
            <p class="typo-body">
              <i>{note.num}</i>
              <span set:html={note.html} />
            </p>
          ))
        }
      </div>
    </section>

    {/* 6. 矯視流程 (#inJiaoShi) */}
    <section
      class="visionProcess"
      id="inJiaoShi"
      aria-labelledby="vision-process-heading"
    >
      <div class="site-container">
        <h2 id="vision-process-heading" class="typo-section-title">{content.visionProcess.title}</h2>
        <p class="visionProcess-subtitle typo-body">{content.visionProcess.subtitle}</p>
        <div class="visionProcess_Plc">
          <ul>
            {
              content.visionProcess.steps.map((s) => (
                <li>
                  <h3 class="typo-card-title">{s.step}</h3>
                  <i aria-hidden="true" />
                  <p class="typo-list-text" set:html={s.labelHtml} />
                </li>
              ))
            }
          </ul>
        </div>

        {/* 矯視當日注意事項 */}
        <div class="visionProcess-Notice">
          <img
            src={content.visionProcess.noticeIcon}
            alt={content.visionProcess.noticeTitle}
            title={content.visionProcess.noticeTitle}
            draggable="false"
            loading="lazy"
            decoding="async"
          />
          <h2 class="typo-section-title">{content.visionProcess.noticeTitle}</h2>
          {
            content.visionProcess.cards.map((card) => (
              <div class={`visionProcess-Notice-Card ${card.extraClass || ""}`}>
                <h3 class="typo-card-title">{card.title}</h3>
                <ul>
                  {card.items.map((item) => {
                    const noticeItemText = item.textHtml.replace(/<[^>]+>/g, " ").replace(/\s+/g, " ").trim();
                    return (
                      <li>
                        <img
                          src={item.img}
                          alt={noticeItemText}
                          title={noticeItemText}
                          draggable="false"
                          loading="lazy"
                          decoding="async"
                        />
                        <p class="typo-list-text" set:html={item.textHtml} />
                      </li>
                    );
                  })}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* 7. 矯視後覆診與護理 (#afterJiaoShi) */}
    <section
      class="section-last"
      id="afterJiaoShi"
      aria-labelledby="after-jiaoshi-heading"
    >
      <div class="site-container">
        <div class="section-last-1">
          <h2 id="after-jiaoshi-heading" class="typo-section-title">{content.afterJiaoShi.title}</h2>
          <ul>
            {
              content.afterJiaoShi.followUpItems.map((item) => (
                <li>
                  <div>
                    <img
                      src={item.img}
                      alt={item.alt}
                      title={item.alt || item.label}
                      draggable="false"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <p class="typo-list-text">{item.label}</p>
                  {item.note && <span class="follow-up-note">{item.note}</span>}
                </li>
              ))
            }
          </ul>
        </div>

        <div class="section-last-2">
          <p class="typo-body">
            <span>{content.afterJiaoShi.noteTitle}</span> <br />
            <i>*</i>
            {content.afterJiaoShi.noteText}
          </p>
          <h2 class="typo-section-title">{content.afterJiaoShi.careVideoTitle}</h2>
          <div class="iframe-container">
            <iframe
              src={content.afterJiaoShi.careVideoSrc}
              title="YouTube video player"
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen
            />
          </div>
        </div>

        <div class="section-last-3">
          <img
            src={content.afterJiaoShi.careIcon}
            alt={content.afterJiaoShi.careTitle}
            title={content.afterJiaoShi.careTitle}
            draggable="false"
            loading="lazy"
            decoding="async"
          />
          <h2 class="typo-section-title">{content.afterJiaoShi.careTitle}</h2>
        </div>

        <div class="section-last-4">
          {
            content.afterJiaoShi.careCards.map((card) => (
              <div class="section-last-4-item">
                <h3 class="typo-card-title">{card.title}</h3>
                <div class="section-last-4-item-content">
                  {card.groups.map((group) => (
                    <div class="section-last-4-item-content-text">
                      <h4 class="typo-card-title" set:html={group.titleHtml} />
                      <div>
                        {group.items.map((item) => (
                          <p class="typo-list-text">
                            <i>{item.num}</i>
                            <span>{item.text}</span>
                          </p>
                        ))}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            ))
          }
        </div>

        <p class="section-last-5 typo-body">{content.afterJiaoShi.emergencyNote}</p>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const tabs = Array.from(
    document.querySelectorAll<HTMLLIElement>(".navgation-link li[data-tab-id]")
  );
  const headerEl = document.getElementById("site-header");
  const tabNavEl = document.querySelector<HTMLElement>(".navgation-link");
  const rootEl = document.documentElement;

  const getCompactHeaderHeight = () => {
    if (window.innerWidth >= 1024) return 116;
    if (!headerEl) return 55;
    return headerEl.classList.contains("is-compact")
      ? Math.round(headerEl.getBoundingClientRect().height)
      : 55;
  };

  const updateStickyAndScrollMargin = () => {
    const liveHeaderH = headerEl ? Math.round(headerEl.getBoundingClientRect().height) : 116;
    const compactHeaderH = getCompactHeaderHeight();
    const tabH = tabNavEl ? Math.round(tabNavEl.getBoundingClientRect().height) : 58;
    rootEl.style.setProperty("--patient-sticky-top", `${liveHeaderH}px`);
    rootEl.style.setProperty("--patient-scroll-margin", `${compactHeaderH + tabH + 28}px`);
  };

  updateStickyAndScrollMargin();
  if ("ResizeObserver" in window) {
    const ro = new ResizeObserver(updateStickyAndScrollMargin);
    if (headerEl) ro.observe(headerEl);
    if (tabNavEl) ro.observe(tabNavEl);
  }
  window.addEventListener("resize", updateStickyAndScrollMargin, { passive: true });
  window.addEventListener("scroll", updateStickyAndScrollMargin, { passive: true });

  const setActive = (id: string) => {
    tabs.forEach((li) => li.classList.toggle("active", li.dataset.tabId === id));
  };
  const syncFromHash = () => {
    const h = window.location.hash.slice(1);
    if (tabs.some((li) => li.dataset.tabId === h)) setActive(h);
    else if (h === "PreCorrection") setActive("beforeJiaoShi");
  };
  syncFromHash();
  window.addEventListener("hashchange", syncFromHash);

  tabs.forEach((li) => {
    li.querySelector("a")?.addEventListener("click", (e) => {
      const id = li.dataset.tabId;
      const target = id ? document.getElementById(id) : null;
      if (!id || !target) return;
      e.preventDefault();
      setActive(id);

      const compactHeaderH = getCompactHeaderHeight();
      const liveHeaderH = headerEl ? Math.round(headerEl.getBoundingClientRect().height) : compactHeaderH;
      const tabH = tabNavEl ? Math.round(tabNavEl.getBoundingClientRect().height) : 58;
      const shrinkDiff =
        window.scrollY <= 50 && headerEl && !headerEl.classList.contains("is-compact")
          ? Math.max(0, liveHeaderH - compactHeaderH)
          : 0;

      const clearance = 28;
      const totalMargin = compactHeaderH + tabH + clearance;
      const targetDocTop = target.getBoundingClientRect().top + window.scrollY - shrinkDiff;
      const destination = Math.max(0, Math.round(targetDocTop - totalMargin));

      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      window.scrollTo({
        top: destination,
        behavior: reduced ? "auto" : "smooth",
      });
      history.replaceState(null, "", `${window.location.pathname}#${id}`);
    });
  });

  const sections: Array<[Element | null, string]> = [
    [document.getElementById("beforeJiaoShi"), "beforeJiaoShi"],
    [document.querySelector(".CorrectedVisionBefore"), "beforeJiaoShi"],
    [document.getElementById("inJiaoShi"), "inJiaoShi"],
    [document.getElementById("afterJiaoShi"), "afterJiaoShi"],
  ];
  if (tabs.length && "IntersectionObserver" in window) {
    const idMap = new Map(sections.filter(([el]) => el) as Array<[Element, string]>);
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const tabId = idMap.get(entry.target);
          if (entry.isIntersecting && tabId) setActive(tabId);
        }
      },
      { rootMargin: "-25% 0px -65% 0px" }
    );
    idMap.forEach((_, el) => io.observe(el));
  }
</script>

<style lang="scss">
  :global(html) {
    scroll-behavior: smooth;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }
  }

  .patient-info {
    background: #fff;

    :global(.d-none) {
      display: none;
    }

    i {
      font-style: normal;
    }
  }

  /* 錨點跳轉偏移 (header + sticky tab bar + 16px) */
  [id="beforeJiaoShi"],
  [id="PreCorrection"],
  [id="inJiaoShi"],
  [id="afterJiaoShi"] {
    scroll-margin-top: var(--patient-scroll-margin, 120px);
  }

  /* 1. 頂部橫幅 + 麵包屑 (對齊 .site-container 左邊線) */
  .patient-hero {
    padding-top: var(--banner-space);
  }

  .smile-NewBanner {
    position: relative;
    width: 100%;
    height: clamp(170px, 46vw, 220px);
    overflow: hidden;

    img {
      position: absolute;
      top: 50%;
      right: 0;
      transform: translateY(-50%);
      width: clamp(120px, 34vw, 175px);
      height: auto;
      aspect-ratio: 388 / 377;
      object-fit: cover;
      pointer-events: none;
    }

    .smile-NewBanner-Title {
      position: relative;
      z-index: 1;
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: center;
      left: 0;

      :global(span),
      span {
        font-style: normal;
        color: #4570b6;
        font-family: var(--font-en), "Poppins", sans-serif;
        font-size: clamp(32px, 9.5vw, 48px);
        font-weight: 700;
        line-height: 1.08;
        display: block;
      }

      h1 {
        color: #4570b6;
        font-family: var(--font-hk), "Noto Sans HK", sans-serif;
        font-size: clamp(22px, 5.8vw, 30px);
        font-style: normal;
        font-weight: 400;
        line-height: 1.15;
        margin: 4px 0 0;
      }
    }
  }

  .menu-breadcrumb {
    margin-top: 8px;

    a {
      color: #6d6e71;
      font-family: var(--font-hk), "Noto Sans HK", sans-serif;
      font-size: 13px;
      font-style: normal;
      font-weight: 300;
      line-height: 1.8;
      letter-spacing: 0.04em;
      text-decoration: none;
    }

    & > a:last-child {
      color: #4570b6;
      font-weight: 500;
    }
  }

  /* 2. 吸頂章節導航 Tabs (滿版對齊 .site-container，精簡高度 ~56-64px) */
  .navgation-link {
    position: sticky;
    top: var(--patient-sticky-top, 55px);
    z-index: 9;
    background: #fff;
    margin-top: 16px;
    margin-bottom: 16px;

    ul {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      width: 100%;
      border: 1px solid #4570b6;
      padding: 0;
      margin: 0;
      list-style: none;

      li {
        a {
          display: flex;
          align-items: center;
          justify-content: center;
          width: 100%;
          padding: 10px 4px;
          text-align: center;
          box-sizing: border-box;
          color: #4570b6;
          font-family: var(--font-hk), "Noto Sans HK", sans-serif;
          font-size: 16px;
          font-style: normal;
          font-weight: 400;
          line-height: 1.4;
          background: #fff;
          text-decoration: none;
          transition: background-color var(--dur-fast) var(--ease-out),
            color var(--dur-fast) var(--ease-out);
        }
      }

      & > li:nth-child(2) a {
        border-left: 1px solid #4570b6;
        border-right: 1px solid #4570b6;
      }

      .active {
        a {
          font-weight: 900;
          color: #fff;
          background: #4570b6;
        }
      }
    }
  }

  /* 3. 眼睛檢查及矯視前 */
  .check-eye {
    padding-top: 40px;
    padding-bottom: 0;

    .check-eye-title {
      width: 100%;
      text-align: center;

      h2 {
        margin: 0;
      }

      .check-eye-title-subtitle {
        margin-top: 16px;
        margin-bottom: 20px;
      }

      .check-eye-title-date {
        color: #4570b6;
        font-weight: 700;
        margin: 0;
      }
    }

    .check-eye-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
      margin-top: 28px;
      padding: 0;
      list-style: none;

      li {
        display: flex;
        justify-content: center;
        align-items: center;
        background: #fff;
        width: 100%;
        aspect-ratio: 1 / 1;
        border-radius: 50%;
        border: 1px solid #4570b6;

        img {
          width: 86%;
          height: auto;
        }
      }
    }
  }

  /* 4. 矯視前停 con 知多啲 + 檢查流程 */
  .CorrectedVisionBefore {
    padding-top: 48px;
    padding-bottom: 48px;

    .CorrectedVisionBefore-iframe {
      & > img {
        width: 48px;
        height: 50px;
        margin: 0 auto;
      }

      h2 {
        width: fit-content;
        margin: 12px auto 28px;
        position: relative;

        &::before,
        &::after {
          content: "";
          width: 32px;
          height: 22px;
          background-repeat: no-repeat;
          background-size: 100% auto;
          position: absolute;
          bottom: -2px;
        }

        &::before {
          background-image: url("https://statichk.cmermedical.com/smile/patient-info/title-left.svg");
          left: -38px;
        }

        &::after {
          background-image: url("https://statichk.cmermedical.com/smile/patient-info/title-right.svg");
          right: -38px;
        }
      }

      .iframe-container {
        width: 100%;
        max-width: 880px;
        margin-inline: auto;
        aspect-ratio: 16 / 9;

        iframe {
          width: 100%;
          height: 100%;
          border: none;
        }
      }
    }

    .pre-correction-block {
