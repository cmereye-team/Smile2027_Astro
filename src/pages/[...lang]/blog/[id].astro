---
/*
 * @FilePath: /src/pages/[...lang]/blog/[id].astro
 * @Description: 眼科科普文章詳情路由 (/blog/[id] 及 /cn/blog/[id])
 */
import BlogArticleView from "@/components/views/BlogArticleView.astro";
import { getLangFromUrl } from "@/i18n/utils";

export async function getStaticPaths() {
  const hkIdSet = new Set<string>(["161", "162", "169"]);
  const cnIdSet = new Set<string>(["178", "179", "166"]);

  async function collectIds(endpoint: string, target: Set<string>) {
    try {
      const response = await fetch(endpoint, { signal: AbortSignal.timeout(8000) });
      if (response.ok) {
        const json = await response.json();
        if (Array.isArray(json?.data)) {
          for (const item of json.data) {
            if (item?.id !== undefined && item?.id !== null) {
              target.add(String(item.id));
            }
          }
        }
      }
    } catch {
      // 構建期離線或遠端超時時回退至已知文章 ID 列表
    }
  }

  await Promise.all([
    collectIds("https://admin.hkcmereye.com/api.php/list/32", hkIdSet),
    collectIds("https://admin.hkcmereye.com/api.php/list/35", cnIdSet),
  ]);

  async function fetchArticle(id: string) {
    try {
      const response = await fetch(
        `https://admin.hkcmereye.com/api.php/content/${encodeURIComponent(id)}`,
        { signal: AbortSignal.timeout(8000) }
      );
      if (response.ok) {
        const json = await response.json();
        if (json && json.code !== 0 && json.data && typeof json.data === "object") {
          return json.data;
        }
      }
    } catch {
      // 構建期超時則交由客戶端降級載入
    }
    return null;
  }

  const paths: Array<{
    params: { lang: string | undefined; id: string };
    props: { initialArticle: Record<string, unknown> | null };
  }> = [];

  for (const id of hkIdSet) {
    paths.push({
      params: { lang: undefined, id },
      props: { initialArticle: await fetchArticle(id) },
    });
  }
  for (const id of cnIdSet) {
    paths.push({
      params: { lang: "cn", id },
      props: { initialArticle: await fetchArticle(id) },
    });
  }
  return paths;
}

const lang = getLangFromUrl(Astro.url);
const isCn = lang === "zh-cn";
const idParam = Astro.params.id || "";
const { initialArticle = null } = Astro.props;
---

<BlogArticleView isCn={isCn} idParam={idParam} initialArticle={initialArticle} />
