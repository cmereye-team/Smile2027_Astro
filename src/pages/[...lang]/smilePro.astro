---
/*
 * @Author: Antigravity AI
 * @Date: 2026-11-09
 * @FilePath: /src/pages/[...lang]/smilePro.astro
 * @Description: SMILE Pro 2.0 微笑激光矯視 (100% 原版真值對齊 + 零 CLS + 完整 Schema & W-05 埋點)
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import SchemaProcedure from "@/components/seo/SchemaProcedure.astro";
import SchemaBreadcrumb from "@/components/seo/SchemaBreadcrumb.astro";
import UserShare from "@/components/views/UserShare.astro";
import VideoFacade from "@/components/common/VideoFacade.astro";
import { i18nPaths, getLangFromUrl, getLocalizedHref } from "@/i18n/utils";
import {
  SMILE_PRO_ZH_HK,
  SMILE_PRO_ZH_CN,
  SMILE_PRO_SHARE_DATA,
} from "@/data/smileProData";

export function getStaticPaths() {
  return [...i18nPaths];
}

const lang = getLangFromUrl(Astro.url);
const isCn = lang === "zh-cn";
const content = isCn ? SMILE_PRO_ZH_CN : SMILE_PRO_ZH_HK;

// WhatsApp 官方 W-05 轉換埋點 (嚴格遵循 docs/WHATSAPP_TRACKING_MATRIX.md)
const bannerWhatsappUrl =
  "https://api.whatsapp.com/send/?phone=85269408569&text=%E6%88%91%E6%83%B3%E9%A0%90%E7%B4%84(W-05)%20SMILE%20Pro%E7%9F%AF%E8%A6%96%E8%A1%93%E5%89%8D%E6%AA%A2%E6%9F%A5%E5%8F%8A%E8%AB%AE%E8%A9%A2%E5%86%AC%E6%97%A5%E5%84%AA%E6%83%A0";
const whatsappUrl =
  "https://api.whatsapp.com/send/?phone=85269408569&text=%E6%88%91%E6%83%B3%E9%A0%90%E7%B4%84(W-05)%20SMILE%20Pro%E7%9F%AF%E8%A6%96%E8%A1%93%E5%89%8D%E6%AA%A2%E6%9F%A5%E5%8F%8A%E8%AB%AE%E8%A9%A2";

const feeUrl = getLocalizedHref("/fee#table1", lang);
const careUrl = getLocalizedHref("/smileProCare", lang);
const smallTitleLines = content.fourFeature.smallTitle.split("\n");
const userRatingSlides = [...content.userRating.list, ...content.userRating.list];
---

<BaseLayout tdkKey="smilepro">
  <SchemaProcedure
    name={content.summary.titlePrefix + " " + content.summary.titleStrong}
    description={content.summary.p1.text1 +
      content.summary.p1.strong1 +
      content.summary.p1.text2 +
      content.summary.p1.strong2 +
      content.summary.p1.text3}
  />
  {/* 蔡司官方認證醫療設備結構化數據 (EEAT & GEO 實體圖譜增強) */}
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "MedicalDevice",
      "name": "ZEISS VISUMAX 800",
      "alternateName": ["VISUMAX 800", "SMILE Pro 2.0 激光矯視系統"],
      "description": isCn
        ? "蔡司下一代飞秒激光屈光手术系统，支持 SMILE® Pro 2.0 矫视，具备虹膜辨识与 CentraLign / OcuLign 自动散光轴向校正技术。"
        : "蔡司下一代飛秒激光屈光手術系統，支援 SMILE® Pro 2.0 矯視，具備虹膜辨識與 CentraLign / OcuLign 自動散光軸向校正技術。",
      "manufacturer": {
        "@type": "MedicalOrganization",
        "name": "Carl Zeiss Meditec AG",
        "alternateName": "蔡司醫療科技",
        "url": "https://www.zeiss.com/meditec/en/home.html",
        "sameAs": [
          "https://www.zeiss.com.hk/",
          "https://en.wikipedia.org/wiki/Carl_Zeiss_AG",
          "https://www.wikidata.org/wiki/Q282186"
        ]
      },
      "url": "https://www.zeiss.com/meditec/en/products/refractive-lasers/visumax-800.html",
      "recognizingAuthority": {
        "@type": "Organization",
        "name": isCn ? "蔡司官方认证伙伴" : "蔡司官方認證夥伴"
      }
    })}
  />
  <SchemaBreadcrumb
    items={[
      { name: content.breadcrumb.home, url: isCn ? "/cn/" : "/" },
      {
        name: content.breadcrumb.service,
        url: isCn ? "/cn/smilePro" : "/smilePro",
      },
      {
        name: content.breadcrumb.current,
        url: isCn ? "/cn/smilePro" : "/smilePro",
      },
    ]}
  />

  <div class="page-smilepro font-hk text-desc">
    {/* Section 0: 頂部通告橫幅 (平滑跳轉至收費價目表) */}
    <div class="notice site-container mb-2 lg:mb-3">
      <a
        href="#price"
        class="rounded-lg overflow-hidden flex relative min-h-[52px] md:h-auto"
        title="查看 SMILE Pro 最新收費禮遇"
        aria-label="查看 SMILE Pro 最新收費禮遇"
      >
        <picture class="w-full">
          <source
            media="(min-width: 768px)"
            srcset={content.banner.noticeImgPc}
          />
          <img draggable="false"
            src={content.banner.noticeImgMb}
            alt="冬日限定"
            title="冬日限定"
            width="1240"
            height="80"
            loading="eager"
            fetchpriority="high"
            class="h-full lg:h-auto w-full object-cover"
          />
        </picture>
        {/* 移動端滾動字幕 */}
        <div
          class="flex md:hidden absolute top-0 left-0 w-full h-full overflow-hidden items-center pointer-events-none"
        >
          <div class="marquee-wrapper relative flex w-full h-full overflow-hidden">
            <div class="marquee-content flex items-center shrink-0">
              <img draggable="false"
                src={content.banner.noticeMarqueeImg}
                class="h-full w-auto object-contain pr-8"
                alt="立即了解SMILE/SMILE PRO 1.0&2.0 微笑激光矯視"
                title="立即了解SMILE/SMILE PRO 1.0&2.0 微笑激光矯視"
                width="280"
                height="52"
              />
              <img draggable="false"
                src={content.banner.noticeMarqueeImg}
                class="h-full w-auto object-contain pr-8"
                alt="立即了解SMILE/SMILE PRO 1.0&2.0 微笑激光矯視"
                title="立即了解SMILE/SMILE PRO 1.0&2.0 微笑激光矯視"
                width="280"
                height="52"
              />
            </div>
            <div class="marquee-content flex items-center shrink-0">
              <img draggable="false"
                src={content.banner.noticeMarqueeImg}
                class="h-full w-auto object-contain pr-8"
                alt="立即了解SMILE/SMILE PRO 1.0&2.0 微笑激光矯視"
                title="立即了解SMILE/SMILE PRO 1.0&2.0 微笑激光矯視"
                width="280"
                height="52"
              />
              <img draggable="false"
                src={content.banner.noticeMarqueeImg}
                class="h-full w-auto object-contain pr-8"
                alt="立即了解SMILE/SMILE PRO 1.0&2.0 微笑激光矯視"
                title="立即了解SMILE/SMILE PRO 1.0&2.0 微笑激光矯視"
                width="280"
                height="52"
              />
            </div>
          </div>
        </div>
      </a>
    </div>

    {/* Section 1: 首屏視覺大圖與適應症提示 (Hero Banner) */}
    <div
      class="smile-NewBanner site-container relative pb-8 md:pb-0"
    >
      <a
        href={bannerWhatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-cta="whatsapp"
        class="block"
        title="WhatsApp 諮詢 SMILE Pro 微笑矯視"
        aria-label="WhatsApp 諮詢 SMILE Pro 微笑矯視"
      >
        <picture class="w-full">
          <source
            media="(min-width: 768px)"
            srcset={content.banner.heroImgPc}
          />
          <img draggable="false"
            src={content.banner.heroImgMb}
            alt={content.banner.heroAlt}
            title={content.banner.heroTitle}
            width="1940"
            height="647"
            loading="eager"
            fetchpriority="high"
            class="hero-banner-img w-full rounded-lg"
          />
        </picture>
      </a>

      {/* 矯視度數範圍浮動標籤 (Tip) */}
      <div class="smile-NewBanner-Tip" aria-label="可矯正範圍">
        <div class="smile-NewBanner-Tip-Title">
          <p>{content.banner.tipTitle}</p>
        </div>
        <div class="smile-NewBanner-Tip-Content">
          <p>• {content.banner.tipItem1}</p>
          <p>• {content.banner.tipItem2}</p>
        </div>
      </div>
    </div>

    {/* Section 2: 中心介紹與唯一 H1 業務概括 (Summary) */}
    <section class="smile-newCenter site-container" aria-labelledby="hero-h1-title">
      <nav
        class="smile-newCenter-menu"
        aria-label="麵包屑導航"
      >
        <a href={isCn ? "/cn/" : "/"} title={content.breadcrumb.home}>{content.breadcrumb.home}</a>
        <span>&nbsp;&gt;&nbsp;</span>
        <span>{content.breadcrumb.service}</span>
        <span>&nbsp;&gt;&nbsp;</span>
        <a href={isCn ? "/cn/smilePro" : "/smilePro"} title={content.breadcrumb.current}>
          {content.breadcrumb.current}
        </a>
      </nav>

      <div
        class="summary overflow-hidden flex flex-col lg:flex-row gap-10 xl:gap-[68px] mb-23 lg:mb-[180px]"
      >
        <div class="lg:w-1/2">
          <div class="flex items-end gap-2 lg:gap-3 mb-4 lg:mb-6">
            <h1
              id="hero-h1-title"
              class="text-[clamp(14px,4.44vw,30px)] lg:text-3xl font-bold text-primary whitespace-nowrap mb-0"
            >
              <span class="font-en tracking-normal">{content.summary.titlePrefix}</span>{" "}
              <strong class="font-black">{content.summary.titleStrong}</strong>
            </h1>
            <img draggable="false"
              src={content.summary.fullUpgradedImg}
              alt="全面升級"
              title="全面升級"
              width="232"
              height="38"
              loading="lazy"
              class="w-[clamp(112px,33.84vw,152px)] lg:w-[232px] flex-1 pb-1"
            />
          </div>
          <div class="summary-desc space-y-5 lg:space-y-10">
            <p>
              <span>{content.summary.p1.text1}</span>
              <strong>{content.summary.p1.strong1}</strong>
              <span>{content.summary.p1.text2}</span>
              <strong>{content.summary.p1.strong2}</strong>
              <span>{content.summary.p1.text3}</span>
              <strong>{content.summary.p1.strong3}</strong>
              <span>{content.summary.p1.text4}</span>
              <strong>{content.summary.p1.strong4}</strong>
              <span>{content.summary.p1.text5}</span>
              <strong>{content.summary.p1.strong5}</strong>
              <span>{content.summary.p1.text6}</span>
              <strong>{content.summary.p1.strong6}</strong>
              <span>{content.summary.p1.text7}</span>
            </p>
            <p>
              <span>{content.summary.p2.text8}</span>
              <strong>{content.summary.p2.strong7}</strong>
              <span>{content.summary.p2.text9}</span>
              <strong>{content.summary.p2.strong8}</strong>
              <span>{content.summary.p2.text10}</span>
            </p>
          </div>
        </div>
        <div class="flex-1 w-full">
          <picture class="block w-[78%] ml-auto">
            <source
              media="(min-width: 1024px)"
              srcset={content.summary.introImgPc}
            />
            <img draggable="false"
              src={content.summary.introImgMb}
              alt="SMILE Pro 設備介紹"
              title="SMILE Pro 設備介紹"
              width="512"
              height="300"
              loading="lazy"
              class="w-full h-auto block"
            />
          </picture>
          <div class="aspect-video w-[90%] mr-auto -mt-[14%] relative z-[1] shadow-md">
            <VideoFacade
              videoId={content.summary.videoUrl}
              title={`${content.summary.titlePrefix} ${content.summary.titleStrong}`}
              class="w-full h-full border-0"
            />
          </div>
        </div>
      </div>

      {/* SMILE Pro 2.0 旗艦亮點專區 */}
      <div class="pro2-intro bg-blue-50/50 rounded-2xl p-6 lg:p-12 mb-16 lg:mb-28 border border-blue-100">
        <div
          class="flex flex-col lg:flex-row lg:items-center gap-6 lg:gap-12"
        >
          <div class="lg:w-2/5 flex flex-col items-center text-center">
            <img draggable="false"
              src={content.pro2Intro.logoImg}
              alt="SMILE PRO 2.0"
              title="SMILE PRO 2.0"
              width="360"
              height="128"
              loading="lazy"
              class="w-full max-w-xs lg:max-w-sm aspect-[45/16] object-contain"
            />
            <a
              href="https://www.zeiss.com.hk/"
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-500 hover:text-primary transition-colors text-sm lg:text-base font-light tracking-[0.3em] mt-3 inline-flex items-center gap-1 group/cert"
              title="前往蔡司香港官方網站（另開新分頁）"
              aria-label="前往蔡司香港官方網站（另開新分頁）"
            >
              <span>{content.pro2Intro.certText}</span>
              <svg class="w-3.5 h-3.5 opacity-60 group-hover/cert:opacity-100 transition-opacity" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
            </a>
          </div>
          <div
            class="text-base lg:text-lg leading-relaxed text-gray-700 lg:flex-1"
          >
            <h2 class="title-normal text-left mb-4 text-2xl lg:text-3xl font-black text-primary">
              {content.pro2Intro.title}
            </h2>
            <p class="text-gray-600 font-light mb-6" set:html={content.pro2Intro.desc} />
            <div class="mb-5 lg:mb-8 bg-white p-5 rounded-xl shadow-xs border border-blue-100/60">
              <h3 class="text-primary font-bold text-lg lg:text-xl mb-2 flex items-center gap-2">
                <span class="inline-block w-2.5 h-2.5 rounded-full bg-primary"></span>
                {content.pro2Intro.feature1Title}
              </h3>
              <p class="text-gray-600 font-light leading-relaxed" set:html={content.pro2Intro.feature1Desc} />
            </div>
            <div class="bg-white p-5 rounded-xl shadow-xs border border-blue-100/60">
              <h3 class="text-primary font-bold text-lg lg:text-xl mb-2 flex items-center gap-2">
                <span class="inline-block w-2.5 h-2.5 rounded-full bg-primary"></span>
                {content.pro2Intro.feature2Title}
              </h3>
              <p class="text-gray-600 font-light leading-relaxed" set:html={content.pro2Intro.feature2Desc} />
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* Section 3: 為何選擇希瑪? (Why Choose) */}
    <section class="icl-WhatChoose site-container" aria-labelledby="why-choose-heading">
      <h2 id="why-choose-heading" class="icl-WhatChoose-title text-center">
        {content.whyChoose.title}
      </h2>
      <div class="icl-WhatChoose-content-one">
        <div class="icl-WhatChoose-content-one-img">
          <img draggable="false"
            decoding="async"
            src={content.whyChoose.img}
            alt={content.whyChoose.alt}
            title={content.whyChoose.alt}
            loading="lazy"
            srcset={content.whyChoose.imgMobile + " 400w, " + content.whyChoose.imgMobile + " 640w, " + content.whyChoose.img}
            sizes="(max-width: 992px) 100vw, 480px"
            class="w-full h-auto max-w-md lg:max-w-none mx-auto"
          />
        </div>
        <div class="icl-WhatChoose-content-one-text">
          <p>
            {content.whyChoose.p1Text1}
            <span>{content.whyChoose.p1Span}</span>
            {content.whyChoose.p1Text2}
          </p>
          <p>
            {content.whyChoose.p2Text1}
            <span>{content.whyChoose.p2Span1}</span>
            {content.whyChoose.p2Text2}
            <span>{content.whyChoose.p2Span2}</span>
            {content.whyChoose.p2Text3}
            <span>{content.whyChoose.p2Span3}</span>
            {content.whyChoose.p2Text4}
          </p>
        </div>
      </div>
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-cta="whatsapp"
        class="mx-auto icl-btn"
        title="WhatsApp 諮詢預約"
      >
        <span>{content.whyChoose.btn}</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 17 17" fill="none" aria-hidden="true">
          <path d="M2 14.54 14.571 1.969" stroke="#fff" stroke-width="3" stroke-linecap="round"/>
          <path d="M3.832 1.569H15v10.8" stroke="#fff" stroke-width="2.7" stroke-linecap="round"/>
        </svg>
      </a>
    </section>

    {/* Section 4: 四大特點 (Four Features) */}
    <section class="smilepro-four-feature mb-[60px] lg:mb-[120px]" aria-labelledby="four-features-heading">
      <div class="site-container">
        <div class="smilepro-four-feature-Box">
          <div class="smilepro-four-feature-Box-top">
            <h2 id="four-features-heading" class="title-normal">
              <span>{content.fourFeature.titlePrefix}</span><br class="hidden lg:block" />{content.fourFeature.title}
            </h2>
            <p>
              {smallTitleLines[0]}<br />
              {smallTitleLines[1]}
            </p>
          </div>
          <div
            class="smilepro-four-feature-Box-List grid grid-cols-1 gap-6 lg:gap-10"
          >
            {
              content.fourFeature.items.map((item) => (
                <div class="smilepro-four-feature-Box-List-item">
                  <div class="smilepro-four-feature-Box-List-item-number">
                    {item.number}
                  </div>
                  <div class="smilepro-four-feature-Box-List-item-text">
                    <h3>{item.title}</h3>
                    <p>
                      {item.desc}
                      {item.sub && (
                        <>
                          <br class="lg:hidden" />
                          {item.sub}
                        </>
                      )}
                    </p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    {/* Section 5: SMILE Pro 微笑激光矯視冬日禮遇 / 費用 (Pricing) */}
    <section
      id="price"
      class="price site-container mb-16 lg:mb-28 scroll-mt-24"
      aria-labelledby="price-section-heading"
    >
      <h2 id="price-section-heading" class="title-normal text-center text-2xl lg:text-3xl font-black text-primary mb-8 lg:mb-14">
        {content.price.title}
      </h2>
      <div
        class="flex justify-center items-stretch flex-col md:flex-row gap-6 lg:gap-10 mb-8 lg:mb-14 max-w-5xl mx-auto"
      >
        {/* 卡片 1: SMILE Pro 2.0 費用 */}
        <div class="price-item flex-1 flex flex-col rounded-3xl overflow-hidden shadow-lg border border-blue-900 bg-[#042562] text-white">
          <div class="bg-[#031d4f] text-center text-xl lg:text-[26px] font-bold tracking-widest py-3 px-4">
            <h3>{content.price.card2.header}</h3>
          </div>
          <div class="flex-1 p-6 lg:p-8 flex flex-col justify-between">
            <div>
              <div class="font-bold tracking-wide mb-6 text-center">
                <p class="flex flex-col mb-2">
                  <span class="text-[26px] lg:text-4xl font-en">{content.price.card2.title1}</span>
                  <span class="text-xl lg:text-2xl text-blue-200">{content.price.card2.title2}</span>
                </p>
                <p class="text-[#F89B03] font-bold text-4xl lg:text-[54px]">
                  {content.price.card2.price}
                </p>
              </div>

              {/* 升級方案 Care */}
              <div class="bg-[#033994] font-bold rounded-2xl p-4 lg:p-6 mb-6 border border-blue-400/30">
                <p class="mb-2 flex justify-between items-center text-base lg:text-xl">
                  <span class="font-en">{content.price.card2.careTitle}</span>
                  <span class="text-lg lg:text-2xl">{content.price.card2.carePrice}</span>
                </p>
                <p class="mb-4 flex justify-between items-center text-sm lg:text-lg text-blue-200">
                  <span>{content.price.card2.epsTitle}</span>
                  <span class="text-base lg:text-xl text-yellow-400 font-bold">{content.price.card2.epsPrice}<sup>#</sup></span>
                </p>
                <a
                  href={careUrl}
                  data-cta="care"
                  title={content.price.card2.careLinkText}
                  class="price-button-care"
                >
                  {content.price.card2.careLinkText}
                </a>
              </div>

              {/* 升級亮點清單 */}
              <div class="border border-[#A2C2F5]/60 rounded-xl mb-6 divide-y divide-[#A2C2F5]/40 overflow-hidden text-base lg:text-lg">
                {
                  content.price.card2.upgrades?.map((up) => (
                    <div class="flex justify-between items-center px-4 py-2 bg-blue-950/40">
                      <div class="flex items-center gap-2">
                        <img draggable="false" src={up.icon} loading="lazy" class="w-5 lg:w-6" alt={up.text} title={up.text} aria-hidden="true" width="24" height="24" />
                        <span>{up.text}</span>
                      </div>
                      <img draggable="false" src={up.badge} loading="lazy" class="w-20 lg:w-28" alt="升級點" title="升級點" width="112" height="24" />
                    </div>
                  ))
                }
              </div>
            </div>

            <div>
              <div class="flex justify-between items-center font-bold mb-6 pt-4 border-t border-dashed border-blue-400/50 text-base lg:text-xl">
                <span>{content.price.card2.preCheckTitle}</span>
                <span class="text-2xl lg:text-[28px] text-yellow-400">{content.price.card2.preCheckPrice}</span>
              </div>
              <a
