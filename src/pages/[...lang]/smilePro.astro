<script>
  import Swiper from "swiper";
  import { Autoplay, Navigation } from "swiper/modules";

  function initSmileProEvaluateSwiper() {
    const el = document.getElementById("smileProEvaluateSwiper");
    if (!el) return;

    const runInit = () => {
      if ((el as any).swiper) {
        (el as any).swiper.destroy(true, true);
      }

      new Swiper(el, {
        modules: [Autoplay, Navigation],
        slidesPerView: 5,
        spaceBetween: 60,
        loop: true,
        autoplay: {
          delay: 4000,
          disableOnInteraction: false,
          pauseOnMouseEnter: true,
        },
        navigation: {
          nextEl: "#smileProEvaluateNext",
          prevEl: "#smileProEvaluatePrev",
        },
        breakpoints: {
          0: {
            slidesPerView: 1.2,
            spaceBetween: 24,
          },
          768: {
            slidesPerView: 2.5,
            spaceBetween: 24,
          },
          1024: {
            slidesPerView: "auto",
            spaceBetween: 14,
          },
          1440: {
            slidesPerView: "auto",
            spaceBetween: 18,
          },
        },
        on: {
          slideChangeTransitionStart(swiper) {
            swiper.updateSlides();
            swiper.setTranslate(-swiper.slidesGrid[swiper.activeIndex]);
          },
          slideChangeTransitionEnd(swiper) {
            swiper.update();
          },
        },
      });
    };

    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        (entries, obs) => {
          if (entries[0]?.isIntersecting) {
            obs.disconnect();
            runInit();
          }
        },
        { rootMargin: "200px" }
      );
      observer.observe(el);
    } else {
      runInit();
    }
  }

  function initFourFeatureReveal() {
    if (typeof window === "undefined" || !("IntersectionObserver" in window)) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const items = document.querySelectorAll<HTMLElement>(
      ".smilepro-four-feature-Box-List-item"
    );
    if (!items.length) return;

    const viewportHeight = window.innerHeight || document.documentElement.clientHeight;
    const observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-revealed");
            obs.unobserve(entry.target);
          }
        });
      },
      { rootMargin: "0px 0px -40px 0px", threshold: 0.05 }
    );

    items.forEach((item) => {
      if (item.classList.contains("is-revealed")) return;
      const rect = item.getBoundingClientRect();
      if (rect.top < viewportHeight) {
        item.classList.add("scroll-reveal", "is-revealed");
      } else {
        item.classList.add("scroll-reveal");
        observer.observe(item);
      }
    });
  }

  function initSmileProPage() {
    initSmileProEvaluateSwiper();
    initFourFeatureReveal();
  }

  document.addEventListener("DOMContentLoaded", initSmileProPage);
  document.addEventListener("astro:page-load", initSmileProPage);
</script>

