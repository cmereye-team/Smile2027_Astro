<style>
  /* 跑馬燈無縫動畫 */
  @keyframes marquee-smooth {
    0% {
      transform: translateX(0%);
    }
    100% {
      transform: translateX(-100%);
    }
  }

  .marquee-wrapper {
    display: flex;
    width: 100%;
    white-space: nowrap;
  }

  .marquee-content {
    display: flex;
    min-width: 100%;
    animation: marquee-smooth 20s linear infinite;
  }

  /* Hero 首屏大圖比例與構圖 (100% 精確對齊線上：全機器可見，零裁切) */
  .hero-banner-img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    object-position: center;

    @media (min-width: 768px) {
      aspect-ratio: 1940 / 647;
      object-fit: contain;
      object-position: right center;
    }
  }

  /* 提示標籤定位 */
  .smile-NewBanner-Tip {
    position: absolute;
    right: 16px;
    bottom: -16px;
    z-index: 5;
  }

  .smile-NewBanner-Tip > div:nth-child(1) {
    background: var(--color-primary);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 4px 16px;
    display: inline-block;
    color: #fff;
    font-size: 13px;
    font-weight: 500;
  }

  .smile-NewBanner-Tip > div:nth-child(2) {
    background: var(--color-primary);
    border-radius: 6px;
    border-top-left-radius: 0px;
    padding: 6px 18px 8px 16px;
    width: fit-content;
    color: #fff;
    font-size: 13px;
    font-weight: 400;
    line-height: 1.6;
  }

  @media screen and (min-width: 768px) {
    .smile-NewBanner-Tip {
      right: 24px;
      bottom: -8px;
    }
    .smile-NewBanner-Tip > div:nth-child(1) {
      font-size: 16px;
      padding: 6px 20px;
    }
    .smile-NewBanner-Tip > div:nth-child(2) {
      font-size: 16px;
      padding: 8px 24px 10px 20px;
    }
  }
</style>
