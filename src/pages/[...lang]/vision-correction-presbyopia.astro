<script>
  import Swiper from "swiper";
  import { Autoplay, Navigation } from "swiper/modules";

  function initPresbyopiaPage() {
    // 1. 第一視角預覽 Swiper 切換 (支援拖拽切換 + 2.5s 自動輪播 + 箭頭導航)
    const swiperEl = document.querySelector(".lbv-swiper") as HTMLElement | null;
    const sceneTitle = document.getElementById("lbvSceneTitle");

    if (swiperEl) {
      if ((swiperEl as any).swiper) {
        (swiperEl as any).swiper.destroy(true, true);
      }

      new Swiper(swiperEl, {
        modules: [Autoplay, Navigation],
        loop: true,
        grabCursor: true,
        autoplay: {
          delay: 2500,
          disableOnInteraction: false,
          pauseOnMouseEnter: true,
        },
        navigation: {
          prevEl: "#lbvPrevBtn",
          nextEl: "#lbvNextBtn",
        },
        speed: 500,
        on: {
          init: function (swiper: any) {
            const activeSlide = swiper.slides[swiper.activeIndex];
            if (activeSlide && sceneTitle) {
              const scene = activeSlide.getAttribute("data-scene");
              if (scene) sceneTitle.textContent = scene;
            }
          },
          slideChange: function (swiper: any) {
            const activeSlide = swiper.slides[swiper.activeIndex];
            if (activeSlide && sceneTitle) {
              const scene = activeSlide.getAttribute("data-scene");
              if (scene) sceneTitle.textContent = scene;
            }
          },
        },
      });
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initPresbyopiaPage);
  } else {
    initPresbyopiaPage();
  }
  document.addEventListener("astro:page-load", initPresbyopiaPage);
</script>
