---
/*
 * @Author: Antigravity AI
 * @Date: 2026-11-10
 * @FilePath: /src/pages/[...lang]/vision-correction-presbyopia.astro
 * @Description: 老花矯視專頁 (100% 官方真值對齊 + 雙端響應式 + W-06 轉換追蹤 + 完整 Schema)
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import SchemaProcedure from "@/components/seo/SchemaProcedure.astro";
import SchemaBreadcrumb from "@/components/seo/SchemaBreadcrumb.astro";
import SchemaFAQ from "@/components/seo/SchemaFAQ.astro";
import SchemaClinic from "@/components/seo/SchemaClinic.astro";
import { i18nPaths, getLangFromUrl, getLocalizedHref } from "@/i18n/utils";
import {
  PRESBYOPIA_ZH_HK,
  PRESBYOPIA_ZH_CN,
} from "@/data/presbyopiaData";
import "@/styles/presbyopia.scss";

export function getStaticPaths() {
  return [...i18nPaths];
}

const lang = getLangFromUrl(Astro.url);
const isCn = lang === "zh-cn";
const content = isCn ? PRESBYOPIA_ZH_CN : PRESBYOPIA_ZH_HK;
const feeUrl = getLocalizedHref("/fee", lang);
const appointFormUrl = getLocalizedHref("/ophthalmicInfo/AppointForm", lang);
const currentUrl = isCn
  ? "/cn/vision-correction-presbyopia"
  : "/vision-correction-presbyopia";

const mainSchemes = content.schemes.items.filter((item) => !item.isSimple);
const simpleSchemes = content.schemes.items.filter((item) => item.isSimple);
---

<BaseLayout tdkKey="presbyopia">
  <SchemaClinic lang={lang} />
  <SchemaProcedure
    name={content.banner.h1}
    description={content.banner.p1}
  />
  <SchemaBreadcrumb
    items={[
      { name: content.breadcrumb.home, url: isCn ? "/cn/" : "/" },
      {
        name: content.breadcrumb.service,
        url: currentUrl,
      },
      {
        name: content.breadcrumb.current,
        url: currentUrl,
      },
    ]}
  />
  <SchemaFAQ
    faqs={content.faq.items.map((f) => ({
      question: f.question,
      answer: f.answer,
    }))}
  />

  <div class="page-presbyopia font-hk text-desc relative overflow-x-clip" style="scroll-snap-type: y proximity;">
    <!-- 1. 頂部主橫幅 Hero Banner (全寬底線 + 嵌套 site-container + 自然舒適佈局) -->
    <section class="presbyopia-hero" aria-labelledby="presbyopia-hero-title">
      <div class="site-container presbyopia-hero-container">
        <header class="hero-header">
          <a href={content.banner.smallTagLink} class="hero-category-link" title="Presbyopia Treatments">
            Presbyopia <br class="d-lg-none" />
            Treatments
          </a>
          <h1 id="presbyopia-hero-title" class="hero-title">{content.banner.h1}</h1>
          <p class="hero-desc-lead">
            希瑪微笑矯視中心主要提供三種<br class="d-lg-none" />可矯正老花的矯視服務
          </p>
          <p class="hero-desc-schemes">
            <a href={content.banner.p2Link1Href} title={content.banner.p2Link1Text}>{content.banner.p2Link1Text}</a>{content.banner.p2And}<a href={content.banner.p2Link2Href} title={content.banner.p2Link2Text}>{content.banner.p2Link2Text}</a>
          </p>
          <p class="hero-desc-sub">
            {content.banner.p3}
          </p>
        </header>
      </div>

      <div class="hero-stage">
        <figure class="hero-figure hero-figure-wrapper">
          <img
            draggable="false"
            decoding="async"
            src={content.banner.imgPc}
            alt={content.banner.imgAlt}
            title={content.banner.imgAlt}
            loading="eager"
            fetchpriority="high"
            width="1209"
            height="678"
            srcset={`${content.banner.imgMb} 400w, ${content.banner.imgMb} 640w, ${content.banner.imgPc}`}
            sizes="(max-width: 992px) 100vw, 1209px"
            class="hero-figure-img"
          />
          <figcaption class="hero-badge">
            <span set:html={content.banner.badgeSpan1} />
            &nbsp;
            <span>{content.banner.badgeSpan2}</span>
          </figcaption>
        </figure>
        <div class="hero-symptoms" aria-label="常見老花症狀困擾">
          {content.banner.tags.map((tag, idx) => (
            <span class={`hero-symptom-tag hero-symptom-tag-${idx + 1}`}>{tag}</span>
          ))}
        </div>
      </div>
    </section>

    <!-- 2. 什麼是老花？ -->
    <section class="WhatLaoHua site-container" id="WhatLaoHua" aria-labelledby="what-is-laohua-heading" style="scroll-snap-align: start; scroll-margin-top: 112px;">
      <h2 id="what-is-laohua-heading">{content.whatIs.title}</h2>
      <div class="WhatLaoHuaBox-text">
        <p set:html={content.whatIs.p1Html} />
        <br />
        <p set:html={content.whatIs.p2Html} />
      </div>
    </section>

    <!-- 3. 老花矯視方案 (語意化架構 + 2026 SEO 標籤) -->
    <section id="CorrectionProgram" class="scheme-section w-full" aria-labelledby="scheme-section-heading">
      <div class="scheme-wrapper">
        <div class="scheme-main">
          <div class="site-container">
            <h2 id="scheme-section-heading" class="scheme-heading">
              {content.schemes.title}
            </h2>
            <!-- 3 個主要矯視方案卡片 (PRESBYOND LBV / CMER CLEAR-Vision / ICL Viva V6) -->
            <div class="scheme-cards-row">
              {mainSchemes.map((item, idx) => {
                const numStr = String(idx + 1).padStart(2, "0");
                const schemeAlt = item.imgAlt || item.title.replace(/<[^>]+>/g, " ").replace(/\s+/g, " ").trim();
                return (
                  <article class="scheme-card" id={item.id}>
                    <div class="scheme-card-top">
                      <span class="scheme-num-badge" aria-hidden="true">{numStr}</span>
                      <picture>
                        {item.imgWp && (
                          <source srcset={item.imgWp} type="image/webp" />
                        )}
                        <img decoding="async" loading="lazy"
                          draggable="false"
                          src={item.imgJpg || item.imgWp}
                          alt={schemeAlt}
                          title={schemeAlt}
                        />
                      </picture>
                      <div class="scheme-card-badge">
                        <span class="scheme-card-tag">
                          {item.suitTag}
                        </span>
                        {item.suitList?.map((s) => (
                          <p>{s}</p>
                        ))}
                      </div>
                    </div>
                    <div class="scheme-card-body">
                      <h3 class="scheme-card-title" set:html={item.title} />
                      <p
                        id={item.targetId}
                        class="scheme-card-desc"
                        set:html={item.descHtml}
                      />
                    </div>
                  </article>
                );
              })}
            </div>

            <!-- 3 個簡易方案選項 (Monovision / Cataract Surgery / 藥物方案) 晶片列 -->
            <div class="simple-schemes-row">
              {simpleSchemes.map((item) => (
                <div class="simple-scheme-chip">
                  <h3 set:html={item.title} />
                </div>
              ))}
            </div>

            <!-- 預約諮詢合適矯視方案 按鈕 -->
            <a
              target="_blank"
              rel="noopener noreferrer"
              href={content.schemes.whatsappUrl}
              class="publicBtn-booking cta-pulse"
              data-cta="whatsapp-w06"
              title={content.schemes.ctaBtnText}
            >
              <span>{content.schemes.ctaBtnText}</span>
              <img
                src="/images/svg/arrow-up-right-white.svg"
                alt=""
                aria-hidden="true"
                class="h-[18px] w-[18px] md:h-[24px] md:w-[24px] inline-block"
              />
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- 3.5 老花矯視費用 (100% 官方真值對齊) -->
    <div class="bg-[#F6FAFD] py-12 md:py-20 relative z-10">
      <div class="w-full flex flex-col items-center mx-auto site-container">
        <h2 class="text-[#4A74B8] text-xl md:text-3xl font-black mb-6 md:mb-10 tracking-wider text-center">
          {content.fee.title}
        </h2>

        {content.fee.groups.map((group, gIdx) => (
          <div class="w-full">
            <div class:list={[
              "text-base font-bold tracking-[4.8px] text-center text-[#4570B6] rounded-[5.005px] bg-[rgba(140,179,243,0.20)] px-6 py-[6px] md:px-[139px] md:py-[11px] md:text-3xl w-fit mx-auto mb-[20px]",
              gIdx === 0 ? "mb-[20px]" : "mt-[25px] md:mt-[58px] md:mb-5"
            ]}>
              {group.pillTitle}
            </div>
            <div class="space-y-2 md:space-y-4 max-w-[1100px] mx-auto w-full">
              {group.items.map((item) => (
                <div class="bg-white border border-[#4570B6] rounded-2xl lbv-item flex flex-row justify-between items-center transition-all group p-[10px] md:px-[50px] md:py-[40px]">
                  <div class="text-text text-base md:text-3xl font-bold self-start md:self-center flex-shrink-0">
                    <span set:html={item.title} />
                  </div>
                  <div class:list={[
                    "text-[#F59E0B] font-bold tracking-tight group-hover:scale-105 transition-transform",
                    item.note1 ? "text-right flex flex-col" : (item.prices.length > 1 ? "flex flex-col md:flex-row md:gap-4" : "")
                  ]}>
                    {item.prices.length > 1 ? (
                      item.prices.map((p) => (
                        <span class="text-[20px] md:text-5xl">{p}</span>
                      ))
                    ) : item.note1 ? (
                      <>
                        <p class="text-[20px] md:text-5xl pb-1 md:pb-3">{item.prices[0]}</p>
                        <p class="text-xs min-[360px]:text-sm md:text-xl font-normal text-desc" set:html={item.note1} />
                        {item.note2 && (
                          <p class="text-text text-xs min-[360px]:text-sm md:text-xl font-normal text-desc" set:html={item.note2} />
                        )}
                      </>
                    ) : (
                      <span class="text-[20px] md:text-5xl">{item.prices[0]}</span>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}

        <div class="mt-8 md:mt-12 flex flex-col items-center relative z-20">
          <a
            href={isCn ? "/cn/fee#table1" : "/fee#table1"}
            class="md:w-auto bg-[#4570B6] hover:bg-[#345c99] transition-colors text-white px-8 py-3.5 md:py-5 md:px-[100px] rounded-full text-[20px] md:text-4xl font-bold flex items-center justify-center gap-2.5 md:gap-3 cta-pulse relative z-20 cursor-pointer"
            data-cta="fee"
            title={content.fee.btnText}
          >
            {content.fee.btnText}
            <img
              src="/images/svg/arrow-up-right-white.svg"
              alt=""
              aria-hidden="true"
              class="h-5 w-5 md:h-[26px] md:w-[26px] inline-block"
            />
          </a>
          <div class="text-text mt-2 md:mt-4 text-center font-normal text-base md:text-2xl leading-relaxed min-[360px]:tracking-wider min-[390px]:tracking-normal">
            <p>此為香港價錢</p>
            <p>
              <sup>*</sup>矯視費用已包括術前檢查費用港幣$100<br class="block md:hidden" />（若沒有預約進行矯視，需另外繳付術前檢查費用）
            </p>
            <p class="text-[14px] md:text-2xl">
              <sup>#</sup>免責聲明：受條款及細則約束。優惠僅適用於以 EPS 全數支付之客戶。<br class="block md:hidden" />如有任何爭議，希瑪眼科將保留最終決定權。
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- 4. 老花矯視技術好處對比 & EVO ICL 產品系列介紹 — V6 -->
    <section class="visionBattle" aria-labelledby="vision-battle-heading">
      <img
        draggable="false"
        decoding="async"
        src={content.battle.bgPc}
        alt={content.battle.title}
        title={content.battle.title}
        aria-hidden="true"
        loading="lazy"
        width="100%"
        height="100%"
        srcset={`${content.battle.bgMb} 400w, ${content.battle.bgMb} 640w, ${content.battle.bgPc}`}
        sizes="(max-width: 992px) 100vw, 1216px"
        class="visionBattle-Bg"
      />
      <div id="visionBattle-Box-list" class="visionBattle-Box site-container">
        <h2 id="vision-battle-heading">{content.battle.title}</h2>
        <div class="visionBattle-Box-list">
          <article class="visionBattle-Box-list-item">
            <div class="visionBattle-Box-list-item-content">
              <h3 set:html={content.battle.items[0].title} />
              {content.battle.items[0].points.map((pt) => (
                <p>
                  <img decoding="async" loading="lazy"
                    draggable="false"
                    src="https://statichk.cmermedical.com/smile/clear-visionV2/clearAppointment/success.svg"
                    alt={isCn ? "包含技术特点" : "包含技術特點"}
                    title={isCn ? "包含技术特点" : "包含技術特點"}
                  />
                  <span set:html={pt} />
                </p>
              ))}
              <div class="mt-[31px] flex items-center justify-center">
                <div class="flex items-center bg-[#4570B6] text-white p-4 rounded-sm shadow-md max-w-md">
                  <img
                    src="/images/svg/icon-500hz.svg"
                    alt={isCn ? "蔡司 500Hz 尖端切削频率图标" : "蔡司 500Hz 尖端切削頻率圖標"}
                    title={isCn ? "蔡司 500Hz 尖端切削频率图标" : "蔡司 500Hz 尖端切削頻率圖標"}
                    aria-hidden="true"
                    class="h-[52px] md:h-[60px] w-auto flex-shrink-0 mr-2"
                    width="96"
                    height="60"
                  />
                  <ul class="space-y-2 text-lg font-medium whitespace-nowrap">
                    <li class="flex items-center">
                      <span class="mr-2 text-base md:text-lg opacity-80">·</span>
                      比上一代快一倍
                    </li>
                    <li class="flex items-center">
                      <span class="mr-2 text-base md:text-lg opacity-80">·</span>
                      激光時間更短
                    </li>
                    <li class="flex items-center">
                      <span class="mr-2 text-base md:text-lg opacity-80">·</span>
                      精準度更高
                    </li>
                  </ul>
                </div>
              </div>
            </div>
          </article>

          <article class="visionBattle-Box-list-item">
            <div class="visionBattle-Box-list-item-content">
              <h3 set:html={content.battle.items[1].title} />
              {content.battle.items[1].points.map((pt) => (
                <p>
                  <img decoding="async" loading="lazy"
                    draggable="false"
                    src="https://statichk.cmermedical.com/smile/clear-visionV2/clearAppointment/success.svg"
                    alt={isCn ? "包含技术特点" : "包含技術特點"}
                    title={isCn ? "包含技术特点" : "包含技術特點"}
                  />
                  <span set:html={pt} />
                </p>
              ))}
            </div>
            <div class="visionBattle-Box-list-item-VS">
              <img
                src="/images/svg/icon-battle-vs.svg"
                alt={isCn ? "老花矫视技术对比 VS" : "老花矯視技術對比 VS"}
                title={isCn ? "老花矫视技术对比 VS" : "老花矯視技術對比 VS"}
                aria-label={isCn ? "老花矫视技术对比 VS" : "老花矯視技術對比 VS"}
                width="70"
                height="118"
                loading="lazy"
                decoding="async"
                class="w-[70px] h-auto"
              />
            </div>
          </article>

          <article class="visionBattle-Box-list-item">
            <div class="visionBattle-Box-list-item-content">
              <h3 set:html={content.battle.items[2].title} />
              {content.battle.items[2].points.map((pt) => (
                <p>
                  <img decoding="async" loading="lazy"
                    draggable="false"
                    src="https://statichk.cmermedical.com/smile/clear-visionV2/clearAppointment/success.svg"
                    alt={isCn ? "包含技术特点" : "包含技術特點"}
                    title={isCn ? "包含技术特点" : "包含技術特點"}
                  />
                  <span set:html={pt} />
                </p>
              ))}
            </div>
            <div class="visionBattle-Box-list-item-VS">
              <img
                src="/images/svg/icon-battle-vs.svg"
                alt={isCn ? "老花矫视技术对比 VS" : "老花矯視技術對比 VS"}
                title={isCn ? "老花矫视技术对比 VS" : "老花矯視技術對比 VS"}
                aria-label={isCn ? "老花矫视技术对比 VS" : "老花矯視技術對比 VS"}
                width="70"
                height="118"
                loading="lazy"
                decoding="async"
                class="w-[70px] h-auto"
              />
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- EVO ICL 產品系列介紹 — V6 表格 -->
    <section class="icl-model site-container lg:pt-0">
      <h2
        class="model-title mb-6 lg:mb-10 text-center font-bold text-xl lg:text-3xl text-[#4570B6]"
      >
        {content.modelTable.title}
      </h2>
      <div
        class="model-main w-full max-w-[1000px] mx-auto text-desc text-center font-normal text-lg lg:text-2xl"
      >
        <table class="model-table w-full">
          <thead>
            <tr class="line-bottom">
              <th class="table-item">{content.modelTable.projectHeader}</th>
              <th class="project-name">{content.modelTable.modelHeader}</th>
            </tr>
          </thead>
          <tbody>
            <tr class="line-bottom">
              <th class="table-item">{content.modelTable.rangeLabel}</th>
              <td set:html={content.modelTable.rangeContent} />
            </tr>
            <tr class="line-bottom">
              <th class="table-item">{content.modelTable.techLabel}</th>
              <td class="model-star text-[#F89B03] font-bold">
                {content.modelTable.techContent}
              </td>
            </tr>
            <tr class="line-bottom">
              <th class="table-item">{content.modelTable.materialLabel}</th>
              <td>{content.modelTable.materialContent}</td>
            </tr>
            <tr class="line-bottom">
              <th class="table-item">{content.modelTable.audienceLabel}</th>
              <td>{content.modelTable.audienceContent}</td>
            </tr>
            <tr class="line-bottom">
              <th class="table-item">{content.modelTable.nightLabel}</th>
              <td class="model-star text-[#F89B03] font-bold">
                {content.modelTable.nightContent}
              </td>
            </tr>
            <tr class="line-bottom">
              <th class="table-item">
                {content.modelTable.reversibilityLabel}
              </th>
              <td>
                <div class="flex items-center justify-center gap-1">
                  <img
                    src="/images/svg/icon-check-orange.svg"
                    alt={content.modelTable.reversibilityContent}
                    title={content.modelTable.reversibilityContent}
                    aria-hidden="true"
                    width="27"
                    height="28"
                    class="inline-block"
                  />
                  <span>{content.modelTable.reversibilityContent}</span>
                </div>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- 5. LBV/CLEAR-Vision/ICL Viva V6 大不同 -->
    <section class="smilepro-difference site-container" aria-labelledby="smilepro-difference-heading">
      <div class="smilepro-difference-title">
        <h2 id="smilepro-difference-heading" set:html={content.comparison.title} />
      </div>
      <div class="table-scroll-wrapper">
        <table class="table custom-comparison-table">
        <thead>
          <tr>
            <th></th>
            {content.comparison.columns.map((col) => (
              <th class={col.bgClass} set:html={col.title} />
            ))}
          </tr>
        </thead>
        <tbody>
          {content.comparison.rows.map((row) => (
            <tr>
              <td set:html={row.label} />
              {row.isBadgeRow ? (
                <>
                  <td>
                    {row.col1Badge?.text ? (
                      <span class="flex items-center justify-center gap-2">
                        <img decoding="async" loading="lazy" draggable="false" width="22" height="22" src={row.col1Badge.success
                              ? "https://statichk.cmermedical.com/smile/feeV2/success.svg"
                              : "https://statichk.cmermedical.com/smile/feeV2/error.svg"} alt={row.col1Badge.text} title={row.col1Badge.text} class="w-[22px] h-[22px] inline-block align-middle flex-shrink-0" />
                        {row.col1Badge.text}
                      </span>
                    ) : (
                      <img decoding="async" loading="lazy" draggable="false" width="22" height="22" src={row.col1Badge?.success
                            ? "https://statichk.cmermedical.com/smile/feeV2/success.svg"
                            : "https://statichk.cmermedical.com/smile/feeV2/error.svg"} alt={row.col1Badge?.success ? "包括" : "不包括"} title={row.col1Badge?.success ? "包括" : "不包括"} class="mx-auto w-[22px] h-[22px] block" />
                    )}
                  </td>
                  <td>
                    {row.col2Badge?.text ? (
                      <span class="flex items-center justify-center gap-2">
                        <img decoding="async" loading="lazy" draggable="false" width="22" height="22" src={row.col2Badge.success
                              ? "https://statichk.cmermedical.com/smile/feeV2/success.svg"
                              : "https://statichk.cmermedical.com/smile/feeV2/error.svg"} alt={row.col2Badge.text} title={row.col2Badge.text} class="w-[22px] h-[22px] inline-block align-middle flex-shrink-0" />
                        {row.col2Badge.text}
                      </span>
                    ) : (
                      <img decoding="async" loading="lazy" draggable="false" width="22" height="22" src={row.col2Badge?.success
                            ? "https://statichk.cmermedical.com/smile/feeV2/success.svg"
                            : "https://statichk.cmermedical.com/smile/feeV2/error.svg"} alt={row.col2Badge?.success ? "包括" : "不包括"} title={row.col2Badge?.success ? "包括" : "不包括"} class="mx-auto w-[22px] h-[22px] block" />
                    )}
                  </td>
                  <td>
                    {row.col3Badge?.text ? (
                      <span class="flex items-center justify-center gap-2">
                        <img decoding="async" loading="lazy" draggable="false" width="22" height="22" src={row.col3Badge.success
                              ? "https://statichk.cmermedical.com/smile/feeV2/success.svg"
