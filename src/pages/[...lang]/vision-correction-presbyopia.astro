---
/*
 * @Author: Antigravity AI
 * @Date: 2026-11-10
 * @FilePath: /src/pages/[...lang]/vision-correction-presbyopia.astro
 * @Description: 老花矯視專頁 (100% 官方真值對齊 + 雙端響應式 + W-06 轉換追蹤 + 完整 Schema)
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import SchemaProcedure from "@/components/seo/SchemaProcedure.astro";
import SchemaBreadcrumb from "@/components/seo/SchemaBreadcrumb.astro";
import SchemaFAQ from "@/components/seo/SchemaFAQ.astro";
import { i18nPaths, getLangFromUrl, getLocalizedHref } from "@/i18n/utils";
import {
  PRESBYOPIA_ZH_HK,
  PRESBYOPIA_ZH_CN,
} from "@/data/presbyopiaData";
import "@/styles/presbyopia.scss";

export function getStaticPaths() {
  return [...i18nPaths];
}

const lang = getLangFromUrl(Astro.url);
const isCn = lang === "zh-cn";
const content = isCn ? PRESBYOPIA_ZH_CN : PRESBYOPIA_ZH_HK;
const feeUrl = getLocalizedHref("/fee", lang);
const appointFormUrl = getLocalizedHref("/ophthalmicInfo/AppointForm", lang);
const currentUrl = isCn
  ? "/cn/vision-correction-presbyopia"
  : "/vision-correction-presbyopia";

const mainSchemes = content.schemes.items.filter((item) => !item.isSimple);
const simpleSchemes = content.schemes.items.filter((item) => item.isSimple);
---

<BaseLayout tdkKey="presbyopia">
  <SchemaProcedure
    name={content.banner.h1}
    description={content.banner.p1}
  />
  <SchemaBreadcrumb
    items={[
      { name: content.breadcrumb.home, url: isCn ? "/cn/" : "/" },
      {
        name: content.breadcrumb.service,
        url: currentUrl,
      },
      {
        name: content.breadcrumb.current,
        url: currentUrl,
      },
    ]}
  />
  <SchemaFAQ
    faqs={content.faq.items.map((f) => ({
      question: f.question,
      answer: f.answer,
    }))}
  />

  <div class="page-presbyopia font-hk text-desc relative overflow-x-clip">
    <!-- 1. 頂部主橫幅 Hero Banner -->
    <section class="ClearVisionBanner">
      <div class="site-container">
        <div class="ClearVisionBanner-Box">
          <div class="ClearVisionBanner-Box-content">
            <div class="ClearVisionBanner-Box-content-title">
              <a href={content.banner.smallTagLink} class="cursor-pointer" title="Presbyopia Treatments">
                Presbyopia <br class="d-lg-none" />
                Treatments
              </a>
              <h1>{content.banner.h1}</h1>
              <p>
                希瑪微笑矯視中心主要提供三種<br class="d-lg-none" />可矯正老花的矯視服務
              </p>
              <p>
                <a href={content.banner.p2Link1Href} title={content.banner.p2Link1Text}>{content.banner.p2Link1Text}</a>{content.banner.p2And}<a href={content.banner.p2Link2Href} title={content.banner.p2Link2Text}>{content.banner.p2Link2Text}</a>
              </p>
              <p>
                {content.banner.p3}
              </p>
            </div>
            <div class="ClearVisionBanner-Box-content-img">
              <img
                draggable="false"
                decoding="async"
                src={content.banner.imgPc}
                alt={content.banner.imgAlt}
                title={content.banner.imgAlt}
                loading="lazy"
                width="100%"
                height="100%"
                srcset={`${content.banner.imgMb} 400w, ${content.banner.imgMb} 640w, ${content.banner.imgPc}`}
                sizes="(max-width: 992px) 100vw, 1216px"
              />
              <p>
                <span set:html={content.banner.badgeSpan1} />
                &nbsp;
                <span>{content.banner.badgeSpan2}</span>
              </p>
            </div>
          </div>
          <div class="ClearVisionBanner-Box-text">
            {content.banner.tags.map((tag) => (
              <span>{tag}</span>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 2. 什麼是老花？ -->
    <section class="WhatLaoHua">
      <div class="WhatLaoHuaBox site-container">
        <h2>{content.whatIs.title}</h2>
        <div class="WhatLaoHuaBox-text">
          <p set:html={content.whatIs.p1Html} />
          <br />
          <p set:html={content.whatIs.p2Html} />
        </div>
      </div>
    </section>

    <!-- 3. 老花矯視方案 -->
    <div id="CorrectionProgram" class="CorrectionProgram">
      <div class="CorrectionProgram-Box">
        <div class="CorrectionProgram-Box-show hidden lg:block" id="presbyopiaBoxShow">
          <img
            draggable="false"
            decoding="async"
            src={content.schemes.showImgPc}
            alt={content.schemes.title}
            title={content.schemes.title}
            loading="lazy"
            width="100%"
            height="100%"
            srcset={`${content.schemes.showImgMb} 400w, ${content.schemes.showImgMb} 640w, ${content.schemes.showImgPc}`}
            sizes="(max-width: 992px) 100vw, 1216px"
          />
        </div>
        <div class="CorrectionProgram-Box-hide">
          <div class="CorrectionProgram-Box-hide-title">
            {content.schemes.title}
          </div>
          <div class="CorrectionProgram-Box-hide-item-container">
            {mainSchemes.map((item, idx) => {
              const numStr = String(idx + 1).padStart(2, "0");
              const schemeAlt = item.imgAlt || item.title.replace(/<[^>]+>/g, " ").replace(/\s+/g, " ").trim();
              return (
                <div class="CorrectionProgram-Box-hide-item" id={item.id}>
                  <div class="CorrectionProgram-Box-hide-item-top">
                    <span class="scheme-num-badge" aria-hidden="true">{numStr}</span>
                    <picture>
                      {item.imgWp && (
                        <source srcset={item.imgWp} type="image/webp" />
                      )}
                      <img decoding="async" loading="lazy"
                        draggable="false"
                        src={item.imgJpg || item.imgWp}
                        alt={schemeAlt}
                        title={schemeAlt}
                      />
                    </picture>
                    <div class="CorrectionProgram-Box-hide-item-top-text">
                      <span class="CorrectionProgram-Box-hide-item-sub">
                        {item.suitTag}
                      </span>
                      {item.suitList?.map((s) => (
                        <p>{s}</p>
                      ))}
                    </div>
                  </div>
                  <div class="CorrectionProgram-Box-hide-item-bottom">
                    <h3 set:html={item.title} />
                    <p
                      id={item.targetId}
                      class="CorrectionProgram-Box-hide-item-bottom-text"
                      set:html={item.descHtml}
                    />
                  </div>
                </div>
              );
            })}
          </div>

          <!-- 3 個簡易方案選項 (Monovision / Cataract Surgery / 藥物方案) 晶片列 -->
          <div class="simple-schemes-row">
            {simpleSchemes.map((item) => (
              <div class="simple-scheme-chip">
                <h3 set:html={item.title} />
              </div>
            ))}
          </div>
        </div>
      </div>
      <!-- 預約諮詢合適矯視方案 按鈕 -->
      <a
        target="_blank"
        rel="noopener noreferrer"
        href={content.schemes.whatsappUrl}
        class="publicBtn-booking"
        data-cta="whatsapp-w06"
        title={content.schemes.ctaBtnText}
      >
        <span>{content.schemes.ctaBtnText}</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="30"
          height="29"
          viewBox="0 0 30 29"
          fill="none"
        >
          <path
            d="M3.19922 26.0597L25.8278 3.43115"
            stroke="white"
            stroke-width="5.4"
            stroke-linecap="round"
          />
          <path
            d="M6.49707 2.71118H26.5997V22.1512"
            stroke="white"
            stroke-width="4.86"
            stroke-linecap="round"
          />
        </svg>
      </a>
    </div>

    <!-- 3.5 老花矯視費用 (100% 官方真值對齊) -->
    <div class="bg-[#F6FAFD] py-8 px-2 md:px-0 md:pb-32 md:pt-8 mb-8 mt-[50px] md:mb-22 md:mt-[90px]">
      <div class="w-full flex flex-col items-center mx-auto site-container">
        <h2 class="text-[#4A74B8] text-xl md:text-3xl font-black mb-6 md:mb-10 tracking-wider text-center">
          {content.fee.title}
        </h2>

        {content.fee.groups.map((group, gIdx) => (
          <div class="w-full">
            <div class:list={[
              "text-base font-bold tracking-[4.8px] text-center text-[#4570B6] rounded-[5.005px] bg-[rgba(140,179,243,0.20)] px-[60px] py-[6px] md:px-[139px] md:py-[11px] md:text-3xl w-fit mx-auto mb-[20px]",
              gIdx === 0 ? "mb-[20px]" : "mt-[25px] md:mt-[58px] md:mb-5"
            ]}>
              {group.pillTitle}
            </div>
            <div class="space-y-2 md:space-y-4 max-w-[1187px] mx-auto w-full">
              {group.items.map((item) => (
                <div class="bg-white border border-[#4570B6] rounded-2xl lbv-item flex flex-row justify-between items-center transition-all group p-[10px] md:px-[50px] md:py-[40px]">
                  <div class="text-text text-base md:text-3xl font-bold">
                    <span set:html={item.title} />
                  </div>
                  <div class:list={[
                    "text-[#F59E0B] font-bold tracking-tight group-hover:scale-105 transition-transform",
                    item.note1 ? "-ml-[68px] sm:ml-0 text-right flex flex-col" : (item.prices.length > 1 ? "flex flex-col md:flex-row md:gap-4" : "")
                  ]}>
                    {item.prices.length > 1 ? (
                      item.prices.map((p) => (
                        <span class="text-2xl md:text-5xl">{p}</span>
                      ))
                    ) : item.note1 ? (
                      <>
                        <p class="text-2xl md:text-5xl pb-1 md:pb-3">{item.prices[0]}</p>
                        <p class="text-xs min-[360px]:text-sm md:text-xl font-normal text-desc" set:html={item.note1} />
                        {item.note2 && (
                          <p class="text-text text-xs min-[360px]:text-sm md:text-xl font-normal text-desc" set:html={item.note2} />
                        )}
                      </>
                    ) : (
                      <span class="text-2xl md:text-5xl">{item.prices[0]}</span>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}

        <div class="mt-8 md:mt-12 flex flex-col items-center">
          <a
            href={isCn ? "/cn/fee#table1" : "/fee#table1"}
            class="md:w-auto bg-[#4570B6] hover:bg-[#345c99] transition-colors text-white px-10 py-4 md:py-5 md:px-[100px] rounded-full text-2xl md:text-4xl font-bold flex items-center justify-center gap-3"
            title={content.fee.btnText}
          >
            {content.fee.btnText}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 34 34" fill="none" class="h-[13px] w-[13px] md:h-[26px] md:w-[26px]" aria-hidden="true">
              <path d="M3.18018 30.3632L29.8334 3.70996" stroke="white" stroke-width="6.36042" stroke-linecap="round" />
              <path d="M7.06396 2.8623H30.742V25.7598" stroke="white" stroke-width="5.72438" stroke-linecap="round" />
            </svg>
          </a>
          <div class="text-text mt-2 md:mt-4 text-center font-light text-base md:text-2xl leading-relaxed min-[360px]:tracking-wider min-[390px]:tracking-normal">
            <p>此為香港價錢</p>
            <p>
              <sup>*</sup>矯視費用已包括術前檢查費用港幣$100<br class="block md:hidden" />（若沒有預約進行矯視，需另外繳付術前檢查費用）
            </p>
            <p>
              <sup>#</sup>免責聲明：受條款及細則約束。優惠僅適用於以 EPS 全數支付之客戶。<br class="block md:hidden" />如有任何爭議，希瑪眼科將保留最終決定權。
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- 4. 老花矯視技術好處對比 & EVO ICL 產品系列介紹 — V6 -->
    <section class="visionBattle">
      <img
        draggable="false"
        decoding="async"
        src={content.battle.bgPc}
        alt={content.battle.title}
        title={content.battle.title}
        aria-hidden="true"
        loading="lazy"
        width="100%"
        height="100%"
        srcset={`${content.battle.bgMb} 400w, ${content.battle.bgMb} 640w, ${content.battle.bgPc}`}
        sizes="(max-width: 992px) 100vw, 1216px"
        class="visionBattle-Bg"
      />
      <div id="visionBattle-Box-list" class="visionBattle-Box">
        <h2>{content.battle.title}</h2>
        <div class="visionBattle-Box-list">
          <div class="visionBattle-Box-list-item">
            <div class="visionBattle-Box-list-item-content">
              <h3 set:html={content.battle.items[0].title} />
              {content.battle.items[0].points.map((pt) => (
                <p>
                  <img decoding="async" loading="lazy"
                    draggable="false"
                    src="https://statichk.cmermedical.com/smile/clear-visionV2/clearAppointment/success.svg"
                    alt="對勾"
                    title="對勾"
                  />
                  <span set:html={pt} />
                </p>
              ))}
              <div class="mt-[31px]">
                <div class="flex items-center justify-center">
                  <div class="flex items-center bg-[#4570B6] text-white px-4 py-2 md:px-8 md:py-10 rounded-sm shadow-md max-w-md">
                    <div class="flex-shrink-0 mr-2 relative">
                      <svg viewBox="0 0 132 82" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-[64px] md:h-20" aria-hidden="true">
                        <path d="M14.47 21.847h14.44l-1.275 6.557h-2.96l.893-4.594h-8.68l-.893 4.594h-2.8zm2.84 2.473h7.66l-.318 1.63h-7.66zm-.417 2.14h7.58l-.332 1.709h-7.58zm-5.631 2.219h18.1l-.435 2.238h-18.1zm8.837 2.69h6.22l-.416 2.14h-6.22zm-6.004.02h4.34l-.374 1.923h-4.34zm-.477 2.453h4.34l-.374 1.924h-4.34zm8.767-.55q.507 1.61 1.938 2.788 1.43 1.179 3.652 1.689-.33.255-.746.648-.396.392-.776.805-.364.432-.61.765-2.415-.745-3.857-2.277-1.418-1.55-2.043-3.79zm3.294-1.923h.52l.495-.079 1.655.648q-.986 2.08-2.346 3.632a14.3 14.3 0 0 1-3.052 2.63 16.8 16.8 0 0 1-3.663 1.768 7 7 0 0 0-.471-1.178 5.2 5.2 0 0 0-.638-1.04 13 13 0 0 0 3.076-1.316 11.8 11.8 0 0 0 2.556-2.042 10.4 10.4 0 0 0 1.792-2.63zM9.513 36.748l2.347-.137q1.335-.08 2.795-.177 1.482-.118 2.941-.216l-.38 2.16q-2.081.215-4.176.392l-3.728.353zm7.828-7.343h2.78L18.06 40.007h-2.78zm-4.712.06h2.64l-1.564 8.049h-2.64zm29.849-1.69h7.48l-.512 2.632h-7.48zm-10.119-4.534h9.1l-.447 2.297h-9.1zm-1.703 7.833h9.2l-.461 2.376h-9.2zm.544-3.514h9.74l-.45 2.317h-9.74zm14.028 1.394h2.82L45.92 39.909H43.1zM32.76 25.91l2.407-.55q.096.432.157.942.064.492.072.864l-2.506.648a9 9 0 0 0-.02-.923 9 9 0 0 0-.11-.981m4.95-.57 2.53.472-.864 1.354a15 15 0 0 1-.75 1.08l-2.248-.471q.228-.354.468-.766.245-.432.468-.864.248-.45.397-.805m10.92-3.907 1.792 2.101q-1.185.432-2.513.785-1.306.334-2.638.61a55 55 0 0 1-2.564.431 4.8 4.8 0 0 0-.13-1.08 9 9 0 0 0-.294-1.06 50 50 0 0 0 2.295-.49 30 30 0 0 0 2.198-.61 19 19 0 0 0 1.854-.686m-13.292.373 3.053-.687q.154.648.282 1.434.13.765.16 1.335l-3.233.785q.03-.57-.072-1.374a23 23 0 0 0-.19-1.492m6.945 1.414h2.7l-1.393 7.166a41 41 0 0 1-.542 2.376q-.308 1.275-.764 2.591a20 20 0 0 1-1.064 2.493q-.614 1.198-1.412 2.12a3.6 3.6 0 0 0-.526-.588 16 16 0 0 0-.734-.648 4.3 4.3 0 0 0-.656-.432 9.6 9.6 0 0 0 1.453-2.435 18.6 18.6 0 0 0 .942-2.787q.36-1.434.603-2.69zm-5.77 11.367 2.063-1.04q.338.628.632 1.374.296.746.452 1.276l-2.172 1.198q-.13-.57-.417-1.355a26 26 0 0 0-.558-1.453m-5.195-.746 2.074.648q-