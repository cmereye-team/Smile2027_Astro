                        <path d="m112.615 34.86-9.295-4.831c-.48-.247-.617-.944-.521-1.468l3.336-18.067c.118-.642.959-.992 1.447-.925.512.07 1.357.6 1.217 1.371l-3.144 17.23 8.048 4.204c.594.31.849 1.077.683 1.57-.188.557-1.015 1.31-1.768.919zm-24.137-6.741H65.072c-.9 0-1.428-.517-1.483-1.276-.059-.83.528-1.43 1.483-1.43h23.406c.83 0 1.391.585 1.41 1.279.018.748-.513 1.427-1.41 1.427m-10.244 9.783H54.74c-.856 0-1.406-.546-1.461-1.302-.04-.545.457-1.427 1.273-1.427l23.59-.007a1.4 1.4 0 0 1 1.424 1.294c.04.623-.384 1.442-1.336 1.442zm3.498-22.279c.945 0 1.358.627 1.424 1.29.063.609-.465 1.442-1.332 1.442H58.253c-.83 0-1.336-.704-1.355-1.272-.025-.76.432-1.456 1.351-1.456h23.48z" fill="currentColor" />
                      </svg>
                    </div>
                    <ul class="space-y-2 text-lg font-medium whitespace-nowrap">
                      <li class="flex items-center">
                        <span class="mr-2 text-base md:text-lg opacity-80">·</span>
                        比上一代快一倍
                      </li>
                      <li class="flex items-center">
                        <span class="mr-2 text-base md:text-lg opacity-80">·</span>
                        激光時間更短
                      </li>
                      <li class="flex items-center">
                        <span class="mr-2 text-base md:text-lg opacity-80">·</span>
                        精準度更高
