---
/*
 * @Author: Antigravity AI
 * @Date: 2026-11-10
 * @FilePath: /src/pages/[...lang]/vision-correction-presbyopia.astro
 * @Description: 老花矯視專頁 (100% 官方真值對齊 + 雙端響應式 + W-06 轉換追蹤 + 完整 Schema)
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import SchemaProcedure from "@/components/seo/SchemaProcedure.astro";
import SchemaBreadcrumb from "@/components/seo/SchemaBreadcrumb.astro";
import SchemaFAQ from "@/components/seo/SchemaFAQ.astro";
import { i18nPaths, getLangFromUrl, getLocalizedHref } from "@/i18n/utils";
import {
  PRESBYOPIA_ZH_HK,
  PRESBYOPIA_ZH_CN,
} from "@/data/presbyopiaData";
import "@/styles/presbyopia.scss";

export function getStaticPaths() {
  return [...i18nPaths];
}

const lang = getLangFromUrl(Astro.url);
const isCn = lang === "zh-cn";
const content = isCn ? PRESBYOPIA_ZH_CN : PRESBYOPIA_ZH_HK;
const feeUrl = getLocalizedHref("/fee", lang);
const appointFormUrl = getLocalizedHref("/ophthalmicInfo/AppointForm", lang);
const currentUrl = isCn
  ? "/cn/vision-correction-presbyopia"
  : "/vision-correction-presbyopia";
---

<BaseLayout tdkKey="presbyopia">
  <SchemaProcedure
    name={content.banner.h1}
    description={content.banner.p1}
  />
  <SchemaBreadcrumb
    items={[
      { name: content.breadcrumb.home, url: isCn ? "/cn/" : "/" },
      {
        name: content.breadcrumb.service,
        url: currentUrl,
      },
      {
        name: content.breadcrumb.current,
        url: currentUrl,
      },
    ]}
  />
  <SchemaFAQ
    faqs={content.faq.items.map((f) => ({
      question: f.question,
      answer: f.answer,
    }))}
  />

  <div class="page-presbyopia font-hk text-desc relative overflow-x-hidden">
    <!-- 1. 頂部主橫幅 Hero Banner -->
    <section class="ClearVisionBanner">
      <div class="new-container container">
        <div class="ClearVisionBanner-Box">
          <div class="ClearVisionBanner-Box-content">
            <div class="ClearVisionBanner-Box-content-title">
              <a href={content.banner.smallTagLink} class="cursor-pointer">
                Presbyopia <br class="d-lg-none" />
                Treatments
              </a>
              <h1>{content.banner.h1}</h1>
              <p>
                希瑪微笑矯視中心主要提供三種<br class="d-lg-none" />可矯正老花的矯視服務
              </p>
              <p>
                <a href={content.banner.p2Link1Href}>{content.banner.p2Link1Text}</a>{content.banner.p2And}<a href={content.banner.p2Link2Href}>{content.banner.p2Link2Text}</a>
              </p>
              <p>
                {content.banner.p3}
              </p>
            </div>
            <div class="ClearVisionBanner-Box-content-img">
              <img
                draggable="false"
                decoding="async"
                src={content.banner.imgPc}
                alt={content.banner.imgAlt}
                loading="lazy"
                width="100%"
                height="100%"
                srcset={`${content.banner.imgMb} 400w, ${content.banner.imgMb} 640w, ${content.banner.imgPc}`}
                sizes="(max-width: 992px) 100vw, 1216px"
              />
              <p>
                <span set:html={content.banner.badgeSpan1} />
                &nbsp;
                <span>{content.banner.badgeSpan2}</span>
              </p>
            </div>
          </div>
          <div class="ClearVisionBanner-Box-text">
            {content.banner.tags.map((tag) => (
              <span>{tag}</span>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 2. 什麼是老花？ -->
    <section class="WhatLaoHua">
      <div class="new-container container WhatLaoHuaBox">
        <h2>{content.whatIs.title}</h2>
        <div class="WhatLaoHuaBox-text">
          <p set:html={content.whatIs.p1Html} />
          <br />
          <p set:html={content.whatIs.p2Html} />
        </div>
      </div>
    </section>

    <!-- 3. 老花矯視方案 -->
    <div id="CorrectionProgram" class="CorrectionProgram">
      <div class="CorrectionProgram-Box">
        <div class="CorrectionProgram-Box-show hidden lg:block" id="presbyopiaBoxShow">
          <img
            draggable="false"
            decoding="async"
            src={content.schemes.showImgPc}
            alt={content.schemes.title}
            loading="lazy"
            width="100%"
            height="100%"
            srcset={`${content.schemes.showImgMb} 400w, ${content.schemes.showImgMb} 640w, ${content.schemes.showImgPc}`}
            sizes="(max-width: 992px) 100vw, 1216px"
          />
        </div>
        <div class="CorrectionProgram-Box-hide">
          <div class="CorrectionProgram-Box-hide-title">
            {content.schemes.title}
          </div>
          <div class="CorrectionProgram-Box-hide-item-container">
            {content.schemes.items.map((item) => (
              !item.isSimple ? (
                <div class="CorrectionProgram-Box-hide-item" id={item.id}>
                  <div class="CorrectionProgram-Box-hide-item-top">
                    <picture>
                      {item.imgWp && (
                        <source srcset={item.imgWp} type="image/webp" />
                      )}
                      <img
                        draggable="false"
                        src={item.imgJpg || item.imgWp}
                        alt={item.imgAlt || ""}
                      />
                    </picture>
                    <div class="CorrectionProgram-Box-hide-item-top-text">
                      <span class="CorrectionProgram-Box-hide-item-sub">
                        {item.suitTag}
                      </span>
                      {item.suitList?.map((s) => (
                        <p>{s}</p>
                      ))}
                    </div>
                  </div>
                  <div class="CorrectionProgram-Box-hide-item-bottom">
                    <h3 set:html={item.title} />
                    <p
                      id={item.targetId}
                      class="CorrectionProgram-Box-hide-item-bottom-text"
                      set:html={item.descHtml}
                    />
                  </div>
                </div>
              ) : (
                <div class="CorrectionProgram-Box-hide-item">
                  <div class="CorrectionProgram-Box-hide-item-bottom2">
                    <h3 set:html={item.title} />
                  </div>
                </div>
              )
            ))}
          </div>
        </div>
      </div>
      <!-- 預約諮詢合適矯視方案 按鈕 -->
      <a
        target="_blank"
        rel="noopener noreferrer"
        href={content.schemes.whatsappUrl}
        class="publicBtn-booking"
        data-cta="whatsapp-w06"
      >
        <span>{content.schemes.ctaBtnText}</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="30"
          height="29"
          viewBox="0 0 30 29"
          fill="none"
        >
          <path
            d="M3.19922 26.0597L25.8278 3.43115"
            stroke="white"
            stroke-width="5.4"
            stroke-linecap="round"
          />
          <path
            d="M6.49707 2.71118H26.5997V22.1512"
            stroke="white"
            stroke-width="4.86"
            stroke-linecap="round"
          />
        </svg>
      </a>
    </div>

    <!-- 4. 老花矯視技術好處對比 & EVO ICL 產品系列介紹 — V6 -->
    <section class="visionBattle">
      <img
        draggable="false"
        decoding="async"
        src={content.battle.bgPc}
        alt="背景圖"
        loading="lazy"
        width="100%"
        height="100%"
        srcset={`${content.battle.bgMb} 400w, ${content.battle.bgMb} 640w, ${content.battle.bgPc}`}
        sizes="(max-width: 992px) 100vw, 1216px"
        class="visionBattle-Bg"
      />
      <div id="visionBattle-Box-list" class="visionBattle-Box">
        <h2>{content.battle.title}</h2>
        <div class="visionBattle-Box-list">
          <div class="visionBattle-Box-list-item">
            <div class="visionBattle-Box-list-item-content">
              <h3 set:html={content.battle.items[0].title} />
              {content.battle.items[0].points.map((pt) => (
                <p>
                  <img
                    draggable="false"
                    src="https://statichk.cmermedical.com/smile/clear-visionV2/clearAppointment/success.svg"
                    alt="對勾"
                  />
                  <span set:html={pt} />
                </p>
              ))}
            </div>
          </div>

          <div class="visionBattle-Box-list-item-VS">
            <img
              draggable="false"
              src="https://statichk.cmermedical.com/smile/vision-correction-iclV2/visionBattle/visionBattle-vs.svg"
              alt="VS"
            />
          </div>

          <div class="visionBattle-Box-list-item">
            <div class="visionBattle-Box-list-item-content">
              <h3 set:html={content.battle.items[1].title} />
              {content.battle.items[1].points.map((pt) => (
                <p>
                  <img
                    draggable="false"
                    src="https://statichk.cmermedical.com/smile/clear-visionV2/clearAppointment/success.svg"
                    alt="對勾"
                  />
                  <span set:html={pt} />
                </p>
              ))}
            </div>
          </div>

          <div class="visionBattle-Box-list-item-VS">
            <img
              draggable="false"
              src="https://statichk.cmermedical.com/smile/vision-correction-iclV2/visionBattle/visionBattle-vs.svg"
              alt="VS"
            />
          </div>

          <div class="visionBattle-Box-list-item">
            <div class="visionBattle-Box-list-item-content">
              <h3 set:html={content.battle.items[2].title} />
              {content.battle.items[2].points.map((pt) => (
                <p>
                  <img
                    draggable="false"
                    src="https://statichk.cmermedical.com/smile/clear-visionV2/clearAppointment/success.svg"
                    alt="對勾"
                  />
                  <span set:html={pt} />
                </p>
              ))}
            </div>
          </div>
        </div>

        <!-- EVO ICL 產品系列介紹 — V6 表格 -->
        <div class="model-box mt-16 lg:mt-24">
          <h2
            class="publicTitle mb-6 lg:mb-10 text-center font-bold text-xl lg:text-3xl text-[#4570B6]"
          >
            {content.modelTable.title}
          </h2>
          <div
            class="model-main w-full text-desc text-center font-light text-base lg:text-xl"
          >
            <table class="model-table w-full">
              <thead>
                <tr class="line-bottom">
                  <th class="table-item">{content.modelTable.projectHeader}</th>
                  <th class="project-name">{content.modelTable.modelHeader}</th>
                </tr>
              </thead>
              <tbody>
                <tr class="line-bottom">
                  <th class="table-item">{content.modelTable.rangeLabel}</th>
                  <td set:html={content.modelTable.rangeContent} />
                </tr>
                <tr class="line-bottom">
                  <th class="table-item">{content.modelTable.techLabel}</th>
                  <td class="model-star text-[#F89B03] font-bold">
                    {content.modelTable.techContent}
                  </td>
                </tr>
                <tr class="line-bottom">
                  <th class="table-item">{content.modelTable.materialLabel}</th>
                  <td>{content.modelTable.materialContent}</td>
                </tr>
                <tr class="line-bottom">
                  <th class="table-item">{content.modelTable.audienceLabel}</th>
                  <td>{content.modelTable.audienceContent}</td>
                </tr>
                <tr class="line-bottom">
                  <th class="table-item">{content.modelTable.nightLabel}</th>
                  <td class="model-star text-[#F89B03] font-bold">
                    {content.modelTable.nightContent}
                  </td>
                </tr>
                <tr class="line-bottom">
                  <th class="table-item">
                    {content.modelTable.reversibilityLabel}
                  </th>
                  <td>
                    <div class="flex items-center justify-center gap-1">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="27"
                        height="28"
                        viewBox="0 0 27 28"
                        fill="none"
                      >
                        <path
                          d="M.009 15.08c-.128-4.545 1.115-7.944 3.749-10.787S9.638.01 13.416 0c3.706-.009 6.907 1.369 9.545 4.111 2.632 2.736 3.933 6.05 3.961 9.89.026 3.486-1.12 6.562-3.318 9.18-2.24 2.664-5.074 4.314-8.457 4.718-4.638.554-8.577-1.028-11.751-4.595C1.433 21.099.01 17.83.009 15.08m11.206.075c-.089-.085-.167-.154-.24-.23-.828-.859-1.655-1.723-2.486-2.579-.339-.35-.559-.345-.892 0q-.9.931-1.8 1.869c-.302.316-.302.545 0 .861q2.468 2.582 4.937 5.16c.366.382.574.38.948-.007q.919-.95 1.838-1.904 3.768-3.908 7.534-7.818c.347-.36.347-.589.003-.947L19.35 7.787c-.409-.423-.603-.425-1.006-.007l-6.888 7.14c-.073.076-.151.147-.243.235z"
                          fill="#f89b03"
                        />
                        <path
                          d="M11.215 15.155c.091-.089.17-.16.243-.235l6.888-7.14c.402-.42.597-.418 1.006.007q.854.885 1.706 1.772c.343.359.343.587-.004.947q-3.766 3.91-7.533 7.818-.917.953-1.838 1.905c-.374.387-.583.389-.949.006l-4.936-5.159c-.302-.317-.302-.545 0-.862q.898-.936 1.8-1.868c.333-.346.553-.35.891 0 .832.857 1.658 1.72 2.487 2.58.073.075.152.143.24.229z"
                          fill="#fff"
                        />
                      </svg>
                      <span>{content.modelTable.reversibilityContent}</span>
                    </div>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. LBV/CLEAR-Vision/ICL Viva V6 大不同 -->
    <section class="smilepro-difference">
      <div class="smilepro-difference-title">
        <div set:html={content.comparison.title} />
      </div>
      <table class="table custom-comparison-table">
        <thead>
          <tr>
            <th></th>
            {content.comparison.columns.map((col) => (
              <th class={col.bgClass} set:html={col.title} />
            ))}
          </tr>
        </thead>
        <tbody>
          {content.comparison.rows.map((row) => (
            <tr>
              <td set:html={row.label} />
              {row.isBadgeRow ? (
                <>
                  <td>
                    {row.col1Badge?.text ? (
                      <span class="flex items-center justify-center gap-2">
                        <img
                          draggable="false"
                          src={
                            row.col1Badge.success
                              ? "https://statichk.cmermedical.com/smile/feeV2/success.svg"
                              : "https://statichk.cmermedical.com/smile/feeV2/error.svg"
                          }
                          alt="標記"
                        />
                        {row.col1Badge.text}
                      </span>
                    ) : (
                      <img
                        draggable="false"
                        src={
                          row.col1Badge?.success
                            ? "https://statichk.cmermedical.com/smile/feeV2/success.svg"
                            : "https://statichk.cmermedical.com/smile/feeV2/error.svg"
                        }
                        alt="不包括"
                        class="mx-auto"
                      />
                    )}
                  </td>
                  <td>
                    {row.col2Badge?.text ? (
                      <span class="flex items-center justify-center gap-2">
                        <img
                          draggable="false"
                          src={
                            row.col2Badge.success
                              ? "https://statichk.cmermedical.com/smile/feeV2/success.svg"
                              : "https://statichk.cmermedical.com/smile/feeV2/error.svg"
                          }
                          alt="標記"
                        />
                        {row.col2Badge.text}
                      </span>
                    ) : (
                      <img
                        draggable="false"
                        src={
                          row.col2Badge?.success
                            ? "https://statichk.cmermedical.com/smile/feeV2/success.svg"
                            : "https://statichk.cmermedical.com/smile/feeV2/error.svg"
                        }
                        alt="不包括"
                        class="mx-auto"
                      />
                    )}
                  </td>
                  <td>
                    {row.col3Badge?.text ? (
                      <div class="flex items-center justify-center gap-2">
                        <img
                          draggable="false"
                          src={
                            row.col3Badge.success
                              ? "https://statichk.cmermedical.com/smile/feeV2/success.svg"
                              : "https://statichk.cmermedical.com/smile/feeV2/error.svg"
                          }
                          alt="標記"
                        />
                        {row.col3Badge.text}
                      </div>
                    ) : (
                      <img
                        draggable="false"
                        src={
                          row.col3Badge?.success
                            ? "https://statichk.cmermedical.com/smile/feeV2/success.svg"
                            : "https://statichk.cmermedical.com/smile/feeV2/error.svg"
                        }
                        alt="不包括"
                        class="mx-auto"
                      />
                    )}
                  </td>
                </>
              ) : (
                <>
                  <td set:html={row.col1Html} />
                  <td set:html={row.col2Html} />
                  <td set:html={row.col3Html} />
                </>
              )}
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <!-- 6. 第一視角預覽 -->
    <div class="main_banner">
      <div class="banner lbv-banner">
        <div class="lbv-banner-container">
          <h2 class="text-xl lg:text-3xl font-black lg:font-bold text-[#4570B6]">
            {content.preview.title}
          </h2>
          <h3
            id="lbvSceneTitle"
            class="lbv-banner-title text-[#4570B6] text-xl lg:text-3xl font-black md:mb-10 lg:mb-[68px]"
          >
            {content.preview.slides[0].title}
          </h3>
          <div class="swiper gallery-top lbv-swiper relative">
            <div class="swiper-wrapper" id="lbvSwiperWrapper">
              {content.preview.slides.map((s, idx) => (
                <div
                  class={`swiper-slide lbv-slide ${idx === 0 ? "active" : ""}`}
                  style={{ display: idx === 0 ? "block" : "none" }}
                  data-scene={s.title}
                >
                  <div class="lbv-slide-content">
                    <div class="lbv-slide-image">
                      <img
                        draggable="false"
                        src={s.img}
                        alt={s.alt}
                        class="lbv-background-image"
                      />
                    </div>
                  </div>
                </div>
              ))}
            </div>
            <svg
              id="lbvPrevBtn"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 62 62"
              fill="none"
              class="swiper-button-prev lbv-swiper-button-prev cursor-pointer"
            >
              <path
                d="M62 31C62 48.1792 48.1792 62 31 62C13.8208 62 -7.02527e-06 48.1792 -6.27434e-06 31C-5.52342e-06 13.8208 13.8208 1.70872e-06 31 2.45964e-06C48.1792 3.21057e-06 62 13.8208 62 31ZM34.9783 12.5292L18.3158 29.1917C17.7992 29.7083 17.5408 30.3542 17.67 31C17.67 31.6458 17.9283 32.2917 18.3158 32.8083L34.9783 49.4708C36.0117 50.375 37.5617 50.375 38.4658 49.4708L38.7242 49.2125C39.6283 48.3083 39.6283 46.7583 38.7242 45.8542L23.87 31L38.7242 16.1458C39.6283 15.2417 39.6283 13.6917 38.7242 12.7875L38.4658 12.5292C37.5617 11.625 36.0117 11.625 34.9783 12.5292Z"
                fill="#4570B6"
              />
            </svg>
            <svg
              id="lbvNextBtn"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 62 62"
              fill="none"
              class="swiper-button-next lbv-swiper-button-next cursor-pointer"
            >
              <path
                d="M-1.35505e-06 31C-6.04128e-07 48.1792 13.8208 62 31 62C48.1792 62 62 48.1792 62 31C62 13.8208 48.1792 1.70872e-06 31 2.45964e-06C13.8208 3.21057e-06 -2.10598e-06 13.8208 -1.35505e-06 31ZM27.0217 12.5292L43.6842 29.1917C44.2008 29.7083 44.4592 30.3542 44.33 31C44.33 31.6458 44.0717 32.2917 43.6842 32.8083L27.0217 49.4708C25.9883 50.375 24.4383 50.375 23.5342 49.4708L23.2758 49.2125C22.3717 48.3083 22.3717 46.7583 23.2758 45.8542L38.13 31L23.2758 16.1458C22.3717 15.2417 22.3717 13.6917 23.2758 12.7875L23.5342 12.5292C24.4383 11.625 25.9883 11.625 27.0217 12.5292Z"
                fill="#4570B6"
              />
            </svg>
          </div>
        </div>
      </div>
    </div>

    <!-- 7. 預約講座與諮詢 -->
    <section class="clearAppointment">
      <div class="clearAppointment-Box">
        <a href={appointFormUrl} class="clearAppointment-Box-item">
          <img
            draggable="false"
            src={content.appointment.lectureIcon}
            alt=""
          />
          <p>{content.appointment.lectureText}</p>
          <div class="clearAppointment-Box-item-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="49"
              height="42"
              viewBox="0 0 49 42"
              fill="none"
            >
              <path
                d="M3.57595 20.4719L40.719 20.472"
                stroke="white"
                stroke-width="6.26756"
                stroke-linecap="round"
              />
              <path
                d="M27.7695 37.561L44.268 21.0626L28.3134 5.10799"
                stroke="white"
                stroke-width="5.64081"
                stroke-linecap="round"
              />
            </svg>
          </div>
        </a>
        <a
          target="_blank"
          rel="noopener noreferrer"
          href={content.appointment.consultHref}
          class="clearAppointment-Box-item"
          data-cta="whatsapp-w06"
        >
          <img
            draggable="false"
            src={content.appointment.consultIcon}
            alt=""
          />
          <p>{content.appointment.consultText}</p>
          <div class="clearAppointment-Box-item-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="49"
              height="42"
              viewBox="0 0 49 42"
              fill="none"
            >
              <path
                d="M3.57595 20.4719L40.719 20.472"
                stroke="white"
                stroke-width="6.26756"
                stroke-linecap="round"
              />
              <path
                d="M27.7695 37.561L44.268 21.0626L28.3134 5.10799"
                stroke="white"
                stroke-width="5.64081"
                stroke-linecap="round"
              />
            </svg>
          </div>
        </a>
      </div>
    </section>

    <!-- 8. 合適對象 -->
    <section class="SuitableObject">
      <img
        draggable="false"
        decoding="async"
